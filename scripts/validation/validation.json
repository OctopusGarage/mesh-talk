{
  "schema": 1,
  "contracts": [
    {
      "id": "validation-tooling",
      "paths": [
        "scripts/validation/affected.mjs",
        "scripts/validation/changed.mjs",
        "scripts/validation/frontend-graph.mjs",
        "scripts/validation/validation.json",
        "scripts/validation/stage.mjs",
        "scripts/validation/selectors.mjs",
        "Makefile",
        "AGENTS.md",
        "scripts/diagnostics/affected-plan.test.mjs",
        "scripts/diagnostics/changed-validation.test.mjs",
        "scripts/diagnostics/validation-selectors.test.mjs",
        "scripts/diagnostics/validation-stage.test.mjs",
        "frontend/validation.json",
        "crates/mesh-talk-core/validation.json",
        "src-tauri/validation.json",
        "crates/mesh-talk-integrations/validation.json",
        "crates/mesh-talk-mcp/validation.json"
      ],
      "node": [
        "scripts/diagnostics/affected-plan.test.mjs",
        "scripts/diagnostics/changed-validation.test.mjs",
        "scripts/diagnostics/validation-selectors.test.mjs",
        "scripts/diagnostics/validation-stage.test.mjs"
      ],
      "escalation": [
        "Changes to shared validation/PR infrastructure require its affected workflow diagnostics; this development plan does not replace preflight, health or protected CI."
      ]
    },
    {
      "id": "repository-hygiene",
      "paths": [
        ".gitignore",
        "hooks/pre-commit",
        "scripts/check-repository-hygiene.mjs",
        "scripts/diagnostics/repository-hygiene.test.mjs"
      ],
      "node": ["scripts/diagnostics/repository-hygiene.test.mjs"],
      "escalation": [
        "Changes to health or CI entry points also require the affected workflow diagnostic tests."
      ]
    },
    {
      "id": "pr-preparation",
      "paths": [
        "scripts/prepare-pr.sh",
        "scripts/create-pr.sh",
        "scripts/pr-preflight.sh",
        "scripts/pr-platform/",
        "scripts/validation/pr-scenarios.mjs",
        "scripts/diagnostics/prepare-pr.test.mjs",
        "scripts/diagnostics/pr-scenarios.test.mjs",
        "scripts/validation/native-build.mjs",
        "scripts/diagnostics/native-build.test.mjs"
      ],
      "node": [
        "scripts/diagnostics/prepare-pr.test.mjs",
        "scripts/diagnostics/create-pr.test.mjs",
        "scripts/diagnostics/pr-platform.test.mjs",
        "scripts/diagnostics/pr-scenarios.test.mjs",
        "scripts/diagnostics/pr-preflight-output.test.mjs",
        "scripts/diagnostics/health-workflow.test.mjs",
        "scripts/diagnostics/native-build.test.mjs"
      ],
      "escalation": [
        "Before publication run full preparation; focused diagnostic success alone does not certify native or platform execution."
      ]
    }
  ]
}
