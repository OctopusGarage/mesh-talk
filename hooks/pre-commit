#!/bin/bash
set -e
# Keep commits responsive. Developers run the affected tests while changing code;
# PR preflight and CI run the comprehensive gates.
git diff --cached --check

if git diff --cached --name-only --diff-filter=ACMR | rg -q '^(crates/|src-tauri/).*\.rs$'; then
    cargo fmt --all -- --check
fi

frontend_files=()
while IFS= read -r path; do
    frontend_files+=("${path#frontend/}")
done < <(git diff --cached --name-only --diff-filter=ACMR -- frontend/src/ | rg '\.(ts|tsx|css)$' || true)
if [ "${#frontend_files[@]}" -gt 0 ]; then
    (cd frontend && npx prettier --check "${frontend_files[@]}")
fi

echo "Source checks passed. Run affected tests before opening a PR."

