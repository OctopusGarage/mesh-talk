 \"Friend\",\n      addr: \"new\",\n      post_office: false,\n    };\n    let release!: (value: { unchanged: true }) => void;\n    let rejectGroup!: (error: Error) => void;\n    invoke.mockImplementation((command: string) => {\n      if (command === \"owner_node_identity\") return Promise.resolve(identity);\n      if (command === \"owner_startup_identity\")\n        return Promise.resolve({\n          ...scope,\n          startup_id: scope.runtime_id,\n          phase: \"ready\",\n        });\n      if (command === \"owner_reception_page\") {\n        const cursor = {\n          epoch: \"0123456789abcdef0123456789abcdef\",\n          sequence: \"0\",\n        };\n        return Promise.resolve({\n          scope,\n          token: \"initial\",\n          after: cursor,\n          next: cursor,\n          through: cursor,\n          complete: true,\n          receipts: [],\n        });\n      }\n      if (command === \"owner_reception_ack\") return Promise.resolve(false);\n      if (command === \"get_presence\")\n        return Promise.resolve({\n          people: {},\n          groups: {},\n          groups_revision: \"a\".repeat(64),\n        });\n      if (command === \"owner_roster_observation\")\n        return Promise.resolve({\n          identity,\n          peers: [peer],\n          people: {\n            friend: {\n              online: true,\n              last_seen_secs: 0,\n              online_expires_in_secs: 15,\n            },\n          },\n        });\n      if (command === \"owner_presence_if_groups_changed\")\n        return new Promise((resolve, reject) => {\n          release = resolve;\n          rejectGroup = reject;\n        });\n      return Promise.resolve([]);\n    });\n    const stopChat = useChat.getState().start();\n    await vi.advanceTimersByTimeAsync(0);\n    const stopPresence = usePresence.getState().start();\n    try {\n      await vi.advanceTimersByTimeAsync(0);\n      expect(useChat.getState()).toMatchObject({\n        ready: true,\n        deliveryRuntime: scope.runtime_id,\n      });\n      invoke.mockClear();\n      captured.current?.onRosterChanged({ ...scope, runtime_id: \"retired\" });\n      await vi.advanceTimersByTimeAsync(0);\n      expect(invoke).not.toHaveBeenCalled();\n      page.visibilityState = \"hidden\";\n      page.dispatchEvent(new Event(\"visibilitychange\"));\n      for (let i = 0; i < 10; i++) captured.current?.onRosterChanged(scope);\n      await vi.advanceTimersByTimeAsync(0);\n      expect(invoke).not.toHaveBeenCalled();\n      captured.current?.onReceptionWake(scope);\n      await vi.advanceTimersByTimeAsync(0);\n      expect(invoke.mock.calls.map(([command]) => command)).toEqual([\n        \"owner_reception_page\",\n        \"owner_reception_ack\",\n      ]);\n      invoke.mockClear();\n      page.visibilityState = \"visible\";\n      captured.current?.onRosterChanged(scope);\n      await vi.advanceTimersByTimeAsync(0);\n      expect(useChat.getState().peers).toEqual([peer]);\n      expect(\n        invoke.mock.calls.filter(([cmd]) => cmd === \"owner_roster_observation\"),\n      ).toHaveLength(1);\n      expect(\n        invoke.mock.calls.filter(\n          ([cmd]) => cmd === \"owner_presence_if_groups_changed\",\n        ),\n      ).toHaveLength(1);\n      expect(\n        invoke.mock.calls.filter(\n          ([cmd]) =>\n            cmd === \"get_presence\" ||\n            cmd === \"list_peers\" ||\n            cmd === \"owner_node_identity\" ||\n            cmd === \"owner_reception_page\" ||\n            cmd === \"owner_reception_ack\",\n        ),\n      ).toHaveLength(0);\n      if (mode === \"failed\") rejectGroup(new Error(\"group storage failed\"));\n      else release({ unchanged: true });\n      await vi.advanceTimersByTimeAsync(0);\n      if (mode === \"failed\")\n        expect(usePresence.getState().unavailable).toBe(true);\n      else expect(usePresence.getState().map.friend.online).toBe(true);\n}\n\nexport function notifySyncInvalidation(change: SyncInvalidation) {\n  for (const listener of listeners) listener(change);\n}\n\nlet pushOwner: string | null = null;\nexport function setPushStateSupport(owner: string | null) {\n  pushOwner = owner;\n}\nexport function supportsPushState(owner?: string | null) {\n  return pushOwner !== null && (owner === undefined || pushOwner === owner);\n}\n","exit_code":1,"duration":{"secs":0,"nanos":11458}},"started_at_ms":1795408587537,"completed_at_ms":1795408587537}}
