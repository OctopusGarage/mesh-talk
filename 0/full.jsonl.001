           let observed = store.lock().unwrap();\n217:    let observed = store.lock().unwrap();\n256:fn offline_dm_delivered_via_post_office() {\n264:    // device + account keystores + encrypted log stores; the relay also opens its log) —\n267:    // Each process gets its OWN subdir: a node's account.keystore + messages.log + sent.log\n268:    // (and the relay's log) are all derived from the keystore's PARENT dir, so sharing one\n271:        &dir.path().join(\"relay\").join(\"identity.keystore\"),\n277:    // Alice and Bob (normal nodes). Keep Bob's keystore path to restart him later.\n279:        &dir.path().join(\"alice\").join(\"identity.keystore\"),\n283:    let bob_keystore = dir.path().join(\"bob\").join(\"identity.keystore\");\n1795415426\n","exit_code":0,"duration":{"secs":0,"nanos":10709}},"started_at_ms":1795415426326,"completed_at_ms":1795415426326}}
