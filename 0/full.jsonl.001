{"timestamp":"2026-11-23T04:12:01.841Z","ordinal":33880,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1feaf-24d9-7612-a284-664abd64a2c4","turn_id":"01a2069a-5c22-79c2-86f9-8d4567adaa33","item":{"type":"CommandExecution","id":"exec-592cdcb8-106d-4b5b-b6f6-163e3df45271","process_id":"96398","command":["/bin/zsh","-lc","sed -n '1,155p' crates/mesh-talk-core/src/transport/net.rs\nsed -n '1,235p' crates/mesh-talk-core/src/discovery/visibility.rs\nrg -n 'send_beacon|send_multicast|interface_events' crates/mesh-talk-core/src/discovery/service.rs"],"cwd":"file:///Users/kingsonwu/programming/OctopusGarage/mesh-talk","parsed_cmd":[{"type":"read","cmd":"sed -n '1,155p' crates/mesh-talk-core/src/transport/net.rs","name":"net.rs","path":"crates/mesh-talk-core/src/transport/net.rs"},{"type":"read","cmd":"sed -n '1,235p' crates/mesh-talk-core/src/discovery/visibility.rs","name":"visibility.rs","path":"crates/mesh-talk-core/src/discovery/visibility.rs"},{"type":"search","cmd":"rg -n 'send_beacon|send_multicast|interface_events' crates/mesh-talk-core/src/discovery/service.rs","query":"send_beacon|send_multicast|interface_events","path":"service.rs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"//! Low-level socket helpers shared by the node's discovery (the CLI binary and\n//! the desktop runtime both bind the same kind of reuse UDP socket and join the\n//! discovery multicast group on every local interface).\n\nuse std::net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr};\nuse std::time::Duration;\nuse tokio::net::{TcpListener, TcpStream, UdpSocket};\n\n/// The default UDP port for the node's signed-announce discovery. Distinct\n/// from the legacy plaintext discovery port so the two protocols never collide.\npub const DEFAULT_DISCOVERY_PORT: u16 = 47474;\n\n/// Dedicated routed discovery for managed post offices on every platform.\n/// Relays also participate on DEFAULT_DISCOVERY_PORT for shared LAN discovery.\npub const POST_OFFICE_DISCOVERY_PORT: u16 = 47478;\n\n/// The IPv4 multicast group the node's discovery announces are sent to and\n/// listened on. Mirrors LocalSend's `224.0.0.167`: a link-local (224.0.0.0/24)\n/// group that stays on the LAN and survives where limited broadcast\n/// (`255.255.255.255`) gets dropped or pinned to a single interface (e.g. macOS).\npub const DISCOVERY_MULTICAST_GROUP: Ipv4Addr = Ipv4Addr::new(224, 0, 0, 167);\n\n/// Bind the shared discovery UDP socket: `SO_REUSEADDR` + `SO_REUSEPORT` (so two\n/// nodes on one host can share the port) + `SO_BROADCAST`, bound to\n/// `0.0.0.0:<discovery_port>`, then join [`DISCOVERY_MULTICAST_GROUP`] on every\n/// non-loopback IPv4 interface (plus an unspecified-interface fallback). Windows\n/// also joins loopback for co-resident processes and sends public multicast via\n/// explicitly selected interfaces rather than relying on the default route.\npub fn discovery_socket(discovery_port: u16) -> std::io::Result<UdpSocket> {\n    use socket2::{Domain, Protocol, Socket, Type};\n    let socket = Socket::new(Domain::IPV4, Type::DGRAM, Some(Protocol::UDP))?;\n    socket.set_reuse_address(true)?;\n    #[cfg(unix)]\n    socket.set_reuse_port(true)?;\n    socket.set_broadcast(true)?;\n    let bind_addr: SocketAddr = (Ipv4Addr::UNSPECIFIED, discovery_port).into();\n    socket.bind(&bind_addr.into())?;\n    socket.set_nonblocking(true)?;\n    let sock = UdpSocket::from_std(socket.into())?;\n\n    join_discovery_group_all_ifaces(&sock);\n\n    Ok(sock)\n}\n\n/// Optional IPv6 unicast socket for routed discovery. Kept separate from the\n/// IPv4 multicast socket so LAN behavior and platform multicast binding stay\n/// unchanged. A host without IPv6 can omit it.\npub fn routed_ipv6_socket(discovery_port: u16) -> std::io::Result<UdpSocket> {\n    use socket2::{Domain, Protocol, Socket, Type};\n    let socket = Socket::new(Domain::IPV6, Type::DGRAM, Some(Protocol::UDP))?;\n    socket.set_only_v6(true)?;\n    socket.set_reuse_address(true)?;\n    #[cfg(unix)]\n    socket.set_reuse_port(true)?;\n    let bind_addr: SocketAddr = (Ipv6Addr::UNSPECIFIED, discovery_port).into();\n    socket.bind(&bind_addr.into())?;\n    socket.set_nonblocking(true)?;\n    UdpSocket::from_std(socket.into())\n}\n\n/// Join [`DISCOVERY_MULTICAST_GROUP`] on every current non-loopback IPv4 interface\n/// (plus Windows loopback and an unspecified-interface fallback). A single interface (the default route)\n/// is not enough on a multi-NIC / multi-WiFi host. Individual joins may fail (the\n/// interface won't accept it, or it's already joined); that's fine, so per-join\n/// errors are ignored. Called once at bind time and again periodically so interfaces\n/// that come up after launch (e.g. WiFi associating late) get joined.\npub fn join_discovery_group_all_ifaces(sock: &UdpSocket) {\n    for iface in ipv4_interface_addrs() {\n        let _ = sock.join_multicast_v4(DISCOVERY_MULTICAST_GROUP, iface);\n    }\n    // Winsock can select loopback for local multicast. Co-resident desktop/CLI\n    // processes must receive it even when non-loopback adapters are present.\n    #[cfg(windows)]\n    let _ = sock.join_multicast_v4(DISCOVERY_MULTICAST_GROUP, Ipv4Addr::LOCALHOST);\n    // Fallback: let the OS pick the interface, in case enumeration missed one.\n    let _ = sock.join_multicast_v4(DISCOVERY_MULTICAST_GROUP, Ipv4Addr::UNSPECIFIED);\n}\n\n/// Winsock's default multicast interface can be loopback or a virtual adapter.\n/// Publish on every joined IPv4 interface instead of silently missing the LAN.\n/// The caller must hold the discovery visibility/scope guard throughout this send.\n#[cfg(windows)]\npub(crate) async fn send_discovery_multicast(\n    bytes: &[u8],\n    target: SocketAddr,\n) -> std::io::Result<()> {\n    let mut interfaces = ipv4_interface_addrs();\n    if interfaces.is_empty() {\n        // Preserve the OS-selected route when interface enumeration is unavailable.\n        interfaces.push(Ipv4Addr::UNSPECIFIED);\n    }\n    interfaces.push(Ipv4Addr::LOCALHOST);\n    interfaces.sort_unstable();\n    interfaces.dedup();\n    multicast_on_interfaces(bytes, target, &interfaces).await\n}\n\n#[cfg(any(windows, test))]\nasync fn multicast_on_interfaces(\n    bytes: &[u8],\n    target: SocketAddr,\n    interfaces: &[Ipv4Addr],\n) -> std::io::Result<()> {\n    let mut sent = false;\n    let mut last_error =\n        std::io::Error::new(std::io::ErrorKind::NotConnected, \"no multicast interface\");\n    for source in interfaces {\n        let result = async {\n            let sender = UdpSocket::bind((*source, 0)).await?;\n            socket2::SockRef::from(&sender).set_multicast_if_v4(source)?;\n            sender.set_multicast_ttl_v4(1)?;\n            sender.send_to(bytes, target).await?;\n            Ok::<_, std::io::Error>(())\n        }\n        .await;\n        match result {\n            Ok(()) => sent = true,\n            Err(error) => {\n                log::debug!(\"Discovery multicast on {source} failed: {error}\");\n                last_error = error;\n            }\n        }\n    }\n    if sent { Ok(()) } else { Err(last_error) }\n}\n\n/// The local non-loopback IPv4 interface addresses, used as the per-interface\n/// join points for the discovery multicast group and as the source set for the\n/// unicast /24 scan. Errors enumerating interfaces degrade to an empty list (the\n/// unspecified-interface fallback still applies).\npub fn ipv4_interface_addrs() -> Vec<Ipv4Addr> {\n    if_addrs::get_if_addrs()\n        .unwrap_or_default()\n        .into_iter()\n        .filter(|iface| !iface.is_loopback())\n        .filter_map(|iface| match iface.ip() {\n            std::net::IpAddr::V4(addr) => Some(addr),\n            std::net::IpAddr::V6(_) => None,\n        })\n        .collect()\n}\n\n/// Idle time before TCP keepalive probes start on a peer connection. The node's\n/// connections are short request-response sync rounds, but a single round can stay\n/// open across several recv `await`s; keepalive lets a dead peer (yanked cable, NAT\n/// drop) be detected instead of hanging until the idle timeout, and holds NAT/firewall\n/// state for a connection that legitimately pauses between rounds.\nconst TCP_KEEPALIVE_IDLE: Duration = Duration::from_secs(20);\n\n/// Enable `SO_KEEPALIVE` (with a sane idle interval) on an established TCP stream.\n/// Best-effort: a failure to set the option is not fatal to the connection, so the\n/// error is swallowed. No wire-protocol change — this is purely socket-level.\npub fn set_tcp_keepalive(stream: &TcpStream) {\n    use socket2::{SockRef, TcpKeepalive};\n//! Announcement disclosure control, separate from application admission.\nuse super::scope::{self, LanInterface};\nuse std::future::Future;\nuse std::io;\nuse std::net::SocketAddr;\nuse std::sync::{\n    Arc,\n    atomic::{AtomicBool, Ordering},\n};\nuse tokio::net::UdpSocket;\nuse tokio::sync::RwLock;\n\nconst SEND_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(1);\n\n/// A shared discovery-only control. Suppression does not block TCP, conceal\n/// already advertised identities, or retract queued/transmitted datagrams.\npub struct DiscoveryVisibility {\n    public: RwLock<bool>,\n    physical_lan_only: AtomicBool,\n    inventory: Arc<dyn Fn() -> Vec<LanInterface> + Send + Sync>,\n    changes: tokio::sync::watch::Sender<u64>,\n}\n\nimpl DiscoveryVisibility {\n    /// Public routed probing follows the same visibility gate as LAN announcing.\n    pub async fn is_public(&self) -> bool {\n        *self.public.read().await\n    }\n    pub fn new(public: bool) -> Self {\n        Self::with_inventory(public, scope::inventory)\n    }\n\n    pub(crate) fn with_inventory(\n        public: bool,\n        inventory: impl Fn() -> Vec<LanInterface> + Send + Sync + 'static,\n    ) -> Self {\n        Self {\n            public: RwLock::new(public),\n            physical_lan_only: AtomicBool::new(false),\n            inventory: Arc::new(inventory),\n            changes: tokio::sync::watch::channel(0).0,\n        }\n    }\n\n    pub fn physical_lan_only(&self) -> bool {\n        self.physical_lan_only.load(Ordering::Acquire)\n    }\n\n    pub async fn set_physical_lan_only(&self, enabled: bool) {\n        self.set_physical_lan_only_if(enabled, |commit| commit())\n            .await\n            .unwrap();\n    }\n\n    pub(crate) async fn set_physical_lan_only_if(\n        &self,\n        enabled: bool,\n        authorize: impl FnOnce(&mut dyn FnMut() -> io::Result<()>) -> io::Result<()>,\n    ) -> io::Result<()> {\n        let _send_guard = self.public.write().await;\n        authorize(&mut || {\n            if self.physical_lan_only.swap(enabled, Ordering::AcqRel) != enabled {\n                self.changes\n                    .send_modify(|generation| *generation = generation.wrapping_add(1));\n            }\n            Ok(())\n        })\n    }\n\n    pub(crate) fn initialize_physical_lan_only(&self, enabled: bool) -> io::Result<()> {\n        let _guard = self\n            .public\n            .try_write()\n            .map_err(|_| io::Error::new(io::ErrorKind::WouldBlock, \"discovery already active\"))?;\n        self.physical_lan_only.store(enabled, Ordering::Release);\n        Ok(())\n    }\n\n    /// Own the visibility lease and its I/O together so a stalled UDP socket\n    /// cannot postpone a privacy change indefinitely. The future is only polled\n    /// after admission, and cancellation drops it before releasing the lease.\n    pub(crate) async fn with_routed_send<T>(\n        &self,\n        send: impl Future<Output = io::Result<T>>,\n    ) -> io::Result<Option<T>> {\n        self.with_send(true, send).await\n    }\n\n    async fn with_send<T>(\n        &self,\n        routed: bool,\n        send: impl Future<Output = io::Result<T>>,\n    ) -> io::Result<Option<T>> {\n        tokio::time::timeout(SEND_TIMEOUT, async {\n            let public = self.public.read().await;\n            if !*public || (routed && self.physical_lan_only()) {\n                return Ok(None);\n            }\n            let result = send.await;\n            drop(public);\n            result.map(Some)\n        })\n        .await\n        .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, \"discovery send timed out\"))?\n    }\n\n    pub async fn routed_allowed(&self) -> bool {\n        *self.public.read().await && !self.physical_lan_only()\n    }\n\n    pub(crate) fn physical_ipv4_addrs(&self) -> Vec<std::net::Ipv4Addr> {\n        (self.inventory)()\n            .into_iter()\n            .filter_map(|interface| match interface.address {\n                std::net::IpAddr::V4(ip) => Some(ip),\n                _ => None,\n            })\n            .collect()\n    }\n\n    /// Observed interface scope, not a claim about a peer's physical location.\n    pub(crate) fn discovery_scope(&self) -> Vec<LanInterface> {\n        (self.inventory)()\n    }\n\n    pub(crate) fn accepts_source(&self, source: SocketAddr) -> bool {\n        !self.physical_lan_only() || scope::permits(&(self.inventory)(), source)\n    }\n\n    /// Wait for in-flight announcement sends before changing visibility. Once\n    /// disabling returns, subsequent sends cannot start until enabled again;\n    /// packets already handed to the OS may still arrive afterward.\n    pub async fn set_public(&self, public: bool) {\n        let mut current = self.public.write().await;\n        if *current != public {\n            *current = public;\n            self.changes\n                .send_modify(|generation| *generation = generation.wrapping_add(1));\n        }\n    }\n\n    pub(crate) fn subscribe_changes(&self) -> tokio::sync::watch::Receiver<u64> {\n        self.changes.subscribe()\n    }\n\n    /// Initialize only before discovery tasks start. A live send means the host\n    /// violated startup ordering; fail rather than expose persisted private mode.\n    pub(crate) fn initialize_public(&self, public: bool) -> io::Result<()> {\n        let mut current = self\n            .public\n            .try_write()\n            .map_err(|_| io::Error::new(io::ErrorKind::WouldBlock, \"discovery already active\"))?;\n        *current = public;\n        Ok(())\n    }\n\n    pub(crate) async fn send_announce(\n        &self,\n        socket: &UdpSocket,\n        bytes: &[u8],\n        target: SocketAddr,\n    ) -> io::Result<bool> {\n        self.with_send(false, self.send_announce_inner(socket, bytes, target))\n            .await\n            .map(|sent| sent.unwrap_or(false))\n    }\n\n    async fn send_announce_inner(\n        &self,\n        socket: &UdpSocket,\n        bytes: &[u8],\n        target: SocketAddr,\n    ) -> io::Result<bool> {\n        if self.physical_lan_only() {\n            if target.ip() == std::net::IpAddr::V4(crate::transport::net::DISCOVERY_MULTICAST_GROUP)\n            {\n                // Never let the default route select an overlay for a scoped\n                // announce. Each physical IPv4 source gets its own LAN socket.\n                for interface in (self.inventory)() {\n                    if let std::net::IpAddr::V4(source) = interface.address {\n                        let sender = UdpSocket::bind((source, 0)).await?;\n                        socket2::SockRef::from(&sender).set_multicast_if_v4(&source)?;\n                        sender.set_multicast_ttl_v4(1)?;\n                        sender.send_to(bytes, target).await?;\n                    }\n                }\n                return Ok(true);\n            }\n            if !self.accepts_source(target) {\n                return Ok(false);\n            }\n        }\n        #[cfg(windows)]\n        if target.ip() == std::net::IpAddr::V4(crate::transport::net::DISCOVERY_MULTICAST_GROUP) {\n            crate::transport::net::send_discovery_multicast(bytes, target).await?;\n            return Ok(true);\n        }\n        socket.send_to(bytes, target).await?;\n        Ok(true)\n    }\n}\n\nimpl Default for DiscoveryVisibility {\n    fn default() -> Self {\n        Self::new(true)\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[tokio::test(start_paused = true)]\n    async fn liveness_announce_wait_is_bounded_and_cannot_publish_after_cancellation() {\n        let receiver = UdpSocket::bind(\"127.0.0.1:0\").await.unwrap();\n        let sender = UdpSocket::bind(\"127.0.0.1:0\").await.unwrap();\n        let visibility = DiscoveryVisibility::default();\n        let policy = visibility.public.write().await;\n        let result = tokio::time::timeout(\n            std::time::Duration::from_secs(2),\n            visibility.send_announce(&sender, b\"identity\", receiver.local_addr().unwrap()),\n        )\n        .await;\n        assert!(\n            matches!(result, Ok(Err(ref error)) if error.kind() == io::ErrorKind::TimedOut),\n            \"announcement did not own a bounded send deadline: {result:?}\"\n        );\n        drop(policy);\n        tokio::task::yield_now().await;\n        let mut bytes = [0; 64];\n        assert!(\n            matches!(receiver.try_recv(&mut bytes), Err(error) if error.kind() == io::ErrorKind::WouldBlock)\n        );\n    }\n\n993:    let mut events = super::interface_events::InterfaceEvents::subscribe().ok();\n","exit_code":0,"duration":{"secs":0,"nanos":39417}},"started_at_ms":1795407121840,"completed_at_ms":1795407121841}}
{"timestamp":"2026-11-23T04:12:01.968Z","ordinal":33881,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a2069a-8e30-71e3-a0af-ac9df2ecbe28","call_id":"call_7458d5c699d947b79084e1da83274442","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"//! Low-level socket helpers shared by the node's discovery (the CLI binary and\n//! the desktop runtime both bind the same kind of reuse UDP socket and join the\n//! discovery multicast group on every local interface).\n\nuse std::net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr};\nuse std::time::Duration;\nuse tokio::net::{TcpListener, TcpStream, UdpSocket};\n\n/// The default UDP port for the node's signed-announce discovery. Distinct\n/// from the legacy plaintext discovery port so the two protocols never collide.\npub const DEFAULT_DISCOVERY_PORT: u16 = 47474;\n\n/// Dedicated routed discovery for managed post offices on every platform.\n/// Relays also participate on DEFAULT_DISCOVERY_PORT for shared LAN discovery.\npub const POST_OFFICE_DISCOVERY_PORT: u16 = 47478;\n\n/// The IPv4 multicast group the node's discovery announces are sent to and\n/// listened on. Mirrors LocalSend's `224.0.0.167`: a link-local (224.0.0.0/24)\n/// group that stays on the LAN and survives where limited broadcast\n/// (`255.255.255.255`) gets dropped or pinned to a single interface (e.g. macOS).\npub const DISCOVERY_MULTICAST_GROUP: Ipv4Addr = Ipv4Addr::new(224, 0, 0, 167);\n\n/// Bind the shared discovery UDP socket: `SO_REUSEADDR` + `SO_REUSEPORT` (so two\n/// nodes on one host can share the port) + `SO_BROADCAST`, bound to\n/// `0.0.0.0:<discovery_port>`, then join [`DISCOVERY_MULTICAST_GROUP`] on every\n/// non-loopback IPv4 interface (plus an unspecified-interface fallback). Windows\n/// also joins loopback for co-resident processes and sends public multicast via\n/// explicitly selected interfaces rather than relying on the default route.\npub fn discovery_socket(discovery_port: u16) -> std::io::Result<UdpSocket> {\n    use socket2::{Domain, Protocol, Socket, Type};\n    let socket = Socket::new(Domain::IPV4, Type::DGRAM, Some(Protocol::UDP))?;\n    socket.set_reuse_address(true)?;\n    #[cfg(unix)]\n    socket.set_reuse_port(true)?;\n    socket.set_broadcast(true)?;\n    let bind_addr: SocketAddr = (Ipv4Addr::UNSPECIFIED, discovery_port).into();\n    socket.bind(&bind_addr.into())?;\n    socket.set_nonblocking(true)?;\n    let sock = UdpSocket::from_std(socket.into())?;\n\n    join_discovery_group_all_ifaces(&sock);\n\n    Ok(sock)\n}\n\n/// Optional IPv6 unicast socket for routed discovery. Kept separate from the\n/// IPv4 multicast socket so LAN behavior and platform multicast binding stay\n/// unchanged. A host without IPv6 can omit it.\npub fn routed_ipv6_socket(discovery_port: u16) -> std::io::Result<UdpSocket> {\n    use socket2::{Domain, Protocol, Socket, Type};\n    let socket = Socket::new(Domain::IPV6, Type::DGRAM, Some(Protocol::UDP))?;\n    socket.set_only_v6(true)?;\n    socket.set_reuse_address(true)?;\n    #[cfg(unix)]\n    socket.set_reuse_port(true)?;\n    let bind_addr: SocketAddr = (Ipv6Addr::UNSPECIFIED, discovery_port).into();\n    socket.bind(&bind_addr.into())?;\n    socket.set_nonblocking(true)?;\n    UdpSocket::from_std(socket.into())\n}\n\n/// Join [`DISCOVERY_MULTICAST_GROUP`] on every current non-loopback IPv4 interface\n/// (plus Windows loopback and an unspecified-interface fallback). A single interface (the default route)\n/// is not enough on a multi-NIC / multi-WiFi host. Individual joins may fail (the\n/// interface won't accept it, or it's already joined); that's fine, so per-join\n/// errors are ignored. Called once at bind time and again periodically so interfaces\n/// that come up after launch (e.g. WiFi associating late) get joined.\npub fn join_discovery_group_all_ifaces(sock: &UdpSocket) {\n    for iface in ipv4_interface_addrs() {\n        let _ = sock.join_multicast_v4(DISCOVERY_MULTICAST_GROUP, iface);\n    }\n    // Winsock can select loopback for local multicast. Co-resident desktop/CLI\n    // processes must receive it even when non-loopback adapters are present.\n    #[cfg(windows)]\n    let _ = sock.join_multicast_v4(DISCOVERY_MULTICAST_GROUP, Ipv4Addr::LOCALHOST);\n    // Fallback: let the OS pick the interface, in case enumeration missed one.\n    let _ = sock.join_multicast_v4(DISCOVERY_MULTICAST_GROUP, Ipv4Addr::UNSPECIFIED);\n}\n\n/// Winsock's default multicast interface can be loopback or a virtual adapter.\n/// Publish on every joined IPv4 interface instead of silently missing the LAN.\n/// The caller must hold the discovery visibility/scope guard throughout this send.\n#[cfg(windows)]\npub(crate) async fn send_discovery_multicast(\n    bytes: &[u8],\n    target: SocketAddr,\n) -> std::io::Result<()> {\n    let mut interfaces = ipv4_interface_addrs();\n    if interfaces.is_empty() {\n        // Preserve the OS-selected route when interface enumeration is unavailable.\n        interfaces.push(Ipv4Addr::UNSPECIFIED);\n    }\n    interfaces.push(Ipv4Addr::LOCALHOST);\n    interfaces.sort_unstable();\n    interfaces.dedup();\n    multicast_on_interfaces(bytes, target, &interfaces).await\n}\n\n#[cfg(any(windows, test))]\nasync fn multicast_on_interfaces(\n    bytes: &[u8],\n    target: SocketAddr,\n    interfaces: &[Ipv4Addr],\n) -> std::io::Result<()> {\n    let mut sent = false;\n    let mut last_error =\n        std::io::Error::new(std::io::ErrorKind::NotConnected, \"no multicast interface\");\n    for source in interfaces {\n        let result = async {\n            let sender = UdpSocket::bind((*source, 0)).await?;\n            socket2::SockRef::from(&sender).set_multicast_if_v4(source)?;\n            sender.set_multicast_ttl_v4(1)?;\n            sender.send_to(bytes, target).await?;\n            Ok::<_, std::io::Error>(())\n        }\n        .await;\n        match result {\n            Ok(()) => sent = true,\n            Err(error) => {\n                log::debug!(\"Discovery multicast on {source} failed: {error}\");\n                last_error = error;\n            }\n        }\n    }\n    if sent { Ok(()) } else { Err(last_error) }\n}\n\n/// The local non-loopback IPv4 interface addresses, used as the per-interface\n/// join points for the discovery multicast group and as the source set for the\n/// unicast /24 scan. Errors enumerating interfaces degrade to an empty list (the\n/// unspecified-interface fallback still applies).\npub fn ipv4_interface_addrs() -> Vec<Ipv4Addr> {\n    if_addrs::get_if_addrs()\n        .unwrap_or_default()\n        .into_iter()\n        .filter(|iface| !iface.is_loopback())\n        .filter_map(|iface| match iface.ip() {\n            std::net::IpAddr::V4(addr) => Some(addr),\n            std::net::IpAddr::V6(_) => None,\n        })\n        .collect()\n}\n\n/// Idle time before TCP keepalive probes start on a peer connection. The node's\n/// connections are short request-response sync rounds, but a single round can stay\n/// open across several recv `await`s; keepalive lets a dead peer (yanked cable, NAT\n/// drop) be detected instead of hanging until the idle timeout, and holds NAT/firewall\n/// state for a connection that legitimately pauses between rounds.\nconst TCP_KEEPALIVE_IDLE: Duration = Duration::from_secs(20);\n\n/// Enable `SO_KEEPALIVE` (with a sane idle interval) on an established TCP stream.\n/// Best-effort: a failure to set the option is not fatal to the connection, so the\n/// error is swallowed. No wire-protocol change — this is purely socket-level.\npub fn set_tcp_keepalive(stream: &TcpStream) {\n    use socket2::{SockRef, TcpKeepalive};\n//! Announcement disclosure control, separate from application admission.\nuse super::scope::{self, LanInterface};\nuse std::future::Future;\nuse std::io;\nuse std::net::SocketAddr;\nuse std::sync::{\n    Arc,\n    atomic::{AtomicBool, Ordering},\n};\nuse tokio::net::UdpSocket;\nuse tokio::sync::RwLock;\n\nconst SEND_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(1);\n\n/// A shared discovery-only control. Suppression does not block TCP, conceal\n/// already advertised identities, or retract queued/transmitted datagrams.\npub struct DiscoveryVisibility {\n    public: RwLock<bool>,\n    physical_lan_only: AtomicBool,\n    inventory: Arc<dyn Fn() -> Vec<LanInterface> + Send + Sync>,\n    changes: tokio::sync::watch::Sender<u64>,\n}\n\nimpl DiscoveryVisibility {\n    /// Public routed probing follows the same visibility gate as LAN announcing.\n    pub async fn is_public(&self) -> bool {\n        *self.public.read().await\n    }\n    pub fn new(public: bool) -> Self {\n        Self::with_inventory(public, scope::inventory)\n    }\n\n    pub(crate) fn with_inventory(\n        public: bool,\n        inventory: impl Fn() -> Vec<LanInterface> + Send + Sync + 'static,\n    ) -> Self {\n        Self {\n            public: RwLock::new(public),\n            physical_lan_only: AtomicBool::new(false),\n            inventory: Arc::new(inventory),\n            changes: tokio::sync::watch::channel(0).0,\n        }\n    }\n\n    pub fn physical_lan_only(&self) -> bool {\n        self.physical_lan_only.load(Ordering::Acquire)\n    }\n\n    pub async fn set_physical_lan_only(&self, enabled: bool) {\n        self.set_physical_lan_only_if(enabled, |commit| commit())\n            .await\n            .unwrap();\n    }\n\n    pub(crate) async fn set_physical_lan_only_if(\n        &self,\n        enabled: bool,\n        authorize: impl FnOnce(&mut dyn FnMut() -> io::Result<()>) -> io::Result<()>,\n    ) -> io::Result<()> {\n        let _send_guard = self.public.write().await;\n        authorize(&mut || {\n            if self.physical_lan_only.swap(enabled, Ordering::AcqRel) != enabled {\n                self.changes\n                    .send_modify(|generation| *generation = generation.wrapping_add(1));\n            }\n            Ok(())\n        })\n    }\n\n    pub(crate) fn initialize_physical_lan_only(&self, enabled: bool) -> io::Result<()> {\n        let _guard = self\n            .public\n            .try_write()\n            .map_err(|_| io::Error::new(io::ErrorKind::WouldBlock, \"discovery already active\"))?;\n        self.physical_lan_only.store(enabled, Ordering::Release);\n        Ok(())\n    }\n\n    /// Own the visibility lease and its I/O together so a stalled UDP socket\n    /// cannot postpone a privacy change indefinitely. The future is only polled\n    /// after admission, and cancellation drops it before releasing the lease.\n    pub(crate) async fn with_routed_send<T>(\n        &self,\n        send: impl Future<Output = io::Result<T>>,\n    ) -> io::Result<Option<T>> {\n        self.with_send(true, send).await\n    }\n\n    async fn with_send<T>(\n        &self,\n        routed: bool,\n        send: impl Future<Output = io::Result<T>>,\n    ) -> io::Result<Option<T>> {\n        tokio::time::timeout(SEND_TIMEOUT, async {\n            let public = self.public.read().await;\n            if !*public || (routed && self.physical_lan_only()) {\n                return Ok(None);\n            }\n            let result = send.await;\n            drop(public);\n            result.map(Some)\n        })\n        .await\n        .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, \"discovery send timed out\"))?\n    }\n\n    pub async fn routed_allowed(&self) -> bool {\n        *self.public.read().await && !self.physical_lan_only()\n    }\n\n    pub(crate) fn physical_ipv4_addrs(&self) -> Vec<std::net::Ipv4Addr> {\n        (self.inventory)()\n            .into_iter()\n            .filter_map(|interface| match interface.address {\n                std::net::IpAddr::V4(ip) => Some(ip),\n                _ => None,\n            })\n            .collect()\n    }\n\n    /// Observed interface scope, not a claim about a peer's physical location.\n    pub(crate) fn discovery_scope(&self) -> Vec<LanInterface> {\n        (self.inventory)()\n    }\n\n    pub(crate) fn accepts_source(&self, source: SocketAddr) -> bool {\n        !self.physical_lan_only() || scope::permits(&(self.inventory)(), source)\n    }\n\n    /// Wait for in-flight announcement sends before changing visibility. Once\n    /// disabling returns, subsequent sends cannot start until enabled again;\n    /// packets already handed to the OS may still arrive afterward.\n    pub async fn set_public(&self, public: bool) {\n        let mut current = self.public.write().await;\n        if *current != public {\n            *current = public;\n            self.changes\n                .send_modify(|generation| *generation = generation.wrapping_add(1));\n        }\n    }\n\n    pub(crate) fn subscribe_changes(&self) -> tokio::sync::watch::Receiver<u64> {\n        self.changes.subscribe()\n    }\n\n    /// Initialize only before discovery tasks start. A live send means the host\n    /// violated startup ordering; fail rather than expose persisted private mode.\n    pub(crate) fn initialize_public(&self, public: bool) -> io::Result<()> {\n        let mut current = self\n            .public\n            .try_write()\n            .map_err(|_| io::Error::new(io::ErrorKind::WouldBlock, \"discovery already active\"))?;\n        *current = public;\n        Ok(())\n    }\n\n    pub(crate) async fn send_announce(\n        &self,\n        socket: &UdpSocket,\n        bytes: &[u8],\n        target: SocketAddr,\n    ) -> io::Result<bool> {\n        self.with_send(false, self.send_announce_inner(socket, bytes, target))\n            .await\n            .map(|sent| sent.unwrap_or(false))\n    }\n\n    async fn send_announce_inner(\n        &self,\n        socket: &UdpSocket,\n        bytes: &[u8],\n        target: SocketAddr,\n    ) -> io::Result<bool> {\n        if self.physical_lan_only() {\n            if target.ip() == std::net::IpAddr::V4(crate::transport::net::DISCOVERY_MULTICAST_GROUP)\n            {\n                // Never let the default route select an overlay for a scoped\n                // announce. Each physical IPv4 source gets its own LAN socket.\n                for interface in (self.inventory)() {\n                    if let std::net::IpAddr::V4(source) = interface.address {\n                        let sender = UdpSocket::bind((source, 0)).await?;\n                        socket2::SockRef::from(&sender).set_multicast_if_v4(&source)?;\n                        sender.set_multicast_ttl_v4(1)?;\n                        sender.send_to(bytes, target).await?;\n                    }\n                }\n                return Ok(true);\n            }\n            if !self.accepts_source(target) {\n                return Ok(false);\n            }\n        }\n        #[cfg(windows)]\n        if target.ip() == std::net::IpAddr::V4(crate::transport::net::DISCOVERY_MULTICAST_GROUP) {\n            crate::transport::net::send_discovery_multicast(bytes, target).await?;\n            return Ok(true);\n        }\n        socket.send_to(bytes, target).await?;\n        Ok(true)\n    }\n}\n\nimpl Default for DiscoveryVisibility {\n    fn default() -> Self {\n        Self::new(true)\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[tokio::test(start_paused = true)]\n    async fn liveness_announce_wait_is_bounded_and_cannot_publish_after_cancellation() {\n        let receiver = UdpSocket::bind(\"127.0.0.1:0\").await.unwrap();\n        let sender = UdpSocket::bind(\"127.0.0.1:0\").await.unwrap();\n        let visibility = DiscoveryVisibility::default();\n        let policy = visibility.public.write().await;\n        let result = tokio::time::timeout(\n            std::time::Duration::from_secs(2),\n            visibility.send_announce(&sender, b\"identity\", receiver.local_addr().unwrap()),\n        )\n        .await;\n        assert!(\n            matches!(result, Ok(Err(ref error)) if error.kind() == io::ErrorKind::TimedOut),\n            \"announcement did not own a bounded send deadline: {result:?}\"\n        );\n        drop(policy);\n        tokio::task::yield_now().await;\n        let mut bytes = [0; 64];\n        assert!(\n            matches!(receiver.try_recv(&mut bytes), Err(error) if error.kind() == io::ErrorKind::WouldBlock)\n        );\n    }\n\n993:    let mut events = super::interface_events::InterfaceEvents::subscribe().ok();\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a2069a-5c22-79c2-86f9-8d4567adaa33","create_time":1795407121.96877}},"metadata":{"history_sequence":14398,"sampled_through_sequence":14396,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
