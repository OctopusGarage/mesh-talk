 sock.bind((\"127.0.0.1\", 0))\n    print(sock.getsockname()[1])\nPY\n)\nsha256sum \"$binary\" >\"$output/binary-sha256\"\n\"$binary\" \"$root\" \"$port\" \"$seconds\" \"$@\" >\"$output/stdout.log\" 2>\"$output/fixture.log\" &\nchild=$!\ntrap 'if kill -0 \"$child\" 2>/dev/null; then kill -TERM \"$child\"; fi' EXIT\ndeadline=$((SECONDS + 180 + 2 * seconds))\nwhile kill -0 \"$child\" 2>/dev/null; do\n    if (( SECONDS >= deadline )); then\n        echo 'Native fixture timed out' >&2\n        exit 1\n    fi\n    case $(ps -o stat= -p \"$child\") in\n        Z*) break ;;\n    esac\n    if ! python3 /evidence/sample-family.py \"$child\" >>\"$output/process-samples.jsonl\"; then\n        kill -0 \"$child\" 2>/dev/null || break\n        exit 1\n    fi\n    sleep 3\ndone\nwait \"$child\"\nFilesystem      Size    Used   Avail Capacity iused ifree %iused  Mounted on\n/dev/disk3s5   926Gi   592Gi   283Gi    68%    6.4M  3.0G    0%   /System/Volumes/Data\n","exit_code":0,"duration":{"secs":0,"nanos":10708}},"started_at_ms":1795407043431,"completed_at_ms":1795407043432}}
