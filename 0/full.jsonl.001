ive -File \"$r/measure-discovery-setup.ps1\" >\"$d/discovery-setup-diagnostic.jsonl\"\ncat \"$d/discovery-setup-diagnostic.jsonl\"`,yield_time_ms:1000}))\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a2069a-5c22-79c2-86f9-8d4567adaa33","create_time":1795407195.8862383}},"metadata":{"history_sequence":14429,"sampled_through_sequence":14427,"client_authored":false,"model_search_state":"unused"}}
