te-probes/provenance.json\" -Raw | ConvertFrom-Json\nif ($report.identifier -ne 'com.mesh-talk.req011.desktop-probe') { throw 'Probe must have an isolated application identity' }\n$expected = ($report.binaries | Where-Object Path -Like '*req011-driverless-loaded.exe').Hash\nif ((Get-FileHash $binary -Algorithm SHA256).Hash -ne $expected) { throw 'Probe binary digest mismatch' }\n$fixture = Get-Content \"$work/reference/metadata.json\" -Raw | ConvertFrom-Json\nif ($fixture.messages -ne 100000 -or $fixture.contacts -ne 100 -or $fixture.groups -ne 20) { throw 'Reference scale not verified' }\n$loaded = \"$work/idle-reception-window-state\"\n$profile = \"$work/idle-reception-window-state-profile\"\nCopy-Item \"$work/reference/desktop\" $profile -Recurse\nRemove-Item Env:REQ011_STARTUP_ONLY, Env:MESH_TALK_TRACE_WORK -ErrorAction SilentlyContinue\n& \"$work/sample-reference-desktop.ps1\" -Binary $binary -Profile $profile -Evidence $loaded -PhaseSeconds 510 -Metadata \"$work/reference/metadata.json\" -PasswordFile \"$work/reference/password\"\n$empty = \"$work/idle-reception-window-empty\"\n& \"$work/sample-reference-desktop.ps1\" -Binary $binary -Profile \"$work/idle-reception-window-empty-profile\" -Evidence $empty -PhaseSeconds 510\n@{ loaded = $loaded; empty = $empty; messages = $fixture.messages; sessionId = (Get-Process -Id $PID).SessionId } |\n    ConvertTo-Json -Compress | Set-Content -Encoding UTF8 \"$work/reception-window-state-results.json\"\n} catch {\n    $_ | Out-String | Set-Content -Encoding UTF8 \"$work/reception-window-state-error.log\"\n    throw\n}\n-rw-r--r--@ 1 kingsonwu  staff    79M Nov 23 10:46 /Users/kingsonwu/programming/OctopusGarage/mesh-talk/tmp/req-011/windows-reception-batched.hIVWN4ON/source-clean.tar\n-rw-r--r--@ 1 kingsonwu  staff    11K Nov 23 11:12 /Users/kingsonwu/programming/OctopusGarage/mesh-talk/tmp/req-011/windows-reception-batched.hIVWN4ON/unified-desktop-window-state.rs\n"}],"internal_chat_message_metadata_passthrough":{"turn_id