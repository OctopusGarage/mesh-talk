      command: \"/owner_reception_page_result\",\n                complete: page?.complete ?? null,\n                cursorAdvanced: page?.after?.sequence !== page?.next?.sequence,\n                domains: Array.isArray(page?.receipts)\n                  ? page.receipts.filter(({kind}) => kind === \"state\").map(({event}) => event?.kinds)\n                  : [],\n              });\n            }, () => {});\n          }\n        }\n      }\n      return response;''')\n# Durability witness outcomes stay visible even if a burst reaches the command cap.\ns=s.replace('window.__idleIpcTrace.length < 384','window.__idleIpcTrace.length < 4096')\n(out/\"trace.mjs\").write_text(s)\nPY\ncp \"$prior_trace/correlate.py\" \"$out/\"\nnode --check \"$out/trace.mjs\"\ngit diff --check`}))\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a20755-af9e-7e81-b0cf-afd8d0873eec","create_time":1795419402.1796923}},"metadata":{"history_sequence":17107,"sampled_through_sequence":17105,"client_authored":false,"model_search_state":"unused"}}
