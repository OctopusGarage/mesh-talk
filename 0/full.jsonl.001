jection_revision(&self) -> Result<[u8; 32], LogError> {\\n        use std::sync::atomic::Ordering;\\n        let source = {\\n            let log = self.log.lock().expect(\\\"log mutex\\\");\\n            let repository = log.repository()?;\\n            (\\n                repository.source_revision()?,\\n                repository.destructive_policy_revision()?,\\n            )\\n        };\\n        let profiles = self.profiles.lock().expect(\\\"profiles mutex\\\").revision()?;\\n        let avatars = self.account_profiles.revision()?;\\n        let proofs = self\\n            .privacy\\n            .state\\n    async fn settled_account_channel_maintenance_is_quiet_and_changed_source_retries() {\\n        fn queued(node: &Node, channel: ConversationId) -> bool {\\n            node.storage\\n                .database()\\n                .read(|c| {\\n                    Ok(c.query_row(\\n                        \\\"SELECT EXISTS(SELECT 1 FROM channel_runtime_work WHERE channel=?1)\\\",\\n                        [channel.as_bytes().as_slice()],\\n                        |r| r.get(0),\\n                    )?)\\n                })\\n                .unwrap()\\n        }\\n        fn drain(node: &Node, channel: ConversationId) {\\n            for _ in 0..64 {\\n                node.process_channel_reception_inner(channel, \\\"live\\\")\\n                    .unwrap();\\n                if !queued(node, channel) {\\n                    break;\\n                }\\n            }\\n            assert!(\\n                !queued(node, channel),\\n                \\\"fixture must retire its actual reception lane\\\"\\n            );\\n        }\\n        fn assert_quiet(\\n            node: &Node,\\n            channel: ConversationId,\\n            work: &mut ChannelAccountMaintenance,\\n        ) {\\n            assert!(\\n                !queued(node, channel),\\n                \\\"measure fully drained demand, not queue deduplication\\\"\\n            );\\n          