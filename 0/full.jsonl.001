            format!(\n                \"{{const fixture = {};\\n{}\\n}}\",\n                fixture,\n                include_str!(\"driverless-loaded-bootstrap.js\"),\n            )\n        }\n        (None, None) => {\n            assert!(!root.exists(), \"require a fresh empty fixture root\");\n            std::fs::create_dir_all(&root).unwrap();\n            include_str!(\"driverless-bootstrap.js\").to_owned()\n        }\n        _ => panic!(\"supply both fixture metadata and password file\"),\n    });\n    mesh_talk::run_tauri_configured(Some(root), Some(port), |builder| {\n        builder.plugin(\n            tauri::plugin::Builder::<tauri::Wry, ()>::new(\"idle-fixture\")\n                .setup(move |app, _| {\n                    let failure_app = app.clone();\n                    app.once(\"native-idle:failed\", move |event| {\n                        eprintln!(\"fixture bootstrap failed: {}\", event.payload());\n                        failure_app.exit(1);\n                    });\n                    let ready_app = app.clone();\n                    app.once(\"native-idle:ready\", move |event| {\n                        eprintln!(\n                            \"MEASURE process-usable {:.6}\",\n                            SystemTime::now()\n                                .duration_since(UNIX_EPOCH)\n                                .unwrap()\n                                .as_secs_f64()\n                        );\n                        if loaded {\n                            eprintln!(\"MEASURE bootstrap {}\", event.payload());\n                        }\n                        if std::env::var(\"REQ011_STARTUP_ONLY\").as_deref() == Ok(\"1\") {\n                            ready_app.exit(0);\n                            return;\n                        }\n                        std::thread::spawn(move || {\n                            let result =\n                                std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n                                    phase(&ready_app, \"foreground\", false, interval);\n                                    phase(&ready_app, \"minimized\", true, interval);\n                                }));\n                            ready_app.exit(if result.is_ok() { 0 } else { 1 });\n                        });\n58:        \"binarySha256\": observations[\"binarySha256\"],\n59:        \"loaded\": observations[\"loaded\"],\n64:def compare_memory(empty, loaded):\n65:    digest = empty[\"binarySha256\"]\n68:        or digest != loaded[\"binarySha256\"]\n69:        or empty[\"loaded\"] is not False\n70:        or loaded[\"loaded\"] is not True\n72:        raise ValueError(\"memory comparison requires the same binary and both fixtures\")\n76:        loaded_peak = loaded[\"phases\"][phase][\"peakPrivateBytes\"]\n77:        retained_delta = loaded_peak - empty_peak\n80:            \"loadedPeakPrivateBytes\": loaded_peak,\n84:    return {\"binarySha256\": digest, \"phases\": phases}\n.\n..\nbuild-window-state.ps1\nbuild.log\ndiff-sha256\nfocus-retry\nforeground-isolated-path\nforeground-isolated.Kl6j740V\nforeground-repeat-path\nforeground-repeat.8o7kSHqM\nforeground-trace-path\nforeground-trace.iLnASVco\nminimized-isolated-path\nminimized-isolated.1yzNqQXk\nreception-cursors-path\nreception-cursors.x9Q20WtS\nreception-errors-path\nreception-errors.ROLMSl6e\nreception-isolated-path\nreception-isolated-retry.JL0kscJP\nreception-isolated.KMYQJ3ot\nremote-path\nsource-archive-sha\nsource-clean.tar\nsource-sha\ntransition\ntransition-confirm\ntransition-hwnd\ntransition-retry\nunified-desktop-window-state.rs\n","exit_code":0,"duration":{"secs":0,"nanos":10750}},"started_at_ms":1795415558717,"completed_at_ms":1795415558718}}
