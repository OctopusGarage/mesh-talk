{"timestamp":"2026-11-23T04:41:27.098Z","ordinal":35224,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a206b5-7d39-74f0-a482-b300ab63c0ad","call_id":"call_7cceadf6457546408e220961a2be1c23","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"421:    pub fn get(&self) -> AppSettings {\n461:    pub(crate) fn get_for_owner(&self, owner: &str) -> Result<AppSettings, CommandError> {\n        assert!(!allowed_while_locked(\"read_media\"));\n        assert!(!allowed_while_locked(\"read_media_preview\"));\n        assert!(!allowed_while_locked(\"owner_enqueue_text\"));\n    }\n\n    #[test]\n    fn native_idle_policy_suspends_during_calls_and_locks_when_hidden() {\n        let strict = crate::settings::AppSettings::default()\n            .with_privacy_level(crate::settings::PrivacyLevel::Strict);\n        let mut inner = LockInner::default();\n        assert!(!due(&inner, &strict, false));\n        assert!(due(&inner, &strict, true));\n        inner.call_active = true;\n        inner.last_activity = Instant::now() - Duration::from_secs(120);\n        assert!(!due(&inner, &strict, true));\n        inner.call_active = false;\n        assert!(due(&inner, &strict, false));\n    }\n\n    #[test]\n    #[serde(default = \"default_ringtone\")]\n    pub ringtone: String,\n    #[serde(default)]\n    pub privacy_level: PrivacyLevel,\n    #[serde(default = \"default_true\")]\n    pub notification_preview: bool,\n    #[serde(default)]\n    pub auto_lock_seconds: u32,\n    #[serde(default)]\n    pub lock_when_hidden: bool,\n    #[serde(default)]\n    pub confirm_sensitive_copy: bool,\n    #[serde(default)]\n    pub clipboard_clear_seconds: u32,\n    /// Capture bindings remain local to this account on this device.\n    #[serde(default)]\n    pub screenshot_shortcuts: ScreenshotShortcuts,\n}\n\n/// The default ringtone id (the classic phone ring).\nfn default_ringtone() -> String {\n    \"classic\".to_string()\n}\n\n/// Default for both toggles (a messenger should run in the background and notify).\nfn default_true() -> bool {\n    true\n\nasync fn suspend_retired_for<R, F, G>(app: &tauri::AppHandle<R>, make_registry: F)\nwhere\n    R: Runtime,\n    F: FnOnce() -> G + Send + 'static,\n    G: Registry<Key = Shortcut> + Send + 'static,\n{\n    let state = app.state::<ScreenshotShortcutState>();\n    let snapshot = state.inner.lock().unwrap().clone();\n    if snapshot\n        .lease\n        .as_ref()\n        .is_some_and(|lease| !current(&app.state::<AppState>(), lease))\n        && let Err(error) = state\n            .suspend_with_registry(make_registry, snapshot.registration_id)\n            .await\n    {\n        log::warn!(\"Could not suspend screenshot shortcuts: {error}\");\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[cfg(target_os = \"linux\")]\n    #[test]\n    #[ignore = \"requires a dedicated X11 display\"]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a206b5-457a-7921-815a-5c7bb9e9cd8a","create_time":1795408887.097949}},"metadata":{"history_sequence":14954,"sampled_through_sequence":14951,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
