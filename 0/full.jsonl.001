 fresh boot.\n      resetOutgoingMediaPreviews();\n      resetChatFileAvailability();\n      rawSet((state) => ({\n        ...invalidateConversationIdentity(state),\n        identityEpoch: state.identityEpoch + 1,\n        // The replacement identity is already resolved. Bind new arrivals to it\n        // while retryBoot hydrates its persisted state, after dropping old work.\n        myId: identity.device_id,\n        myAccountId: identity.account_id,\n      }));\n      get().retryBoot();\n      return;\n    }\n    // Identity metadata has its own publication point: a newer identity can\n    // finish before its roster reads. Replacement checks above remain mandatory.\n    if (observation >= publishedIdentityObservation) {\n      publishedIdentityObservation = observation;\n      if (\n        identity.display_name &&\n        useAuth.getState().user?.id === lease.owner &&\n        useAuth.getState().user?.display_name !== identity.display_name\n      )\n        useAuth.setState((state) => ({\n          user: state.user\n            ? { ...state.user, display_name: identity.display_name! }\n            : null,\n        }));\n    }\n    if (!publishedAccountRoster?.current()) publishedAccountRoster = null;\n    // Keep full reads concurrent. Heartbeats first inspect cheap discovery facts;\n    // route-only changes still publish peers without rereading account history/policy.\n    if (presenceOnly && ticket && !observed) return;\n    const observedPeers = presenceOnly\n      ? (observed?.peers ?? (await readWithDeadline(() => chat.listPeers())))\n      : null;\n    if (!lease.current() || get().rosterRequest !== request || hasPending())\n      return;\n    const reuseAccounts =\n      presenceOnly &&\n      publishedAccountRoster?.current() &&\n      publishedAccountRoster.projection ===\n        accountRosterProjection(observedPeers!);\n    const [peersSnapshot, listedAccounts, personal] = await Promise.all([\n      observedPeers === null\n        ? readWithDeadline(() => chat.listPeers())\n        : Promise.resolve(observedPeers),\n      reuseAccounts\n        ? Promise.resolve(null)\n        : readWithDeadline(() => chat.listAccounts()),\n      presenceOnly\n        ? Promise.resolve(null)\n        : readWithDeadline(() =>\n            chat.personalConversationStates(lease.owner!, identity.account_id),\n          ).catch(() => null),\n    ]);\n    if (!lease.current() || get().rosterRequest !== request || hasPending())\n      return;\n    const personalEffects = applyPersonalConversationStates(\n      rawSet,\n      get,\n      lease,\n      personal,\n    );\n    // Full state work can wait on personal documents after its roster facts\n    // were read. Keep any newer published presence while still applying those\n    // personal documents and continuing the full history reconciliation.\n    const publishObservation = observation >= publishedRosterObservation;\n    // Reusing accounts only observes presence. It must not supersede a pending\n    // full account read of durable metadata independent of discovery facts.\nfrontend/src/store/chat.ts:640:function applyPersonalConversationStates(\nfrontend/src/lib/linkedCustomizationPacks.ts:76:  const policy = await chat.getDeviceSyncPolicy(owner);\nfrontend/src/lib/linkedCustomizationPacks.ts:150:        chat.getDeviceSyncPolicy(owner),\nfrontend/src/lib/linkedAppearance.ts:165:        readWithDeadline(() => chat.getDeviceSyncPolicy(owner)),\nfrontend/src/lib/linkedAppearance.test.ts:62:    getDeviceSyncPolicy: mocks.getPolicy,\nfrontend/src/lib/linkedReadReceipts.test.ts:370:    .spyOn(chat, \"getDeviceSyncPolicy\")\nfrontend/src/lib/linkedReadReceipts.test.ts:372:      ReturnType<typeof chat.getDeviceSyncPolicy>\nfrontend/src/lib/linkedReadReceipts.ts:206:    policy: () => chat.getDeviceSyncPolicy(owner),\nfrontend/src/lib/linkedCustomizationPacks.test.ts:30:    getDeviceSyncPolicy: mocks.policy,\nfrontend/src/lib/linkedContacts.test.ts:25:    getDeviceSyncPolicy: mocks.policy,\nfrontend/src/lib/api.test.ts:399:  await chat.getDeviceSyncPolicy(\"owner-a\");\nfrontend/src/lib/api/chat.ts:180:  getDeviceSyncPolicy: (owner: string) =>\nfrontend/src/lib/linkedContacts.ts:182:        readWithDeadline(() => chat.getDeviceSyncPolicy(owner)),\n","exit_code":0,"duration":{"secs":0,"nanos":13625}},"started_at_ms":1795419473209,"completed_at_ms":1795419473209}}
