ing/OctopusGarage/mesh-talk/tmp/req-011/mac-current-reception.L0kXKrV0/idle/native-app.log\\nMEASURE process-usable 1795418197.900116\\nMEASURE bootstrap {\\\"historyVerificationMs\\\":362,\\\"loginToUsableMs\\\":1323}\\nMEASURE foreground start 1795418202.903304\\nMEASURE foreground end 1795418563.920271\\nMEASURE minimized start 1795418568.925969\\nMEASURE minimized end 1795418929.935322\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a2074f-5164-76b3-b74d-98a79a0016be","create_time":1795419033.84319}},"metadata":{"history_sequence":17028,"sampled_through_sequence":17026,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
