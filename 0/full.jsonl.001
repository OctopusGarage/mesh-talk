awSet, get, conversation, invalidate),\n\n  send: async (text, replyTo) => {\n    const lease = captureChat(get);\n    if (!lease.current()) return;\n    const c = get().active;\n    if (!get().ready || !c || !text.trim()) return;\n    await sendIntent(rawSet, get, c, { kind: \"text\", text, replyTo });\n  },\n\n  // The composer needs an immediate admission answer so it never clears a draft that\n  // could not enter the local optimistic queue. Delivery still settles asynchronously.\n  admitText: (text, replyTo, expiresAtMs, protection) => {\n    const lease = captureChat(get);\n    if (!lease.current()) return false;\n    const c = get().active;\n    if (!get().ready || !c || !text.trim()) return false;\n    const dispatch = beginSendIntent(rawSet, get, c, {\n      kind: \"text\",\n      text,\n      replyTo,\n      expiresAtMs,\n      protection,\n    });\nfrontend/src/store/outgoingIntent.ts:91:export async function refreshDeliveryStatuses(\n1528:        void get().refreshStatuses();\n1617:        void get().refreshStatuses(undefined, true);\n1619:      else void get().refreshStatuses(undefined, true);\n2056:  refreshStatuses: (conversation, invalidate) =>\nreq011-linux-desktop-current-acceptance Up 19 minutes\nMEASURE foreground start 1795408064.925789\nMEASURE foreground end 1795408394.936841\nMEASURE minimized start 1795408399.946231\n 2349 02:48 ssh\n 6091 15:13 /bin/zsh\n30037 11:44 /bin/zsh\n","exit_code":0,"duration":{"secs":0,"nanos":23579916}},"started_at_ms":1795408557264,"completed_at_ms":1795408557287}}
