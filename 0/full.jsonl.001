llowed).\nconst SCAN_STARTUP_DELAYS_SECS: [u64; 3] = [1, 3, 7];\nconst SCAN_STEADY_INTERVAL: Duration = Duration::from_secs(5);\n// Together with the two-second sweep budget this stays below public presence's\n// 15-second lease on networks where unicast is the only discovery path.\n}\n\n#[cfg(test)]\nasync fn scan_addresses(\n    socket: &UdpSocket,\n    bytes: &[u8],\n    targets: impl IntoIterator<Item = SocketAddr>,\n    visibility: &DiscoveryVisibility,\n) -> bool {\n    scan_addresses_counted(socket, bytes, targets, visibility, &mut 0).await\n}\n\nasync fn scan_addresses_counted(\n    socket: &UdpSocket,\n    bytes: &[u8],\n    targets: impl IntoIterator<Item = SocketAddr>,\n    visibility: &DiscoveryVisibility,\n    visited: &mut usize,\n) -> bool {\n    for (index, target) in targets.into_iter().enumerate() {\n        if index != 0 {\n            tokio::time::sleep(SCAN_PACKET_SPACING).await;\n        }\n        *visited += 1;\n        if matches!(\n            visibility.send_announce(socket, bytes, target).await,\n            Ok(false)\n        ) {\n            return false;\n        }\n    }\n    true\n}\n\n// Interface identity matters even when a replacement adapter has the same IP.\n// Inventory failures retain the last observation instead of inventing a handoff.\ntype InterfaceSnapshot = BTreeSet<(String, IpAddr, Option<u32>)>;\nconst INTERFACE_POLL_INTERVAL: Duration = Duration::from_secs(2);\nconst REJOIN_INTERVAL: Duration = Duration::from_secs(30);\n\nfn interface_snapshot() -> Option<InterfaceSnapshot> {\n    Some(\n        if_addrs::get_if_addrs()\n            .ok()?\n            .into_iter()\n            .filter(|iface| !iface.is_loopback())\n            .map(|iface| (iface.name.clone(), iface.ip(), iface.index))\n            .collect(),\n    )\n}\n\nfn update_interface_snapshot(\n    previous: &mut Option<InterfaceSnapshot>,\n    current: Option<InterfaceSnapshot>,\n) -> bool {\n    let Some(current) = current else {\n        return false;\n    };\n    let changed = previous.as_ref() != Some(&current);\n    *previous = Some(current);\n    changed\n}\n\n/// Rejoin and wake the existing privacy-gated producers when interfaces change.\n/// The periodic fallback still retries joins that failed without another change.\nasync fn run_rejoin(\n    socket: Arc<UdpSocket>,\n    trigger: Arc<Notify>,\n    network_changes: Option<tokio::sync::watch::Sender<u64>>,\n) {\n    // Subscribe before the first inventory so a concurrent handoff remains\n    // observable. Failure falls back to the existing short poll.\n    #[cfg(target_os = \"linux\")]\n    let mut events = super::interface_events::InterfaceEvents::subscribe().ok();\n    let mut previous = interface_snapshot();\n    let mut last_rejoin = Instant::now();\n    loop {\n        #[cfg(target_os = \"linux\")]\n        if let Some(watcher) = &events {\n            let remaining = REJOIN_INTERVAL.saturating_sub(last_rejoin.elapsed());\n            tokio::select! {\n                result = watcher.next() => {\n                    if result.is_err() {\n                        events = None;\n                    }\n                }\n                _ = tokio::time::sleep(remaining) => {}\n            }\n        } else {\n            tokio::time::sleep(INTERFACE_POLL_INTERVAL).await;\n        }\n        #[cfg(not(target_os = \"linux\"))]\n        tokio::time::sleep(INTERFACE_POLL_INTERVAL).await;\n        let changed = update_interface_snapshot(&mut previous, interface_snapshot());\n        if changed || last_rejoin.elapsed() >= REJOIN_INTERVAL {\n            join_discovery_group_all_ifaces(&socket);\n            last_rejoin = Instant::now();\n        }\n        if changed {\n            // Includes the desktop's routed candidate task when supplied by its\n            // participant owner; headless hosts share the same LAN wake path.\n            if let Some(changes) = &network_changes {\n                changes.send_modify(|generation| *generation = generation.wrapping_add(1));\n            }\n            trigger.notify_waiters();\n        }\n    }\n}\n\n/// Spawn the full discovery task set on one shared `socket` and return their\n/// handles: listen (with announce/response reply), multicast broadcast (2s),\n/// unicast /24 scan fallback, and periodic multicast re-join. The three call sites\n/// (desktop runtime, CLI node, post office) all use this — they only differ in the\n/// prebuilt `announce` they pass.\npub fn spawn_discovery(\n    socket: Arc<UdpSocket>,\n    roster: Arc<Mutex<Roster>>,\n    announce: Announce,\n    self_user_id: String,\n    discovery_port: u16,\n) -> Vec<JoinHandle<()>> {\n985:async fn run_rejoin(\n995:    let mut last_rejoin = Instant::now();\n999:            let remaining = REJOIN_INTERVAL.saturating_sub(last_rejoin.elapsed());\n1014:        if changed || last_rejoin.elapsed() >= REJOIN_INTERVAL {\n1016:            last_rejoin = Instant::now();\n1132:    rejoin: JoinHandle<()>,\n1139:        vec![self.listener, self.broadcast, self.scan, self.rejoin]\n1143:        [self.broadcast.id(), self.scan.id(), self.rejoin.id()]\n1214:    let rejoin = run_rejoin(socket, trigger, network_changes);\n1216:    let rejoin = spawn_observed_ambient(rejoin, first_polls.clone());\n1218:    let rejoin = tokio::spawn(rejoin);\n1223:        rejoin,\n1674:    fn interface_changes_refresh_discovery_without_waiting_for_periodic_rejoin() {\nreq011-linux-desktop-current-build 315.44% 3.261GiB / 7.668GiB\n20920       02:07 rustc\n22709       01:33 rustc\n","exit_code":0,"duration":{"secs":1,"nanos":653279250}},"started_at_ms":1795407167978,"completed_at_ms":1795407169633}}
