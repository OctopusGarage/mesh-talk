e configured target filter synchronously.\nfn emit_info(logger: &dyn log::Log, args: std::fmt::Arguments<'_>) {\n    let metadata = log::Metadata::builder()\n        .level(log::Level::Info)\n        .target(\"mesh_talk_core::node::node\")\n        .build();\n    if logger.enabled(&metadata) {\n        logger.log(&log::Record::builder().metadata(metadata).args(args).build());\n    }\n}\n\npub(super) fn startup_phase_clock(scope: &'static str) -> impl Fn(&'static str) + Copy {\n    let clock = (std::env::var_os(\"MESH_TALK_TRACE_WORK\").as_deref()\n        == Some(std::ffi::OsStr::new(\"1\")))\n    .then(Instant::now);\n    move |phase| {\n        if let Some(clock) = clock {\n            log::info!(\n                target: \"mesh_talk_core::runtime_startup\",\n                \"runtime_startup phase={phase} elapsed_ms={} scope={scope}\",\n                clock.elapsed().as_millis()\n            );\n        }\n    }\n}\n\nconst INTERVAL: Duration = Duration::from_secs(30);\nconst ROWS: usize = 64;\n\nconst RECENT_IDS: usize = 4096;\n\nMEASURE minimized start 1795408750.664320\r\nMEASURE minimized end 1795409095.666656\r\n[1123/124455.684:ERROR:ui\\gfx\\win\\window_impl.cc:172] Failed to unregister class Chrome_WidgetWin_0. Error = 1412\r\n","exit_code":0,"duration":{"secs":0,"nanos":553423708}},"started_at_ms":1795409108786,"completed_at_ms":1795409109340}}
