{"timestamp":"2026-11-23T07:44:10.712Z","ordinal":40556,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1feaf-24d9-7612-a284-664abd64a2c4","turn_id":"01a2075b-e4e9-7ff1-a860-bc3e842d0fb3","item":{"type":"CommandExecution","id":"exec-55a7c8d7-d285-4737-932b-e22945d7dcc1","process_id":"4248","command":["/bin/zsh","-lc","sed -n '139,246p' crates/mesh-talk-core/src/node/channel_account_maintenance.rs; rg -n 'maintain_one_account_channel|settled.insert' crates/mesh-talk-core/src/node/channel_account_maintenance.rs"],"cwd":"file:///Users/kingsonwu/programming/OctopusGarage/mesh-talk","parsed_cmd":[{"type":"read","cmd":"sed -n '139,246p' crates/mesh-talk-core/src/node/channel_account_maintenance.rs","name":"channel_account_maintenance.rs","path":"crates/mesh-talk-core/src/node/channel_account_maintenance.rs"},{"type":"search","cmd":"rg -n 'maintain_one_account_channel|settled.insert' crates/mesh-talk-core/src/node/channel_account_maintenance.rs","query":"maintain_one_account_channel|settled.insert","path":"channel_account_maintenance.rs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    projection_reads: usize,\n    #[cfg(test)]\n    eligibility_reads: usize,\n    #[cfg(test)]\n    distribution_reads: usize,\n    input: Option<[u8; 32]>,\n    observed_input: Option<[u8; 32]>,\n    run_at: Option<Instant>,\n    settled: BTreeMap<[u8; 32], ([u8; 32], Instant)>,\n    peers: BTreeMap<String, Capability>,\n    peer_cursor: usize,\n    channel_cursor: usize,\n    refresh_after: BTreeMap<([u8; 32], [u8; 32]), Instant>,\n}\nimpl ChannelAccountMaintenance {\n    pub(super) fn deadline(&self) -> Instant {\n        self.run_at.unwrap_or_else(Instant::now)\n    }\n\n    // Scheduling evidence only: admitted work still checks current signed\n    // authority, privacy and source fences. Capture before work, so mutations\n    // during a turn cannot be acknowledged by that turn's completion.\n    // Watch generations and last-seen timestamps are deliberately excluded.\n    async fn input(&self, node: &Arc<Node>) -> Result<[u8; 32], LogError> {\n        use sha2::{Digest, Sha256};\n        let revision = node.observe_group_projection_revision().await?;\n        let consent = node\n            .channel_migration\n            .lock()\n            .expect(\"channel migration lock\")\n            .record\n            .roots\n            .clone();\n        let mut routes: Vec<_> = node\n            .roster\n            .lock()\n            .expect(\"roster lock\")\n            .peers()\n            .into_iter()\n            .map(|peer| {\n                let mut routes: Vec<_> = peer\n                    .routes\n                    .iter()\n                    .map(|route| route.addr)\n                    .chain([peer.addr])\n                    .collect();\n                routes.sort_unstable();\n                routes.dedup();\n                (peer.public, peer.account_id, peer.post_office, routes)\n            })\n            .collect();\n        routes.sort_unstable_by_key(|peer| peer.0.user_id());\n        // Raw cached hints grant nothing. Calling routing_peers here would\n        // evaluate shared-group authority before the producer gate.\n        let mut cached = node\n            .privacy\n            .state\n            .read()\n            .expect(\"privacy state lock\")\n            .as_ref()\n            .map(|state| state.routes.routes())\n            .unwrap_or_default();\n        cached.sort_unstable_by_key(|(public, ip)| (public.ed25519_pub, public.x25519_pub, *ip));\n        let capabilities: Vec<_> = self\n            .peers\n            .iter()\n            .map(|(id, value)| {\n                (\n                    id,\n                    &value.public,\n                    value.generation,\n                    value.supported,\n                    value.supported && Instant::now() < value.probe_at,\n                    &value.proof,\n                    &value.account_hint,\n                )\n            })\n            .collect();\n        let bytes = bincode::serialize(&(\n            revision,\n            consent,\n            routes,\n            cached,\n            capabilities,\n            node.sibling_availability_revision(),\n        ))\n        .map_err(|error| LogError::Serialization(error.to_string()))?;\n        Ok(Sha256::digest(bytes).into())\n    }\n\n    fn next_deadline(&self, own_account: &str) -> Instant {\n        let now = Instant::now();\n        let mut deadline = now + REFRESH;\n        for value in self.peers.values() {\n            deadline = deadline.min(value.probe_at);\n            if value.supported {\n                deadline = deadline.min(value.binding_poll_at);\n                if value.account_hint.as_deref() == Some(own_account) {\n                    deadline = deadline.min(value.poll_at);\n                }\n                if !value.pending.is_empty()\n                    || value.after.is_some()\n                    || value.binding_after.is_some()\n                {\n                    deadline = deadline.min(now + Duration::from_secs(3));\n                }\n            }\n        }\n543:                        let maintained = self.maintain_one_account_channel(channel, work).await;\n563:                let ready = self.maintain_one_account_channel(channel, work).await;\n681:    async fn maintain_one_account_channel(\n735:            work.settled.insert(*channel.as_bytes(), (input, until));\n2478:            assert!(node.maintain_one_account_channel(channel, &mut work).await);\n2496:        assert!(node.maintain_one_account_channel(channel, &mut work).await);\n","exit_code":0,"duration":{"secs":0,"nanos":24666}},"started_at_ms":1795419850712,"completed_at_ms":1795419850712}}
