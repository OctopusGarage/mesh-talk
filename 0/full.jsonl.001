ub(crate) fn with_unchanged_revision<T>(\n        &self,\n        revision: u64,\n        operation: impl FnOnce() -> Result<T, CommandError>,\n    ) -> Result<T, CommandError> {\n        let inner = self\n            .0\n            .lock()\n            .map_err(|_| CommandError::Internal(\"lock unavailable\".into()))?;\n        if inner.lease.is_some() || inner.authorization_revision != revision {\n            return Err(CommandError::Authorization(\n                \"app lock changed during authentication\".into(),\n            ));\n        }\n        operation()\n    }\n\n    pub fn is_locked(&self) -> bool {\n        self.0.lock().map_or(true, |lock| lock.lease.is_some())\n    }\n\n    fn lock(&self, lease: SessionLease) -> Result<(), CommandError> {\n        let mut inner = self\n            .0\n            .lock()\n            .map_err(|_| CommandError::Internal(\"lock unavailable\".into()))?;\n        inner.authorization_revision = inner.authorization_revision.wrapping_add(1);\n        inner.generation = lease.generation();\n        inner.lease = Some(lease);\n        inner.call_active = false;\n        Ok(())\n    }\n\n    fn unlock(&self, lease: &SessionLease) -> Result<(), CommandError> {\n        let mut guard = self\n            .0\n            .lock()\n            .map_err(|_| CommandError::Internal(\"lock unavailable\".into()))?;\n        if guard.lease.as_ref() != Some(lease) {\n            return Err(CommandError::Authorization(\n                \"session changed while locked\".into(),\n            ));\n        }\n        guard.authorization_revision = guard.authorization_revision.wrapping_add(1);\n        guard.lease = None;\n        guard.last_activity = Instant::now();\n        Ok(())\n    }\n\n    pub fn clear(&self) {\n        if let Ok(mut guard) = self.0.lock() {\n            guard.authorization_revision = guard.authorization_revision.wrapping_add(1);\n            guard.lease = None;\n            guard.call_active = false;\n            guard.last_activity = Instant::now();\n        }\n    }\n\n    fn activity(&self, generation: u64, call_active: Option<bool>) {\n        if let Ok(mut inner) = self.0.lock() {\n            if inner.generation != generation {\n                inner.generation = generation;\n                inner.call_active = false;\n            }\n            inner.last_activity = Instant::now();\n            if let Some(active) = call_active {\n                inner.call_active = active;\n            }\n        }\n    }\n\n    pub fn tick<R: tauri::Runtime>(&self, handle: &tauri::AppHandle<R>) {\n        let app = handle.state::<AppState>();\n        let settings = handle.state::<crate::settings::SettingsState>().get();\n        let Ok(lease) = app.session().capture() else {\n            return;\n        };\n        // The visibility query dispatches to the native window thread.\n        // Idle-time locking and the default disabled policy do not need it.\n        let hidden = settings.lock_when_hidden\n            && handle\n                .get_webview_window(\"main\")\n                .is_some_and(|window| !window.is_visible().unwrap_or(true));\n        let should_lock = {\n            let Ok(mut inner) = self.0.lock() else {\n                return;\n            };\n            if inner.generation != lease.generation() {\n                inner.generation = lease.generation();\n                inner.last_activity = Instant::now();\n                inner.call_active = false;\n                return;\nsrc-tauri/src/lib.rs:399:                crate::app_lock::note_activity,\nfrontend/src/App.tsx:40:  const lockWhenHidden = useSettings((s) => s.privacy.lock_when_hidden);\nfrontend/src/App.test.ts:268:  const activity = callsFor(\"note_activity\").length;\nfrontend/src/App.test.ts:276:  expect(callsFor(\"note_activity\")).toHaveLength(activity);\nfrontend/src/App.test.ts:309:  const activity = callsFor(\"note_activity\").length;\nfrontend/src/App.test.ts:314:  expect(callsFor(\"note_activity\")).toHaveLength(activity + 1);\nsrc-tauri/src/settings.rs:101:    pub lock_when_hidden: bool,\nsrc-tauri/src/settings.rs:143:            lock_when_hidden: false,\nsrc-tauri/src/settings.rs:202:    lock_when_hidden: bool,\nsrc-tauri/src/settings.rs:232:            lock_when_hidden: value.lock_when_hidden,\nsrc-tauri/src/settings.rs:262:            lock_when_hidden: self.lock_when_hidden,\nsrc-tauri/src/settings.rs:277:                self.lock_when_hidden = false;\nsrc-tauri/src/settings.rs:284:                self.lock_when_hidden = false;\nsrc-tauri/src/settings.rs:291:                self.lock_when_hidden = true;\nsrc-tauri/src/settings.rs:921:        lock_when_hidden,\nsrc-tauri/src/settings.rs:922:        previous.lock_when_hidden && !next.lock_when_hidden\nsrc-tauri/src/settings.rs:950:        || (previous.lock_when_hidden && !next.lock_when_hidden)\nsrc-tauri/src/settings.rs:1403:        assert!(next.lock_when_hidden);\nsrc-tauri/src/settings.rs:2255:        assert!(!settings.lock_when_hidden);\nsrc-tauri/src/settings.rs:2279:        assert!(strict.lock_when_hidden);\nfrontend/src/store/settings.test.ts:152:    lock_when_hidden: true,\nfrontend/src/store/settings.test.ts:168:    lock_when_hidden: false,\nfrontend/src/lib/linkedAppearance.test.ts:302:    lock_when_hidden: true,\nfrontend/src/lib/types.ts:420:  lock_when_hidden: boolean;\nfrontend/src/lib/privacySettings.ts:9:  | \"lock_when_hidden\"\nfrontend/src/lib/privacySettings.ts:18:  lock_when_hidden: false,\nfrontend/src/lib/privacySettings.ts:31:    lock_when_hidden: settings.lock_when_hidden,\nfrontend/src/lib/api/auth.ts:62:  noteActivity: () => invoke<void>(\"note_activity\"),\n","exit_code":0,"duration":{"secs":0,"nanos":13250}},"started_at_ms":1795408795129,"completed_at_ms":1795408795129}}
