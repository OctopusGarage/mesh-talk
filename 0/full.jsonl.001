let mut live: Vec<_> = self.announcements.values().collect();\n        live.sort_by(|a, b| a.user_id.cmp(&b.user_id));\n        let bytes = bincode::serialize(&(historical, live))\n            .map_err(|error| crate::eventlog::LogError::Serialization(error.to_string()))?;\n        let digest = Sha256::digest(bytes).into();\n        let stranger = DeviceIdentity::generate();\n        let other_proof = Announce::new_with_account(&stranger, &Account::generate(), \"Other\", 1);\n        roster.update_relayed(&other_proof, relay, \"self\");\n        roster.set_registration_origin(&other_proof.user_id, relay, Some(origin));\n        assert!(\n            roster.get(&other_proof.user_id).unwrap().routes[0]\n                .registration_origin\n                .is_none(),\n            \"another participant cannot borrow consent\"\n        );\n    }\n\n    #[test]\n    fn relayed_name_change_publishes_observation_without_route_change() {\n        let device = DeviceIdentity::generate();\n        let account = Account::generate();\n        let mut roster = Roster::default();\n        let relay = \"127.0.0.1:47479\".parse().unwrap();\n        let proof = Announce::new_with_account(&device, &account, \"before\", 1);\n        roster.update_relayed(&proof, relay, \"self\");\n        let mut observer = roster.subscribe_changes();\n        roster.update_relayed(&proof, relay, \"self\");\n        assert!(!observer.has_changed().unwrap());\n        let renamed = Announce::new_with_account(&device, &account, \"after\", 1);\n        roster.update_relayed(&renamed, relay, \"self\");\n        assert!(\n            observer.has_changed().unwrap(),\n            \"name-only update must reach name-directory subscriber\"\n        );\n        observer.borrow_and_update();\n        roster.update_relayed(&renamed, relay, \"self\");\n        assert!(!observer.has_changed().unwrap());\n    }\n\n    #[test]\n    fn directory_commit_notifies_presence_after_staging_without_recovery_storms() {\n        let device = DeviceIdentity::generate();\n        let proof = Announce::new_with_account(&device, &Account::generate(), \"member\", 1);\n        let mut roster = Roster::default();\n        let relay = \"127.0.0.1:47479\".parse().unwrap();\n        roster.update_relayed(&proof, relay, \"self\");\n        let mut observer = roster.subscribe_changes();\n        let _ = futures_util::FutureExt::now_or_never(roster.changes().notified());\n        let now = Instant::now();\n        roster.set_directory_expiry(&proof.user_id, relay, now + Duration::from_secs(10), 10);\n        assert!(\n            observer.has_changed().unwrap(),\n            \"committed public evidence must notify the UI\"\n        );\n        observer.borrow_and_update();\n        roster.set_directory_expiry(&proof.user_id, relay, now + Duration::from_secs(10), 10);\n        assert!(\n            !observer.has_changed().unwrap(),\n            \"identical origin is quiet\"\n        );\n        roster.set_directory_expiry(&proof.user_id, relay, now + Duration::from_secs(14), 14);\n        assert!(\n            observer.has_changed().unwrap(),\n            \"renewed origin must not wait for the desktop fallback\"\n        roster,\n        self_user_id,\n        announce,\n        discovery_port,\n        visibility,\n        Some(routed),\n    ))\n}\n\n#[cfg(test)]\n#[path = \"privacy_tests.rs\"]\nmod privacy_tests;\n\n#[cfg(test)]\nmod tests {\n    #[tokio::test]\n    async fn idle_discovery_keeps_known_unicast_lease_without_repeating_subnet_inventory() {\n        use std::sync::atomic::{AtomicUsize, Ordering};\n        let producer = Arc::new(UdpSocket::bind(\"127.0.0.1:0\").await.unwrap());\n        let receiver = Arc::new(UdpSocket::bind(\"127.0.0.1:0\").await.unwrap());\n        let discovery_port = receiver.local_addr().unwrap().port();\n        let identity = DeviceIdentity::generate();\n        let remote = DeviceIdentity::generate();\n        // TCP listener ports are deliberately unrelated to the UDP discovery port.\n        let own = Announce::new(&identity, \"producer\", 54321);\n        let peer = Announce::new(&remote, \"receiver\", 54322);\n        let roster = Arc::new(Mutex::new(Roster::default()));\n        roster\n            .lock()\n            .unwrap()\n            .update(&peer, \"127.0.0.1\".parse().unwrap(), &identity.user_id());\n        let received = Arc::new(Mutex::new(Roster::default()));\n        received\n            .lock()\n            .unwrap()\n            .update(&own, \"127.0.0.1\".parse().unwrap(), &remote.user_id());\n        let peer_socket = receiver.clone();\n        let producer_address = producer.local_addr().unwrap();\n        let heartbeat_bytes = encode(&peer);\n        let heartbeat = tokio::spawn(async move {\n            loop {\n                tokio::time::sleep(Duration::from_secs(5)).await;\n                peer_socket\n                    .send_to(&heartbeat_bytes, producer_address)\n                    .await\n                    .unwrap();\n            }\n        });\n        let listening = tokio::spawn(run_listen(\n            receiver.clone(),\n            received.clone(),\n            remote.user_id(),\n            shared_announce(&peer),\n            producer.local_addr().unwrap().port(),\n        ));\n        let inventories = Arc::new(AtomicUsize::new(0));\n        let visibility = Arc::new(DiscoveryVisibility::with_inventory(true, {\n            let inventories = inventories.clone();\n            move || {\n                inventories.fetch_add(1, Ordering::SeqCst);\n                vec![crate::discovery::scope::LanInterface {\n                    address: \"127.0.0.2\".parse().unwrap(),\n                    prefix: 24,\n                    index: None,\n                }]\n            }\n        }));\n        visibility.set_physical_lan_only(true).await;\n        let trigger = Arc::new(Notify::new());\n        let mut handles = spawn_discovery_with_routed(\n            producer,\n"}],"internal_ch