elf.operation.lock().await;\n        self.suspend_locked_with_registry(make_registry, registration_id)\n            .await\n    }\n    /// Caller owns the registration operation lock; the token check is made\n    /// inside that serialization rather than before an asynchronous wait.\n    async fn suspend_locked<R: Runtime>(\n        &self,\n        app: &tauri::AppHandle<R>,\n        registration_id: u64,\n    ) -> Result<(), CommandError> {\n        let handle = app.clone();\n        self.suspend_locked_with_registry(move || NativeRegistry(handle), registration_id)\n            .await\n    }\n    async fn suspend_locked_with_registry<F, G>(\n        &self,\n        make_registry: F,\n        registration_id: u64,\n    ) -> Result<(), CommandError>\n    where\n        F: FnOnce() -> G + Send + 'static,\n        G: Registry<Key = Shortcut> + Send + 'static,\n    {\n        let previous = self.inner.lock().unwrap().clone();\n        if previous.registration_id != registration_id {\n            return Ok(());\n        }\n        let before: Vec<_> = previous.bindings.iter().map(|item| item.0).collect();\n        if !before.is_empty() {\n            tokio::task::spawn_blocking(move || replace_keys(&mut make_registry(), &before, &[]))\n                .await\n                .map_err(|error| CommandError::Internal(error.to_string()))?\n                .map_err(CommandError::Internal)?;\n        }\n        let mut inner = self.inner.lock().unwrap();\n        inner.bindings.clear();\n        inner.pressed.clear();\n        inner.lease = None;\n        inner.registration_id = inner.registration_id.wrapping_add(1);\n        Ok(())\n    }\n}\n\n#[tauri::command]\npub(crate) async fn sync_screenshot_shortcuts(\n    app: tauri::AppHandle,\n    owner: String,\n) -> Result<ShortcutStatus, CommandError> {\n            \"main\",\n            \"screenshot-shortcut\",\n            CaptureRequest {\n                owner: request.0.owner().to_owned(),\n                generation: request.0.generation(),\n                hide_window: request.1 || hidden,\n            },\n        );\n    });\n    let _ = app.run_on_main_thread(queued);\n}\n\n/// Release OS accelerators after native lock/logout, even when the webview is unavailable.\npub(crate) async fn suspend_retired<R: Runtime>(app: &tauri::AppHandle<R>) {\n    let handle = app.clone();\n    suspend_retired_for(app, move || NativeRegistry(handle)).await;\n}\n\nasync fn suspend_retired_for<R, F, G>(app: &tauri::AppHandle<R>, make_registry: F)\nwhere\n    R: Runtime,\n    F: FnOnce() -> G + Send + 'static,\n    G: Registry<Key = Shortcut> + Send + 'static,\n{\n    let state = app.state::<ScreenshotShortcutState>();\n    let snapshot = state.inner.lock().unwrap().clone();\n    if snapshot\n        .lease\n        .as_ref()\n        .is_some_and(|lease| !current(&app.state::<AppState>(), lease))\n        && let Err(error) = state\n            .suspend_with_registry(make_registry, snapshot.registration_id)\n            .await\n    {\n        log::warn!(\"Could not suspend screenshot shortcuts: {error}\");\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[cfg(target_os = \"linux\")]\n    #[test]\n    #[ignore = \"requires a dedicated X11 display\"]\n    fn x11_global_manager_lives_only_while_bindings_are_registered() {\n        let state = ScreenshotShortcutState::default();\n        let host = tauri::test::mock_builder()\n            .manage(state.clone())\n            .build(tauri::test::mock_context(tauri::test::noop_assets()))\n            .unwrap();\n        let mut registry = NativeRegistry(host.handle().clone());\n        let first: Shortcut = \"Control+Alt+Shift+KeyU\".parse().unwrap();\n        let second: Shortcut = \"Control+Alt+Shift+KeyY\".parse().unwrap();\n\n        assert!(state.linux.lock().unwrap().manager.is_none());\n        registry.register(first).unwrap();\n        registry.register(second).unwrap();\n        assert!(registry.is_registered(first));\n        assert!(registry.is_registered(second));\n        registry.unregister(first).unwrap();\n        assert!(state.linux.lock().unwrap().manager.is_some());\n        registry.unregister(second).unwrap();\nsrc-tauri/src/screenshot_shortcuts.rs:515:pub(crate) async fn suspend_screenshot_shortcuts(\nsrc-tauri/src/screenshot_shortcuts.rs:521:    suspend_screenshot_shortcuts_for(&app, &owner, generation, registration_id).await\nsrc-tauri/src/screenshot_shortcuts.rs:524:async fn suspend_screenshot_shortcuts_for<R: Runtime>(\nsrc-tauri/src/screenshot_shortcuts.rs:1168:                suspend_screenshot_shortcuts_for(handle, owner, generation, token)\nsrc-tauri/src/screenshot_shortcuts.rs:1175:            suspend_screenshot_shortcuts_for(handle, fixture.lease.owner(), status.generation, 1)\nsrc-tauri/src/screenshot_shortcuts.rs:1186:            suspend_screenshot_shortcuts_for(handle, fixture.lease.owner(), status.generation, 1)\nsrc-tauri/src/lib.rs:543:                crate::screenshot_shortcuts::suspend_screenshot_shortcuts,\nsrc-tauri/src/app_lock.rs:204:            | \"suspend_screenshot_shortcuts\"\n99:    pub auto_lock_seconds: u32,\n142:            auto_lock_seconds: 0,\n201:    auto_lock_seconds: u32,\n231:            auto_lock_seconds: value.auto_lock_seconds,\n261:            auto_lock_seconds: self.auto_lock_seconds,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a206b3-afe5-78a2-be67-0520fb372869","create_time":1795408808.956043}},"metadata":{"history_sequence":14930,"sampled_through_sequence":14928,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
