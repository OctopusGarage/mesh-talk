 else {\n                return;\n            };\n            if inner.generation != lease.generation() {\n                inner.generation = lease.generation();\n                inner.last_activity = Instant::now();\n                inner.call_active = false;\n                return;\n            }\n            due(&inner, &settings, hidden)\n        };\n        if !should_lock {\n            return;\n        }\n        let locked = app\n            .session()\n            .matching(&lease, |_| {\n                let Ok(mut inner) = self.0.lock() else {\n                    return false;\n                };\n                let still_due =\n                    inner.generation == lease.generation() && due(&inner, &settings, hidden);\n                if still_due {\n                    inner.authorization_revision = inner.authorization_revision.wrapping_add(1);\n                    inner.lease = Some(lease.clone());\n                }\n                still_due\n            })\n            .unwrap_or(false);\n        if locked {\n            *app.drafts.lock().unwrap() = None;\n            let _ = handle.emit(\"app-locked\", ());\n        }\n    }\n}\n\n#[tauri::command]\npub fn note_activity(app: tauri::State<'_, AppState>, state: tauri::State<'_, AppLock>) {\n    state.activity(app.session().generation(), None);\n}\n\n#[tauri::command]\npub fn set_call_active(\n    app: tauri::State<'_, AppState>,\n    state: tauri::State<'_, AppLock>,\n    active: bool,\n) {\n    state.activity(app.session().generation(), Some(active));\n}\n\n/// Only lock recovery and sign-out can run during a lock. Plugin IPC has its own capability gate.\npub fn allowed_while_locked(command: &str) -> bool {\n    matches!(\n        command,\n        \"lock_status\"\n        ))\n        .setup(move |app| {\n            #[cfg(target_os = \"linux\")]\n            app.manage(crate::window_visibility::HiddenPositions::default());\n            if let Err(e) = crate::logger::init_logging(app.handle()) {\n                log::error!(\"Failed to initialize logging: {e}\");\n            }\n            if let Ok(cache) = app.path().app_cache_dir() {\n                crate::chat_commands::clean_stale_pasted_files(&cache);\n            }\n            #[cfg(target_os = \"linux\")]\n            crate::diagnostics::log_linux_graphics_configuration();\n            crate::config_store::quarantine_legacy(&app.handle().clone());\n            // Seed the managed settings from disk before any window/notification logic runs.\n            crate::settings::load_into_state(&app.handle().clone(), &app.state::<SettingsState>());\n            {\n                let handle = app.handle().clone();\n                tauri::async_runtime::spawn(async move {\n                    loop {\n                        tokio::time::sleep(std::time::Duration::from_secs(1)).await;\n                        handle.state::<crate::app_lock::AppLock>().tick(&handle);\n                        crate::screenshot_shortcuts::suspend_retired(&handle).await;\n                    }\n                });\n            }\n            crate::tray::create_system_tray(&app.handle().clone())?;\n\n            // Chat-history retention: one app-lifetime task that periodically erases messages\n            // older than the configured window. Spawned once here (not per-login) so tasks\n            // don't accumulate across login/logout; it's a no-op while logged out (no node) or\ntmp/req-011/mailbox-native-receive_worker_.log:test result: ok. 4 passed; 0 failed; 0 ignored; 0 measured; 3712 filtered out; finished in 6.22s\ntmp/req-011/mailbox-native-modern_relay_receive_.log:test result: ok. 2 passed; 0 failed; 0 ignored; 0 measured; 3714 filtered out; finished in 23.04s\ntmp/req-011/mailbox-native-healthy_relay_receive_.log:test result: ok. 3 passed; 0 failed; 0 ignored; 0 measured; 3713 filtered out; finished in 11.72s\n","exit_code":0,"duration":{"secs":0,"nanos":13750}},"started_at_ms":1795405725262,"completed_at_ms":1795