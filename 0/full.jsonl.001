n    assert_eq!(fixture.ack(&roster).unwrap(), json!(true));\\n    let next = fixture.pull(roster[\\\"next\\\"].clone(), false).unwrap();\\n    assert!(\\n        next[\\\"receipts\\\"]\\n            .as_array()\\n            .unwrap()\\n            .iter()\\n            .any(|r| r[\\\"event\\\"][\\\"kinds\\\"] == json!([\\\"roster\\\", \\\"delivery\\\"]))\\n    );\\n    fixture.ack(&next).unwrap();\\n    progress(\\n        fixture.view.app_handle(),\\n        &fixture.scope,\\n        crate::events::FileProgressEvent {\\n            file_conv: \\\"file\\\".into(),\\n            direction: \\\"receive\\\",\\n            done: 1,\\n            total: 2,\\n        },\\n    );\\n    let next = fixture.pull(next[\\\"next\\\"].clone(), false).unwrap();\\n    assert!(\\n        next[\\\"receipts\\\"]\\n            .as_array()\\n            .unwrap()\\n            .iter()\\n            .any(|r| r[\\\"kind\\\"] == \\\"progress\\\")\\n    );\\n    assert!(\\n        !next[\\\"receipts\\\"]\\n            .as_array()\\n            .unwrap()\\n            .iter()\\n            .any(|r| r[\\\"kind\\\"] == \\\"state\\\")\\n    );\\n                .unwrap(),\\n                body: tauri::ipc::InvokeBody::Json(body),\\n                headers: Default::default(),\\n                invoke_key: tauri::test::INVOKE_KEY.into(),\\n            },\\n        )\\n        .map(|body| body.deserialize().unwrap())\\n    }\\n    fn pull(&self, after: Value, reset: bool) -> Result<Value, Value> {\\n        self.invoke(\\n            \\\"owner_reception_page\\\",\\n            json!({\\\"scope\\\":self.scope,\\\"after\\\":after,\\\"through\\\":null,\\\"reset\\\":reset}),\\n        )\\n    }\\n    fn ack(&self, page: &Value) -> Result<Value, Value> {\\n        self.invoke(\\\"owner_reception_ack\\\", json!({\\\"scope\\\":self.scope,\\\"token\\\":page[\\\"token\\\"],\\\"after\\\":page[\\\"after\\\"],\\\"next\\\":page[\\\"next\\\"]}))\\n    }\\n}\\nimpl Drop for Fixture {\\n    fn drop(&mut self) {\\n        tauri::async_runtime::block_on(async {\\n            let runtime = self.node.0.write().await.take();\\n            if let Some(runtime) = runtime {\\n                runtime.stop().await;\\n            }\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20734-ed79-7930-a06c-c249312abdb5","create_time":1795417266.749964}},"metadata":{"history_sequence":16663,"sampled_through_sequence":16660,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
