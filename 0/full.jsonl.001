ork_changes.subscribe();\ncrates/mesh-talk-core/src/node/privacy_routing.rs:388:                    let network = *self.network_changes.borrow();\ncrates/mesh-talk-core/src/node/runtime.rs:138:        network: *node.network_changes.borrow(),\ncrates/mesh-talk-core/src/node/runtime.rs:342:    let mut network = node.network_changes.subscribe();\ncrates/mesh-talk-core/src/node/privacy_runtime.rs:1593:                            *self.network_changes.borrow(), std::time::Instant::now())?)\ncrates/mesh-talk-core/src/node/participant_runtime.rs:6:    RoutedDiscovery, SharedAnnounce, shared_announce, spawn_discovery_with_network_changes,\ncrates/mesh-talk-core/src/node/participant_runtime.rs:259:        let discovery = spawn_discovery_with_network_changes(\ncrates/mesh-talk-core/src/node/participant_runtime.rs:268:            Some(node.network_changes.clone()),\ncrates/mesh-talk-core/src/node/participant_runtime.rs:295:            let mut network = node.network_changes.subscribe();\ncrates/mesh-talk-core/src/node/participant_runtime.rs:416:                let mut network = node.network_changes.subscribe();\ncrates/mesh-talk-core/src/node/participant_runtime.rs:452:                let mut network = node.network_changes.subscribe();\ncrates/mesh-talk-core/src/node/group_file_authorization_tests.rs:2782:    let mut network = node.network_changes.subscribe();\ncrates/mesh-talk-core/src/node/participant_runtime_tests.rs:285:    let mut network = node.network_changes.subscribe();\ncrates/mesh-talk-core/src/node/participant_runtime_tests.rs:355:    let mut network = node.network_changes.subscribe();\ncrates/mesh-talk-core/src/node/participant_runtime_tests.rs:429:    let mut network = node.network_changes.subscribe();\ncrates/mesh-talk-core/src/node/participant_runtime_tests.rs:462:    let mut network = node.network_changes.subscribe();\ncrates/mesh-talk-core/src/node/participant_runtime_tests.rs:506:    let mut network = node.network_changes.subscribe();\ncrates/mesh-talk-core/src/node/participant_runtime_tests.rs:672:    node.network_changes\ncrates/mesh-talk-core/src/node/participant_runtime_tests.rs:759:    node.network_changes\nimport { openSidebarMenuAction } from \"./helpers/sidebar-actions\";\nimport { expect, test } from \"./tauri-mock\";\nimport { enterChat } from \"./helpers/session\";\n\ntest(\"no network uses the attention state in connection details\", async ({\n  page,\n}) => {\n  await enterChat(page);\n  await page.evaluate(() => {\n    (\n      window as unknown as {\n        __mockSetNetworkInterfaces: (interfaces: string[]) => void;\n      }\n    ).__mockSetNetworkInterfaces([]);\n  });\n  await openSidebarMenuAction(page, \"sidebar-nav-connection\");\n  const status = page.getByTestId(\"diagnostics-status\");\n  await expect(status).toContainText(\"No network connection\");\n  await expect(status.getByText(\"No network connection\")).toHaveClass(\n    /text-attention/,\n  );\n});\n\ntest(\"connection details distinguish load failure from an empty network\", async ({\n  page,\n}) => {\n  await enterChat(page);\n  await page.evaluate(() => {\n    (\n      window as unknown as { __mockFailNext: (command: string) => void }\n    ).__mockFailNext(\"diag_network_info\");\n  });\n  await openSidebarMenuAction(page, \"sidebar-nav-connection\");\n  const dialog = page.getByTestId(\"diagnostics-dialog\");\n  await expect(page.getByTestId(\"diagnostics-status\")).toContainText(\n    \"Ready to find people\",\n  );\n  await expect(dialog.getByRole(\"alert\")).toContainText(\n    \"Couldn’t load network details\",\n  );\n  await dialog.getByRole(\"button\", { name: \"Retry\" }).click();\n  await expect(dialog.getByRole(\"alert\")).toHaveCount(0);\n  await expect(dialog.getByText(\"Discovery port\")).toBeVisible();\n});\n\ntest(\"a late network load cannot replace details after reopening\", async ({\n  page,\n}) => {\n  await enterChat(page);\n  await page.evaluate(() => {\n    const win = window as unknown as {\n      __rejectOldNetwork?: (error: Error) => void;\n      __TAURI_INTERNALS__: {\n        invoke: (\n          cmd: string,\n          args: Record<string, unknown>,\n        ) => Promise<unknown>;\n      };\n    };\n    const invoke = win.__TAURI_INTERNALS__.invoke.bind(win.__TAURI_INTERNALS__);\n    let first = true;\n    win.__TAURI_INTERNALS__.invoke = (cmd, args) => {\n      if (cmd === \"diag_network_info\" && first) {\n        first = false;\n        return new Promise((_, reject) => {\n          win.__rejectOldNetwork = reject;\n        });\n      }\n      return invoke(cmd, args);\n    };\n  });\n  await openSidebarMenuAction(page, \"sidebar-nav-connection\");\n  const dialog = page.getByTestId(\"diagnostics-dialog\");\n  await page.waitForFunction(\n    () =>\n      typeof (window as unknown as { __rejectOldNetwork?: unknown })\n        .__rejectOldNetwork === \"function\",\n  );\n  await dialog.getByRole(\"button\", { name: \"Close\" }).click();\n  await openSidebarMenuAction(page, \"sidebar-nav-connection\");\n  await expect(dialog.getByText(\"Discovery port\")).toBeVisible();\n  await page.evaluate(async () => {\n    (\n      window as unknown as { __rejectOldNetwork: (error: Error) => void }\n    ).__rejectOldNetwork(new Error(\"stale network failure\"));\n    await new Promise<void>((resolve) =>\n      requestAnimationFrame(() => requestAnimationFrame(() => resolve())),\n    );\n  });\n  await expect(dialog.getByRole(\"alert\")).toHaveCount(0);\n});\n\ntest(\"a failed announce is visible on the current connection tab\", async ({\n  page,\n}) => {\n  await enterChat(page);\n  await openSidebarMenuAction(page, \"sidebar-nav-connection\");\n  const dialog = page.getByTestId(\"diagnostics-dialog\");\n  await page.getByTestId(\"diagnostics-tab-peers\").click();\n  await page.evaluate(() => {\n    (\n      window as unknown as { __mockFailNext: (command: string) => void }\nasync fn current_ssid() -> Option<String> {\n    // `networksetup -getairportnetwork` is blocked without Location on recent macOS, but\n    // `system_profiler SPAirPortDataType` still reports the joined network: under a\n    // \"Current Network Information:\" line, the next line is \"<SSID>:\".\n    let out = ssid_output(\"system_profiler\", &[\"SPAirPortDataType\"]).await?;\n    let text = String::from_utf8_lossy(&out.stdout);\n    let mut lines = text.lines();\n    while let Some(line) = lines.next() {\n        if line.trim() == \"Current Network Information:\" {\n            let ssid = lines.next()?.trim().trim_end_matches(':').trim();\n            return (!ssid.is_empty()).then(|| ssid.to_string());\n        }\n    }\n    None\n}\n\n#[cfg(target_os = \"windows\")]\nasync fn current_ssid() -> Option<String> {\n    let out = ssid_output(\"netsh\", &[\"wlan\", \"show\", \"interfaces\"]).await?;\n    let text = String::from_utf8_lossy(&out.stdout);\n    for line in text.lines() {\n        let l = line.trim();\n        // Match \"SSID                   : Name\" but not \"BSSID\".\n        if l.starts_with(\"SSID\")\n            && !l.starts_with(\"BSSID\")\n            && let Some((_, v)) = l.split_once(':')\n        {\n            let v = v.trim();\n            if !v.is_empty() {\n                return Some(v.to_string());\n            }\n        }\n    }\n    None\n}\n\n#[cfg(target_os = \"linux\")]\nasync fn current_ssid() -> Option<String> {\n    if let Some(out) = ssid_output(\"nmcli\", &[\"-t\", \"-f\", \"active,ssid\", \"dev\", \"wifi\"]).await {\n        let text = String::from_utf8_lossy(&out.stdout);\n        for line in text.lines() {\n            if let Some(rest) = line.strip_prefix(\"yes:\") {\n                let s = rest.trim();\n                if !s.is_empty() {\n                    return Some(s.to_string());\n                }\n            }\n","exit_code":0,"duration":{"secs":0,"nanos":24792}},"started_at_ms":1795409268564,"completed_at_ms":1795409268564}}
