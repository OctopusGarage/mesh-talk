p_port);\\n            let visibility = visibility.clone();\\n            let permit = startup_work.admit().expect(\\\"startup root admitted\\\");\\n            permit\\n                .spawn_blocking(move || {\\n                    #[cfg(test)]\\n                    if let Some(hook) = PRIVACY_OPEN_HOOKS.lock().unwrap().remove(&directory) {\\n                        hook();\\n                    }\\n                    node.configure_privacy(&directory, &password, &own, visibility)\\n                })\\n                .await\\n                .map_err(|_| {\\n                    RuntimeError::Io(std::io::Error::other(\\\"privacy initialization failed\\\"))\\n                })?\\n                .into_inner()?;\\n        }\\n        observe_phase(\\\"privacy_configured\\\");\\n        visibility\\n            .set_public(!node.privacy_snapshot().invisible)\\n            .await;\\n\\n        let prepared = PreparedParticipant::prepare(\\n            Arc::clone(&node),\\n            listener,\\n            visibility,\\n            ParticipantConfig {\\n                discovery_port,\\n                candidate_source,\\n            },\\n        )?;\\n\\n        let mut launch = Some(move |current_name: &str| {\\n            // A persisted account claim survives host-local nicknames and adoption.\\nsrc-tauri/src/commands.rs:262:            \\\"desktop_login_auth_ms={}\\\", clock.elapsed().as_millis()\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20744-0df1-7620-bfed-3b5503c2e21c","create_time":1795418249.11868}},"metadata":{"history_sequence":16882,"sampled_through_sequence":16879,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
