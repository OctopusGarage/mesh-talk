ble' }\n$env:CARGO_HOME = $cargoHome\n$env:CARGO_TARGET_DIR = \"D:/MeshTalk/REQ011/windows-desktop.qdpc7iim/target\"\n$env:RUSTC = \"$rustRoot/bin/rustc.exe\"\n$env:RUSTDOC = \"$rustRoot/bin/rustdoc.exe\"\n$env:TEMP = \"$Work/temp\"\n$env:TMP = $env:TEMP\n$env:USERPROFILE = $profile\n$env:APPDATA = \"$profile/appdata\"\n$env:LOCALAPPDATA = \"$profile/localappdata\"\n$perlRoot = 'D:/MeshTalk/REQ011/windows-headless.QxOg9tqF/strawberry-perl'\n$perl = \"$perlRoot/perl/bin/perl.exe\"\nif (!(Test-Path $perl)) { throw 'Verified portable Perl unavailable' }\n$env:OPENSSL_SRC_PERL = $perl\n$env:PERL = $perl\n$env:GITHUB_ENV = \"$Work/native-deps.env\"\n& $node \"$source/scripts/ci/windows-native-deps.mjs\"\nif ($LASTEXITCODE -ne 0) { throw 'Native dependencies unavailable' }\nforeach ($line in (Get-Content $env:GITHUB_ENV)) {\n    $key, $value = $line -split '=', 2\n    if ($key -in @('OPENSSL_SRC_PERL', 'PERL')) { Set-Item \"Env:$key\" $value }\n}\n$env:npm_config_cache = \"$cache/npm\"\nSet-Location \"$source/frontend\"\n& npm.cmd ci --no-audit --no-fund\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\n& npm.cmd run build\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\n$env:TAURI_CONFIG = '{\"identifier\":\"com.mesh-talk.req011.desktop-probe\"}'\n$probeSource = \"$Work/unified-desktop-window-state.rs\"\nif ((Get-FileHash $probeSource -Algorithm SHA256).Hash.ToLowerInvariant() -ne \"29dd1fe01fc49652ffb7307d4a9f8e06361528bbf108e6ebbafcc760ed1de66b\") {\n    throw 'Unified desktop probe source digest mismatch'\n}\n$bins = \"$source/src-tauri/src/bin\"\nNew-Item -ItemType Directory -Force -Path $bins | Out-Null\nCopy-Item $probeSource \"$bins/req011-driverless-loaded.rs\"\nSet-Location $source\n& \"$rustRoot/bin/cargo.exe\" build --locked --release -j 2 -p mesh-talk --bin req011-driverless-loaded\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\n$out = \"$Work/isolated-window-state-probes\"\nNew-Item -ItemType Directory -Path $out | Out-Null\nCopy-Item \"$env:CARGO_TARGET_