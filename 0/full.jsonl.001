] ?? \"state\";\n1580:        notifySyncInvalidation({\n1609:      notifySyncInvalidation({\n1706:        notifySyncInvalidation({ owner: e.owner, kind: \"state\" });\n        notifySyncInvalidation({\n          owner: lease.owner!,\n          kind: \"state\",\n          scope: kind,\n        });\n        return;\n      }\n      const rosterLease = kind === \"roster\" ? captureChat(get) : undefined;\n      const ticket =\n        kind === \"roster\"\n          ? createRosterObservation(\n              lease.owner!,\n              async () => {\n                const value = await rosterPresenceApi.observeRoster(\n                  lease.owner!,\n                );\n                if (\n                  value.identity.owner !== lease.owner ||\n                  value.identity.device_id !== get().myId ||\n                  value.identity.account_id !== get().myAccountId ||\n                  (value.identity.runtime_id !== undefined &&\n                    value.identity.runtime_id !== get().deliveryRuntime)\n                )\n                  throw new Error(\"Roster source identity changed\");\n                return value;\n              },\n              rosterLease!.current,\n            )\n          : undefined;\n      notifySyncInvalidation({\n        owner: lease.owner!,\n        kind,\n        rosterObservation: ticket,\n      });\n      if (kind === \"state\") {\n        void refreshRoster(true);\n        void get().refreshChannels();\n        void get().refreshStatuses(undefined, true);\n      } else if (kind === \"roster\") void presenceRosterRefresh(ticket);\n      else void get().refreshStatuses(undefined, true);\n      if (kind !== \"roster\") void refreshGroupOperationIntents(rawSet, get);\n    };\n\n    const matchesRuntime = (scope: ReceptionScope) => {\n      const state = get();\n      return (\n        lease.current() &&\n        scope.owner === lease.owner &&\n        scope.account_id === state.myAccountId &&\n        scope.device_id === state.myId &&\n        scope.runtime_id === state.deliveryRuntime\n      );\n    };\n    const unlisten = subscribeNodeEvents({\n      onReceptionWake: (scope) => {\n        // Runtime installation emits this wake. It can accelerate a fresh\n        // identity read, and only that read can confirm the current runtime.\n        if (\n          lease.current() &&\n          scope.owner === lease.owner &&\n          get().bootBusy &&\n          get().bootRequest === bootRequest\n        ) {\n          if (wakeBoot) wakeBoot();\n          else pendingBootHint = true;\n        }\n        if (matchesRuntime(scope)) wakeReception();\n      },\n      onRosterChanged: (scope) => {\n        // These hints only update the roster presentation. Activation uses a\n        // fresh snapshot, and durable receipt wakes have their own handler.\n        if (\n          get().ready &&\n          matchesRuntime(scope) &&\n          (typeof document === \"undefined\" ||\n            document.visibilityState !== \"hidden\")\n        )\n          applyInvalidation(\"roster\");\n      },\n      onStateChanged: (e) => {\n        const state = get();\n        if (\n          !lease.current() ||\n          !state.ready ||\n          e.owner !== lease.owner ||\n          e.account_id !== state.myAccountId ||\n          e.device_id !== state.myId\n        )\n          return;\n        applyInvalidation(e.kind);\n      },\n      onIntegrationMessageAccepted: (e) => {\n        const state = get();\n        if (\n          !lease.current() ||\n          !state.ready ||\n          e.owner !== lease.owner ||\n          e.account_id !== state.myAccountId\n        )\n          return;\n        if (e.destination.kind === \"account\")\n          state.onAccountMessageCommitted?.(e.destination.id);\n        if (\n          !state.active ||\n          e.destination.kind !== state.active.kind ||\n          e.destination.id !== state.active.id\n        )\n          return;\n        // Outgoing delegated sends do not count as inbound notifications. Fetch\n        // their content through the same guarded history path as ordinary sends.\n        void requestConversationReload(rawSet, get);\n      },\n\n      onDm: (e) => {\n        if (lease.current()) get_handleDm(set, get, e);\n      },\n      onChannelChanged: (e) => {\n        const state = get();\n        if (\n          !lease.current() ||\n          !state.ready ||\n          e.owner !== lease.owner ||\n          e.account_id !== state.myAccountId ||\n          e.device_id !== state.myId\n        )\n          return;\n        notifySyncInvalidation({ owner: e.owner, kind: \"state\" });\n        void state.refreshChannels(e.channel_id);\n        void refreshGroupOperationIntents(rawSet, get);\n      },\n      onChannelMessage: (e) => {\n        if (lease.current()) get_handleChannel(set, get, e);\n      },\n      onFile: (e) => {\n        if (lease.current()) get_handleFile(set, get, e);\n      },\n      onFileProgress: (e) => {\n        if (lease.current()) applyChatFileProgress(e);\n      },\n      onAccountProfile: (event) => {\n        const state = get();\n        if (\n          lease.current() &&\n          useAuth.getState().user?.id === event.user.id &&\n          state.myAccountId === event.account_id &&\n          state.myId === event.device_id\n        )\n          useAuth.setState({\n            user: event.user,\n            ...(event.saved_session != null\n              ? { savedSession: event.saved_session }\n","exit_code":0,"duration":{"secs":0,"nanos":11750}},"started_at_ms":1795416452116,"completed_at_ms":1795416452116}}
