{"timestamp":"2026-11-23T04:12:47.850Z","ordinal":33925,"type":"token_usage_record","payload":{"thread_id":"01a1feaf-24d9-7612-a284-664abd64a2c4","turn_id":"01a2069a-5c22-79c2-86f9-8d4567adaa33","session_id":"01a1feaf-24d9-7612-a284-664abd64a2c4","root_turn_id":"01a2069a-5c22-79c2-86f9-8d4567adaa33","response_id":"resp_0dca4931a04d8132016b03bd3a50a487d0882a4449dc45d8ac","usage":{"input_tokens":76232,"cached_input_tokens":75648,"cache_write_input_tokens":0,"output_tokens":152,"reasoning_output_tokens":12,"total_tokens":76384},"turn_token_usage":{"input_tokens":726076,"cached_input_tokens":713472,"cache_write_input_tokens":0,"output_tokens":1373,"reasoning_output_tokens":79,"total_tokens":727449},"thread_token_usage":{"input_tokens":1210661935,"cached_input_tokens":1205609600,"cache_write_input_tokens":0,"output_tokens":1057416,"reasoning_output_tokens":284931,"total_tokens":1211719351}}}
{"timestamp":"2026-11-23T04:12:48.983Z","ordinal":33926,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a2069b-45d7-73a2-8d21-19937a039bb6","call_id":"call_7ed483cf46bb4e2b9352f61823e233a4","output":[{"type":"input_text","text":"Script completed\nWall time 1.2 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"a315db\",\"wall_time_seconds\":1.000768,\"session_id\":59329,\"original_token_count\":1985,\"output\":\"/// so discovery self-heals when the network returns rather than dying silently.\\npub async fn run_broadcast(\\n    socket: Arc<UdpSocket>,\\n    announce: SharedAnnounce,\\n    target: SocketAddr,\\n    interval: Duration,\\n    trigger: Option<Arc<Notify>>,\\n) {\\n    run_broadcast_with_visibility(\\n        socket,\\n        announce,\\n        target,\\n        interval,\\n        trigger,\\n        Arc::new(DiscoveryVisibility::default()),\\n    )\\n    .await;\\n}\\n\\nasync fn run_broadcast_with_visibility(\\n    socket: Arc<UdpSocket>,\\n    announce: SharedAnnounce,\\n    target: SocketAddr,\\n    interval: Duration,\\n    trigger: Option<Arc<Notify>>,\\n    visibility: Arc<DiscoveryVisibility>,\\n) {\\n    // Startup offsets are measured from launch, not added to one another. Manual\\n    // requests remain responsive even while the burst is in progress.\\n    let started = tokio::time::Instant::now();\\n    for offset_ms in BROADCAST_STARTUP_BURST_MS {\\n        let deadline = started + Duration::from_millis(offset_ms);\\n        loop {\\n            if let Some(notify) = &trigger {\\n                tokio::select! {\\n                    _ = tokio::time::sleep_until(deadline) => break,\\n                    _ = notify.notified() => {}\\n                }\\n            } else {\\n                tokio::time::sleep_until(deadline).await;\\n                break;\\n            }\\n            let bytes = current_announce(&announce);\\n            let _ = visibility.send_announce(&socket, &bytes, target).await;\\n        }\\n        let bytes = current_announce(&announce);\\n        let _ = visibility.send_announce(&socket, &bytes, target).await;\\n    }\\n    let mut tick = tokio::time::interval(interval);\\n    tick.tick().await; // consume the immediate first tick (the burst just sent)\\n    loop {\\n        // Steady re-announce on the timer, OR an immediate one when triggered.\\n        match &trigger {\\n            Some(notify) => tokio::select! {\\n                _ = tick.tick() => {}\\n                _ = notify.notified() => {}\\n            },\\n            None => {\\n                tick.tick().await;\\n            }\\n        }\\n        // Read the current announce each send so a runtime rename takes effect here.\\n        // Ignore send errors: the network may be transiently down. Retry next tick.\\n        let bytes = current_announce(&announce);\\n        let _ = visibility.send_announce(&socket, &bytes, target).await;\\n    }\\n}\\n\\n/// The discovery port unicast-scan cadence: offsets from launch for quick startup\\n/// sweeps so a peer that came up just before us is found fast, then a steady\\n/// slow interval (multicast/broadcast carry the steady-state load; the scan is\\n/// the fallback for when those are blocked but unicast is allowed).\\nconst SCAN_STARTUP_DELAYS_SECS: [u64; 3] = [1, 3, 7];\\nconst SCAN_STEADY_INTERVAL: Duration = Duration::from_secs(5);\\n// Together with the two-second sweep budget this stays below public presence's\\n// 15-second lease on networks where unicast is the only discovery path.\\n}\\n\\n#[cfg(test)]\\nasync fn scan_addresses(\\n    socket: &UdpSocket,\\n    bytes: &[u8],\\n    targets: impl IntoIterator<Item = SocketAddr>,\\n    visibility: &DiscoveryVisibility,\\n) -> bool {\\n    scan_addresses_counted(socket, bytes, targets, visibility, &mut 0).await\\n}\\n\\nasync fn scan_addresses_counted(\\n    socket: &UdpSocket,\\n    bytes: &[u8],\\n    targets: impl IntoIterator<Item = SocketAddr>,\\n    visibility: &DiscoveryVisibility,\\n    visited: &mut usize,\\n) -> bool {\\n    for (index, target) in targets.into_iter().enumerate() {\\n        if index != 0 {\\n            tokio::time::sleep(SCAN_PACKET_SPACING).await;\\n        }\\n        *visited += 1;\\n        if matches!(\\n            visibility.send_announce(socket, bytes, target).await,\\n            Ok(false)\\n        ) {\\n            return false;\\n        }\\n    }\\n    true\\n}\\n\\n// Interface identity matters even when a replacement adapter has the same IP.\\n// Inventory failures retain the last observation instead of inventing a handoff.\\ntype InterfaceSnapshot = BTreeSet<(String, IpAddr, Option<u32>)>;\\nconst INTERFACE_POLL_INTERVAL: Duration = Duration::from_secs(2);\\nconst REJOIN_INTERVAL: Duration = Duration::from_secs(30);\\n\\nfn interface_snapshot() -> Option<InterfaceSnapshot> {\\n    Some(\\n        if_addrs::get_if_addrs()\\n            .ok()?\\n            .into_iter()\\n            .filter(|iface| !iface.is_loopback())\\n            .map(|iface| (iface.name.clone(), iface.ip(), iface.index))\\n            .collect(),\\n    )\\n}\\n\\nfn update_interface_snapshot(\\n    previous: &mut Option<InterfaceSnapshot>,\\n    current: Option<InterfaceSnapshot>,\\n) -> bool {\\n    let Some(current) = current else {\\n        return false;\\n    };\\n    let changed = previous.as_ref() != Some(&current);\\n    *previous = Some(current);\\n    changed\\n}\\n\\n/// Rejoin and wake the existing privacy-gated producers when interfaces change.\\n/// The periodic fallback still retries joins that failed without another change.\\nasync fn run_rejoin(\\n    socket: Arc<UdpSocket>,\\n    trigger: Arc<Notify>,\\n    network_changes: Option<tokio::sync::watch::Sender<u64>>,\\n) {\\n    // Subscribe before the first inventory so a concurrent handoff remains\\n    // observable. Failure falls back to the existing short poll.\\n    #[cfg(target_os = \\\"linux\\\")]\\n    let mut events = super::interface_events::InterfaceEvents::subscribe().ok();\\n    let mut previous = interface_snapshot();\\n    let mut last_rejoin = Instant::now();\\n    loop {\\n        #[cfg(target_os = \\\"linux\\\")]\\n        if let Some(watcher) = &events {\\n            let remaining = REJOIN_INTERVAL.saturating_sub(last_rejoin.elapsed());\\n            tokio::select! {\\n                result = watcher.next() => {\\n                    if result.is_err() {\\n                        events = None;\\n                    }\\n                }\\n                _ = tokio::time::sleep(remaining) => {}\\n            }\\n        } else {\\n            tokio::time::sleep(INTERFACE_POLL_INTERVAL).await;\\n        }\\n        #[cfg(not(target_os = \\\"linux\\\"))]\\n        tokio::time::sleep(INTERFACE_POLL_INTERVAL).await;\\n        let changed = update_interface_snapshot(&mut previous, interface_snapshot());\\n        if changed || last_rejoin.elapsed() >= REJOIN_INTERVAL {\\n            join_discovery_group_all_ifaces(&socket);\\n            last_rejoin = Instant::now();\\n        }\\n        if changed {\\n            // Includes the desktop's routed candidate task when supplied by its\\n            // participant owner; headless hosts share the same LAN wake path.\\n            if let Some(changes) = &network_changes {\\n                changes.send_modify(|generation| *generation = generation.wrapping_add(1));\\n            }\\n            trigger.notify_waiters();\\n        }\\n    }\\n}\\n\\n/// Spawn the full discovery task set on one shared `socket` and return their\\n/// handles: listen (with announce/response reply), multicast broadcast (2s),\\n/// unicast /24 scan fallback, and periodic multicast re-join. The three call sites\\n/// (desktop runtime, CLI node, post office) all use this — they only differ in the\\n/// prebuilt `announce` they pass.\\npub fn spawn_discovery(\\n    socket: Arc<UdpSocket>,\\n    roster: Arc<Mutex<Roster>>,\\n    announce: Announce,\\n    self_user_id: String,\\n    discovery_port: u16,\\n) -> Vec<JoinHandle<()>> {\\n985:async fn run_rejoin(\\n995:    let mut last_rejoin = Instant::now();\\n999:            let remaining = REJOIN_INTERVAL.saturating_sub(last_rejoin.elapsed());\\n1014:        if changed || last_rejoin.elapsed() >= REJOIN_INTERVAL {\\n1016:            last_rejoin = Instant::now();\\n1132:    rejoin: JoinHandle<()>,\\n1139:        vec![self.listener, self.broadcast, self.scan, self.rejoin]\\n1143:        [self.broadcast.id(), self.scan.id(), self.rejoin.id()]\\n1214:    let rejoin = run_rejoin(socket, trigger, network_changes);\\n1216:    let rejoin = spawn_observed_ambient(rejoin, first_polls.clone());\\n1218:    let rejoin = tokio::spawn(rejoin);\\n1223:        rejoin,\\n1674:    fn interface_changes_refresh_discovery_without_waiting_for_periodic_rejoin() {\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a2069a-5c22-79c2-86f9-8d4567adaa33","create_time":1795407168.983769}},"metadata":{"history_sequence":14418,"sampled_through_sequence":14415,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
