n\n    let rosterBusy = false;\n    let rosterDirty = false;\n    const refreshRoster = async (invalidate = false) => {\n      if (rosterBusy) {\n        rosterDirty ||= invalidate;\n        return;\n      }\n      rosterBusy = true;\n      try {\n        do {\n          rosterDirty = false;\n          await get().refreshRoster();\n        } while (rosterDirty && lease.current());\n      } finally {\n        rosterBusy = false;\n      }\n    };\n    const stopRosterRecovery = startRecoveryRefresh(\n      () => {\n        if (!lease.current() || !get().ready) return;\n        wakeReception();\n        void refreshRoster();\n        void get().refreshStatuses();\n      },\n      {\n        intervalMs: () =>\n          supportsPushState(lease.owner) ? RECOVERY_REFRESH_MS : 2000,\n      },\n    );\n    const controlObservation = groupOperationObservation(rawSet, get);\n    let controlTimer: ReturnType<typeof setTimeout> | undefined;\n    const scheduleControl = () => {\n      if (controlTimer !== undefined) clearTimeout(controlTimer);\n      controlTimer = undefined;\n      if (cancelled || !lease.current()) return;\n626:const presenceRosterRefresh = createRosterRefresh<RosterTicket>({\n1618:      } else if (kind === \"roster\") void presenceRosterRefresh(ticket);\n2588:    void presenceRosterRefresh();\nfrontend/src/components/AvatarGallery.tsx:164:                        <Loader2 className=\"h-5 w-5 animate-spin text-white motion-reduce:hidden\" />\nfrontend/src/components/ui/dialog.tsx:19:      \"fixed inset-0 z-50 bg-black/60 duration-150 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0\",\nfrontend/src/components/ui/dialog.tsx:38:          \"dialog-surface fixed left-1/2 top-1/2 z-50 grid grid-cols-[minmax(0,1fr)] max-h-[calc(100vh-2rem)] w-[calc(100vw-2rem)] max-w-md [translate:-50%_-50%] gap-4 overflow-y-auto [scrollbar-gutter:stable] rounded-xl border bg-popover p-5 shadow-elevation-lg duration-150 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0\",\nfrontend/src/App.tsx:439:        <Loader2 className=\"h-4 w-4 animate-spin\" />\nfrontend/src/index.css:716:@keyframes surface-appear {\nfrontend/src/index.css:727:@keyframes dialog-appear {\nfrontend/src/index.css:824:@keyframes welcome-appear {\nfrontend/src/features/auth/LoginScreen.tsx:352:                  {loading && <Loader2 className=\"h-4 w-4 animate-spin\" />}\nfrontend/src/features/auth/DeviceEnrollmentDialog.tsx:344:            <Loader2 className=\"h-4 w-4 shrink-0 animate-spin motion-reduce:animate-none\" />\nfrontend/src/features/chat/UpdatePanel.tsx:96:              className=\"h-4 w-4 animate-spin motion-reduce:animate-none\"\nfrontend/src/features/chat/UpdatePanel.tsx:228:                        className=\"h-4 w-4 shrink-0 animate-spin motion-reduce:animate-none\"\nfrontend/src/features/chat/ConversationView.tsx:747:              className=\"h-5 w-5 animate-spin text-signal motion-reduce:animate-none\"\nfrontend/src/features/chat/VerifyContactDialog.tsx:370:              {busy && <Loader2 className=\"h-4 w-4 animate-spin\" />}\nfrontend/src/features/chat/ConversationStates.tsx:126:        <Loader2 className=\"h-7 w-7 animate-spin text-signal\" />\nfrontend/src/features/chat/DiagnosticsDialog.tsx:203:              className=\"h-4 w-4 animate-spin text-signal motion-reduce:animate-none\"\nfrontend/src/features/chat/UnreadMessages.tsx:293:                className=\"h-4 w-4 animate-spin motion-reduce:animate-none\"\nfrontend/src/features/chat/AvatarCropDialog.tsx:296:                <Loader2 className=\"h-6 w-6 animate-spin text-muted-foreground\" />\nfrontend/src/features/chat/AvatarCropDialog.tsx:353:            {busy && <Loader2 className=\"h-4 w-4 animate-spin\" />}\nfrontend/src/features/chat/CreateChannelDialog.tsx:215:            {busy && <Loader2 className=\"h-4 w-4 animate-spin\" />}\nfrontend/src/features/chat/se