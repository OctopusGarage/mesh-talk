     index: None,\n                }]\n            }\n        }));\n        visibility.set_physical_lan_only(true).await;\n        let identity = DeviceIdentity::generate();\n        let worker = tokio::spawn(run_scan_with_visibility(\n            socket,\n            shared_announce(&Announce::new(&identity, \"hidden\", 54321)),\n            47474,\n            None,\n            visibility,\n        ));\n        let result = async {\n            tokio::task::yield_now().await;\n            tokio::time::advance(Duration::from_secs(2)).await;\n            for _ in 0..32 {\n                tokio::task::yield_now().await;\n            }\n            assert_eq!(\n                inventories.load(Ordering::SeqCst),\n                0,\n                \"hidden scan must gate before interface inventory and target construction\"\n            );\n        };\n        use futures_util::FutureExt;\n        let outcome = std::panic::AssertUnwindSafe(result).catch_unwind().await;\n        worker.abort();\n        let _ = worker.await;\n        if let Err(panic) = outcome {\n            std::panic::resume_unwind(panic);\n        }\n    }\n\n    #[tokio::test(start_paused = true)]\n    async fn idle_discovery_restoration_with_empty_roster_wakes_unknown_scan() {\n        let sender = Arc::new(UdpSocket::bind(\"127.0.0.1:0\").await.unwrap());\n        let receiver = UdpSocket::bind(\"127.0.0.1:0\").await.unwrap();\n        let visibility = Arc::new(DiscoveryVisibility::with_inventory(false, || {\n            vec![crate::discovery::scope::LanInterface {\n                address: \"127.0.0.2\".parse().unwrap(),\n                prefix: 24,\n                index: None,\n            }]\n        }));\n        visibility.set_physical_lan_only(true).await;\n        let identity = DeviceIdentity::generate();\n        let own = Announce::new(&identity, \"restored\", 54321);\n        let worker = tokio::spawn(run_scan_with_roster(\n            sender,\n            shared_announce(&own),\n            receiver.local_addr().unwrap().port(),\n            None,\n            visibility.clone(),\n            Some(Arc::new(Mutex::new(Roster::default()))),\n        ));\n        let result = async {\n            tokio::task::yield_now().await;\n            for _ in 0..9 {\n                tokio::time::advance(Duration::from_secs(1)).await;\n                for _ in 0..16 {\n                    tokio::task::yield_now().await;\n                }\n            }\n            visibility.set_public(true).await;\n            let mut bytes = [0; 2048];\n            let (len, _) = tokio::time::timeout(\n                Duration::from_secs(1),\n                receiver.recv_from(&mut bytes),\n            )\n            .await\n            .expect(\n                \"visibility restoration must not wait for three-hundred-second unknown-host repair\",\n            )\n            .unwrap();\n            assert_eq!(decode(&bytes[..len]), Some(own));\n        };\n        use futures_util::FutureExt;\n        let outcome = std::panic::AssertUnwindSafe(result).catch_unwind().await;\n        worker.abort();\n        let _ = worker.await;\n        if let Err(panic) = outcome {\n            std::panic::resume_unwind(panic);\n        }\n    }\n\n    #[tokio::test]\n    async fn idle_discovery_known_ready_batches_reach_tail_beyond_subnet_budget() {\n        let sender = UdpSocket::bind(\"127.0.0.1:0\").await.unwrap();\n        {\n            return UpdateOutcome::Rejected;\n        }\n        let now = Instant::now();\n        let existing = self.peers.get(&announce.user_id);\n        let existed = existing.is_some();\n        let name_changed = existing.is_some_and(|peer| peer.name != announce.name);\n        let mut routes = existing.map(|peer| peer.routes.clone()).unwrap_or_default();\n        let route_changed = !routes\n            .iter()\n            .any(|route| route.addr == relay && route.source == RouteSource::PostOffice);\n        let prior = routes\n            .iter()\n            .find(|route| route.addr == relay && route.source == RouteSource::PostOffice);\n        let prior_expiry = prior.and_then(|route| route.presence_expires_at);\n        let prior_origin = prior.and_then(|route| route.presence_origin_expires_at);\n        let prior_hops = prior.and_then(|route| route.origin_hops);\n        let prior_registration = prior.and_then(|route| route.registration_origin.clone());\n        routes.retain(|route| route.addr != relay || route.source != RouteSource::PostOffice);\n        routes.push(PeerEndpoint {\n            addr: relay,\n            source: RouteSource::PostOffice,\n            last_seen: now,\n            last_authenticated: None,\n            presence_expires_at: prior_expiry,\n            presence_origin_expires_at: prior_origin,\n            origin_hops: prior_hops,\n            registration_origin: prior_registration,\n        });\n        if routes.len() > MAX_ROUTES_PER_PEER {\n            routes.remove(0);\n        }\n        if !existed\n            && self.peers.len() >= MAX_PEERS\n            && let Some(oldest) = self\n                .peers\n                .iter()\n                .min_by_key(|(_, peer)| peer.last_seen)\n                .map(|(id, _)| id.clone())\n        {\n            self.peers.remove(&oldest);\n            self.remove_live(&oldest);\n        }\n        if self.historical.len() < MAX_PEERS || self.historical.contains_key(&announce.user_id) {\n            self.store_history(announce);\n        }\n        self.store_live(announce);\n        let direct = preferred_route(&routes).map(|route| route.addr);\n        self.peers.insert(\n            announce.user_id.clone(),\n            PeerRecord {\n                public: announce.public(),\n                addr: direct.unwrap_or(relay),\n                routes,\n                name: announce.name.clone(),\n                post_office: false,\n                account_id: announce.account_id(),\n                last_seen: now,\n          