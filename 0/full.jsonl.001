e,\n            })\n        }\n        SocketAddr::V6(target) => {\n            target.ip().is_unicast_link_local()\n                && target.scope_id() != 0\n                && interfaces\n                    .iter()\n                    .any(|iface| iface.address.is_ipv6() && iface.index == Some(target.scope_id()))\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    #[test]\n    fn subnet_and_interface_scope_rejects_overlay_and_routed_addresses() {\n        let interfaces = vec![\n            LanInterface {\n                address: \"192.168.10.5\".parse().unwrap(),\n                prefix: 24,\n                index: Some(3),\n            },\n            LanInterface {\n                address: \"fe80::1\".parse().unwrap(),\n                prefix: 64,\n                index: Some(3),\n            },\n        ];\n        assert!(permits(\n            &interfaces,\n            \"192.168.10.255:47474\".parse().unwrap()\n        ));\n        for addr in [\n            \"192.168.11.4:47474\",\n            \"100.64.1.2:47474\",\nMEASURE bootstrap {\"historyVerificationMs\":464,\"loginToUsableMs\":1562}\nMEASURE foreground start 1795407388.027760\nMEASURE foreground end 1795407718.034569\nMEASURE minimized start 1795407723.048885\nfixture-metadata.json\nfixture.log\n   Compiling mesh-talk-core v0.4.6 (D:\\MeshTalk\\REQ011\\windows-interface-integrated.XmGvuJIt\\source-clean\\crates\\mesh-talk-core)\n   Compiling mesh-talk v0.4.6 (D:\\MeshTalk\\REQ011\\windows-interface-integrated.XmGvuJIt\\source-clean\\src-tauri)\n   Compiling mesh-talk-integrations v0.4.6 (D:\\MeshTalk\\REQ011\\windows-interface-integrated.XmGvuJIt\\source-clean\\crates\\mesh-talk-integrations)\n","exit_code":0,"duration":{"secs":0,"nanos":9750}},"started_at_ms":1795407937358,"completed_at_ms":1795407937358}}
