nner.call_active = true;\n        inner.last_activity = Instant::now() - Duration::from_secs(120);\n        assert!(!due(&inner, &strict, true));\n        inner.call_active = false;\n        assert!(due(&inner, &strict, false));\n    }\n\n    #[test]\n    #[serde(default = \"default_ringtone\")]\n    pub ringtone: String,\n    #[serde(default)]\n    pub privacy_level: PrivacyLevel,\n    #[serde(default = \"default_true\")]\n    pub notification_preview: bool,\n    #[serde(default)]\n    pub auto_lock_seconds: u32,\n    #[serde(default)]\n    pub lock_when_hidden: bool,\n    #[serde(default)]\n    pub confirm_sensitive_copy: bool,\n    #[serde(default)]\n    pub clipboard_clear_seconds: u32,\n    /// Capture bindings remain local to this account on this device.\n    #[serde(default)]\n    pub screenshot_shortcuts: ScreenshotShortcuts,\n}\n\n/// The default ringtone id (the classic phone ring).\nfn default_ringtone() -> String {\n    \"classic\".to_string()\n}\n\n/// Default for both toggles (a messenger should run in the background and notify).\nfn default_true() -> bool {\n    true\n\nasync fn suspend_retired_for<R, F, G>(app: &tauri::AppHandle<R>, make_registry: F)\nwhere\n    R: Runtime,\n    F: FnOnce() -> G + Send + 'static,\n    G: Registry<Key = Shortcut> + Send + 'static,\n{\n    let state = app.state::<ScreenshotShortcutState>();\n    let snapshot = state.inner.lock().unwrap().clone();\n    if snapshot\n        .lease\n        .as_ref()\n        .is_some_and(|lease| !current(&app.state::<AppState>(), lease))\n        && let Err(error) = state\n            .suspend_with_registry(make_registry, snapshot.registration_id)\n            .await\n    {\n        log::warn!(\"Could not suspend screenshot shortcuts: {error}\");\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[cfg(target_os = \"linux\")]\n    #[test]\n    #[ignore = \"requires a dedicated X11 display\"]\n","exit_code":0,"duration":{"secs":0,"nanos":11375}},"started_at_ms":1795408887014,"completed_at_ms":1795408887015}}
