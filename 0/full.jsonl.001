hrough,\n                firstPull,\n              );\n              firstPull = false;\n              return page;\n            } catch (error) {\n              // The host may have reserved a page whose IPC reply was lost.\n              // No page was applied, so replace that reservation on retry.\n              firstPull = true;\n              throw error;\n            }\n          },\n          apply: (page) => {\n            receiptPending = true;\n            if (receiptCursor === null) {\n              // Establish recovery state before the first effects can touch\n              // older per-field persistence, including legacy rows without IDs.\n              saveReceptionSnapshot(scope, snapshot(page.after));\n              receiptCursor = page.after;\n              receiptDirty = false;\n            }\n            for (const receipt of page.receipts) {\n              switch (receipt.kind) {\n                case \"dm\":\n                  get_handleDm(set, get, receipt.event);\n                  break;\n                case \"channel\":\n                  get_handleChannel(set, get, receipt.event);\n                  break;\n                case \"file\":\n                  get_handleFile(set, get, receipt.event);\n                  break;\n                case \"profile\":\n                  applyChatProfile(receipt.event);\n                  break;\n                case \"call\":\n                  applyChatCallSignal(receipt.event);\n                  break;\n                case \"progress\":\n                  applyChatFileProgress(receipt.event);\n                  break;\n                case \"state\":\n                  for (const kind of receptionKinds(receipt.event))\n                    applyInvalidation(kind);\n                  break;\n              }\n            }\n            if (page.complete && !avatarIdentityLoaded) {\n              avatarIdentityLoaded = true;\n              finishChatAvatarIdentity(\n                () =>\n                  lease.current() &&\n                  get().deliveryRuntime === runtime &&\n                  get().myAccountId === scope.account_id &&\n                  get().myId === scope.device_id,\n              );\n            }\n          },\n      if (\n        state.ready !== previous.ready ||\n        state.bootBusy !== previous.bootBusy ||\n        state.bootFailed !== previous.bootFailed ||\n        state.groupOperations !== previous.groupOperations\n      )\n        scheduleControl();\n    });\n    const stopControlDemand = controlObservation.subscribe(scheduleControl);\n    scheduleControl();\n\n    const applyInvalidation = (rawKind: unknown) => {\n      const kind = receptionKinds({ kinds: [rawKind] })[0] ?? \"state\";\n      if (\n        kind === \"documents\" ||\n        kind === \"sync_status\" ||\n        kind === \"read_receipts\"\n      ) {\n        // Qualified producers changed no group/personal inputs. Existing auxiliary\n        // readers retain their broad compatibility wake without a chat-wide scan.\n        notifySyncInvalidation({\n          owner: lease.owner!,\n          kind: \"state\",\n          scope: kind,\n        });\n        return;\n      }\n      const rosterLease = kind === \"roster\" ? captureChat(get) : undefined;\n      const ticket =\n        kind === \"roster\"\nimport { invoke } from \"@tauri-apps/api/core\";\nimport type {\n  NodeStateChangedEvent,\n  CallSignalEvent,\n  ChannelMessageEvent,\n  DmReceivedEvent,\n  FileProgressEvent,\n  FileReceivedEvent,\n  ProfileReceivedEvent,\n  ReceptionCursor,\n  ReceptionPage,\n  ReceptionScope,\n} from \"../types\";\n\nexport type HostReception =\n  | { kind: \"dm\"; event: DmReceivedEvent }\n  | { kind: \"channel\"; event: ChannelMessageEvent }\n  | { kind: \"file\"; event: FileReceivedEvent }\n  | { kind: \"profile\"; event: ProfileReceivedEvent }\n  | { kind: \"call\"; event: CallSignalEvent }\n  | { kind: \"progress\"; event: FileProgressEvent }\n  | {\n      kind: \"state\";\n      event?: { kinds: ReceptionKind[] };\n    };\n\nexport type ReceptionKind = NodeStateChangedEvent[\"kind\"];\nconst RECEPTION_KINDS: readonly string[] = [\n  \"state\",\n  \"roster\",\n  \"delivery\",\n  \"files\",\n  \"documents\",\n  \"sync_status\",\n  \"read_receipts\",\n];\n\n/** Older hosts omit metadata; malformed or future domains need conservative repair. */\nexport function receptionKinds(event: unknown): ReceptionKind[] {\n  const kinds =\n    event && typeof event === \"object\" && \"kinds\" in event\n      ? event.kinds\n      : undefined;\n  if (\n    !Array.isArray(kinds) ||\n    kinds.length > RECEPTION_KINDS.length ||\n    !kinds.every(\n      (kind) => typeof kind === \"string\" && RECEPTION_KINDS.includes(kind),\n    )\n  )\n    return [\"state\"];\n  if (kinds.includes(\"state\")) return [\"state\"];\n  return [...new Set(kinds)] as ReceptionKind[];\n}\n\nexport const reception = {\n  pull: (\n    scope: ReceptionScope,\n    after: ReceptionCursor | null,\n    through: ReceptionCursor | null,\n    reset: boolean,\n  ) =>\n    invoke<ReceptionPage<HostReception>>(\"owner_reception_page\", {\n      scope,\n      after,\n      through,\n      reset,\n    }),\n  acknowledge: (scope: ReceptionScope, page: ReceptionPage<HostReception>) =>\n    invoke<boolean>(\"owner_reception_ack\", {\n      scope,\n      token: page.token,\n      after: page.after,\n      next: page.next,\n    }),\n};\nsrc-tauri/src/reception_host.rs:174:    State { kinds: Vec<&'static str> },\nsrc-tauri/src/reception_host.rs:347:        if !kinds.is_empty() { receipts.push(Receipt::State { kinds }); }\n","exit_code":0,"duration":{"secs":0,"nanos":11375}},"started_at_ms":1795416458876,"completed_at_ms":1795416458876}}
