;\n  }, [owner, generation, locked, callPhase]);\n\n  useEffect(() => {\n    if (!owner || locked) return;\n    const check = () => {\n      void refreshLock();\n    };\n    window.addEventListener(\"focus\", check);\n    document.addEventListener(\"visibilitychange\", check);\n    return () => {\n      window.removeEventListener(\"focus\", check);\n      document.removeEventListener(\"visibilitychange\", check);\n    };\n  }, [owner, generation, locked, refreshLock]);\n\n  useEffect(() => {\n    if (!owner || locked || autoLockSeconds === 0) return;\n    let timer: ReturnType<typeof setTimeout>;\n    const schedule = () => {\n      clearTimeout(timer);\n      timer = setTimeout(() => {\n        if (useCalls.getState().phase !== \"idle\") {\n          schedule();\n        } else {\n          void lock();\n        }\n      }, autoLockSeconds * 1000);\n    };\n    const onVisibility = () => {\n      if (\n        document.hidden &&\n        lockWhenHidden &&\n        useCalls.getState().phase === \"idle\"\n      ) {\n        void lock();\n      } else if (document.hidden) {\n        schedule();\n      } else {\n        void refreshLock();\n        schedule();\n      }\n    };\n    const onFocus = () => {\n      void refreshLock();\n      schedule();\n    };\n    schedule();\n    window.addEventListener(\"pointerdown\", schedule);\n    window.addEventListener(\"keydown\", schedule);\n    window.addEventListener(\"focus\", onFocus);\n    document.addEventListener(\"visibilitychange\", onVisibility);\n    return () => {\ndocs/event-driven-design.md:33:| Network availability and cost | The platform adapter observes network cost. A change may permit previously blocked work. | Reuse the [native network-cost observer](../src-tauri/src/network_cost/mod.rs). macOS uses native callbacks. Linux and Windows share a serial query owner with event-triggered repair and a sparse fallback. Protocol reconnect, discovery and recovery stay with their existing owners. |\ndocs/routed-network-discovery.md:28:startup, on **Connection → Rescan**, network/disclosure changes and optional\n 2349 19:33 ssh\n93190 21:26 python3\n","exit_code":0,"duration":{"secs":0,"nanos":28250}},"started_at_ms":1795409562343,"completed_at_ms":1795409562343}}
