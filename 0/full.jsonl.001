]\\n        mixed=[s['name'] for s in steps if s['phase']=='testCheckStep' and re.search(r'coverage|clippy|nextest|backend|native|rust|core|mutant',s['name'],re.I)]\\n        row=dict(runId=run['id'],source=run.get('head_sha'),workflow=run['name'],event=run['event'],attempt=run.get('run_attempt'),jobId=j['id'],job=j['name'],status=j['status'],conclusion=j.get('conclusion'),preJobDependencyDispatchSeconds=elapsed(run.get('created_at'),j.get('created_at')) if complete else None,jobQueueAdmissionSeconds=elapsed(j.get('created_at'),j.get('started_at')) if complete else None,runnerSeconds=elapsed(j.get('started_at'),j.get('completed_at')) if complete else None,steps=steps,mixedCompilationCheckSplitUnknown=mixed)\\n        for p in ('setupBuild','testCheckStep','reportCleanup','unknown'):\\n            row[p+'Seconds']=sum(s['seconds'] or 0 for s in steps if s['phase']==p) if complete else None\\n        rows.append(row)\\nout=dict(method='Job created→started is queue/admission, not solely runner scarcity; run created→job created retained as pre-job dependency/dispatch. Completed step names classify setup/build, test/check step wall time, report/cleanup and unknown. Strip Run prefix; npm ci and real React portable workflows included. Mixed compile/check steps remain explicitly unsplit; pure execution needs native logs. Skipped/cancelled/incomplete durations unknown. Includes same-source full-DAG source/attempt and descriptive mixed-history records.',runs=len(runs),jobs=rows)\\nPath(sys.argv[2]).write_text(json.dumps(out,indent=2)+'\\\\n')\\nprint(f\\\"Classified {len(rows)} jobs from {len(runs)} runs\\\")\\nrunner min 632.3333333333334\\nattempts [('UI E2E', 1, {'success': 30, 'failure': 0, 'skipped': 1, 'incomplete': 0, 'other': 0}), ('Scorecard', 1, {'success': 1, 'failure': 0, 'skipped': 0, 'incomplete': 0, 'other': 0}), ('CI', 1, {'success': 20, 'failure': 0, 'skipped': 0, 'incomplete': 0, 'other': 0}), ('Mutation Testing', 1, {'success': 2, 'failure': 0, 'skipped': 3