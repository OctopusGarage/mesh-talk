e_interface_snapshot(&mut previous, interface_snapshot());\n        if changed || last_rejoin.elapsed() >= REJOIN_INTERVAL {\n            join_discovery_group_all_ifaces(&socket);\n            last_rejoin = Instant::now();\n crates/mesh-talk-core/src/discovery/mod.rs     |   8 +\n crates/mesh-talk-core/src/discovery/roster.rs  |   6 +-\n crates/mesh-talk-core/src/discovery/service.rs | 212 ++++++++++++++++++++-----\n 3 files changed, 186 insertions(+), 40 deletions(-)\n","exit_code":0,"duration":{"secs":0,"nanos":12667}},"started_at_ms":1795415759135,"completed_at_ms":1795415759136}}
