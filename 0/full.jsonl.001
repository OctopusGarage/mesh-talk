 references\\\\n'\np.write_text(s.replace(n,n+'''\nThe search dialog admits one native query at a time. While it runs, a\nnew debounced query replaces the pending query. Closing the dialog or\nretiring its owner discards pending work. A completed query can publish\nresults only while its exact input and owner remain current.\n''',1))\np=Path('frontend/validation.json')\ns=p.read_text()\nat=s.index('          {\\\\n            \"name\": \"Duplicate text and timestamps')\ns=s[:at]+'''          {\n            \"name\": \"One admitted native search owns its full lifetime. Only the latest debounced query can wait, and closing or retiring the dialog discards the pending query and rejects stale results.\",\n            \"reference\": \"docs/ARCHITECTURE.md#recent-search-references\"\n          },\n'''+s[at:]\np.write_text(s)\nPY\nmake standards-check \u0026\u0026 git diff --check\ncd frontend \u0026\u0026 npm run e2e -- e2e/chat.spec.ts --grep 'search' \u003e../tmp/req-011/search-backpressure-browser.log 2\u003e\u00261`,yield_time_ms:1000}))\n","internal_chat_message_metadata_passthrough":{"create_time":1795406721.3879273,"turn_id":"01a20691-6d63-7020-b3f3-af8984c725f3"},"name":"exec","status":"completed","type":"custom_tool_call"},{"call_id":"call_b74ca67cd95b4672af01c46faa071a39","guardian_metadata":{"client_authored":false,"fallback_token_limit_override":12000,"history_sequence":14310,"model_search_state":"unused","sampled_through_sequence":14308},"id":"ctco_01a20694-8c85-79d3-b7db-87e1aaa6be7b","internal_chat_message_metadata_passthrough":{"create_time":1795406728.325764,"turn_id":"01a20691-6d63-7020-b3f3-af8984c725f3"},"output":[{"text":"Script completed\nWall time 1.3 seconds\nOutput:\n","type":"input_text"},{"text":"{\"chunk_id\":\"d86848\",\"wall_time_seconds\":1.002525,\"session_id\":82987,\"original_token_count\":10,\"output\":\"node scripts/validation/standards.mjs\\n\"}","type":"input_text"}],"type":"custom_tool_call_output"},{"encrypted_content":"REDACTED","gu