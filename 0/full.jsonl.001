_deadlines(true)\n            .map(|(removed, _)| removed)\n    }\n\n    fn prune_received_deadlines(&self, restart: bool) -> Result<(usize, bool), NodeError> {\n        let own_account = self.account_id();\n        let own_devices: std::collections::HashSet<_> = self\n            .linked_devices()\n            .into_iter()\n            .map(|device| device.public.user_id())\n            .collect();\n        let inputs = ReceivedExpiryInputs {\n            received: self.received.lock().expect(\"received mutex\").revision(),\n            files: self.received_files.lock().expect(\"files mutex\").revision(),\n            account: own_account.clone(),\n            linked_devices: own_devices.len(),\n        };\n        let scan = restart\n            || !self\n                .received_expiry_schedule\n                .lock()\n                .expect(\"expiry schedule mutex\")\n                .as_ref()\n                .is_some_and(|schedule| schedule.quiet(&inputs, self.expiry_now()));\n        let mut schedule = ReceivedExpirySchedule {\n            inputs,\n            wall: None,\n            monotonic: None,\n        };\n        let mut removed = 0;\n        for file in [false, true].into_iter().filter(|_| scan) {\n            let mut after = None;\n            loop {\n                let page = if file {\n                    self.received_files\n                        .lock()\n                        .expect(\"files mutex\")\n                        .deadline_page(None, after, 128)?\n                } else {\n                    self.received\n                        .lock()\n                        .expect(\"received mutex\")\n                        .deadline_page(None, after, 128)?\n                };\n                if page.is_empty() {\n                    break;\n        let mut pending_deadlines = false;\n        {\n            let delivery = self.delivery.lock().expect(\"delivery lock not poisoned\");\n            for transaction in delivery.pending_transactions() {\n                if let Some((message, deadline, account)) = transaction.outgoing_expiry() {\n                    if deadline <= self.expiry_now() {\n                        targets.push((\n                            message.conversation,\n                            message.logical_id,\n                            account,\n                            message.logical_id,\n                        ));\n                    } else {\n                        pending_deadlines = true;\n                    }\n                }\n            }\n        }\n        let mut seen = std::collections::HashSet::new();\n        targets.retain(|target| seen.insert(*target));\n        for (conv, id, account, event_id) in targets {\n            removed += self.delete_message(conv, id, account)?;\n            self.expiry_first_seen\n                .lock()\n                .expect(\"expiry mutex not poisoned\")\n                .remove(&event_id);\n        }\n        if removed > 0 {\n            self.note_account_history_change();\n        }\n        let mut received_schedule = self\n            .received_expiry_schedule\n            .lock()\n            .expect(\"expiry schedule mutex\");\n        if scan {\n            // Stamp the inputs read BEFORE scanning. Concurrent appends or\n            // authority changes then force another pass rather than being\n            // certified by work that may not have visited them. Errors above\n            // retain the previous schedule and remain retryable.\n            *received_schedule = Some(schedule);\n        }\n        let received_deadlines = received_schedule\n            .as_ref()\n            .is_none_or(|entry| entry.wall.is_some());\n        drop(received_schedule);\n        let has_deadlines = received_deadlines\n            || pending_deadlines\n            || self.sentlog.lock().expect(\"sent mutex\").has_deadlines()?;\n        Ok((removed, has_deadlines))\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    pub(in crate::node) fn contains(\n        &self,\n        conversation: Option<&ConversationId>,\n        key: &[u8],\n    ) -> Result<bool, LogError> {\n        self.profile\n            .database()\n            .read(|c| Ok(Self::find_header_on(c, self.kind, conversation, key)?.is_some()))\n    }\n    pub(in crate::node) fn lookup_logical(\n        &self,\n        conversation: &ConversationId,\n        id: EventId,\n    ) -> Result<Option<StoredRow>, LogError> {\n        self.profile.database().read(|c| {\n            let mut statement=c.prepare(&format!(\"SELECT {HEADER_COLUMNS} FROM transcript_rows WHERE kind=?1 AND conversation=?2 AND logical_id=?3 ORDER BY ordinal LIMIT 1\"))?;\n            let mut rows=statement.query(params![self.kind,conversation.as_bytes().as_slice(),id.as_bytes().as_slice()])?;\n            let h=rows.next()?.map(header).transpose()?;\n            h.map(|h|self.load_on(c,h)).transpose()\n        })\n    }\n    pub(in crate::node) fn has_deadlines(&self) -> Result<bool, LogError> {\n        self.profile.database().read(|c| {\n            Ok(c.query_row(\n                \"SELECT EXISTS(SELECT 1 FROM transcript_rows WHERE kind=?1 AND deadline IS NOT NULL)\",\n                [self.kind],\n                |row| row.get(0),\n            )?)\n        })\n    }\n\n    /// Before=None is the conservative recipient restart selection. The caller\n    /// classifies sender identity without opening any non-expiring payload.\n    pub(in crate::node) fn deadline_page(\n        &self,\n        before: Option<u64>,\n        after: Option<TranscriptDeadlineCursor>,\n        limit: usize,\ncrates/mesh-talk-core/src/node/favorites.rs:161:    next_expiry: Option<u64>,\ncrates/mesh-talk-core/src/node/favorites/collection.rs:489:            && prior.next_expiry.is_none_or(|deadline| now < deadline)\ncrates/mesh-talk-core/src/node/favorites/collection.rs:491:            return Ok(prior.next_expiry.is_some());\ncrates/mesh-talk-core/src/node/favorites/collection.rs:501:            let next_expiry = store\ncrates/mesh-talk-core/src/node/favorites/collection.rs:512:                next_expiry,\ncrates/mesh-talk-core/src/node/favorites/collection.rs:518:            .is_none_or(|prior| prior.next_expiry.is_some()))\ncrates/mesh-talk-core/src/node/transcript_repository/metadata.rs:178:                let row=rows.next()?.ok_or_else(||invalid(\"deadline metadata disappeared\"))?;\n","exit_code":0,"duration":{"secs":0,"nanos":11916}},"started_at_ms":1795416192669,"completed_at_ms":1795416192669}}
