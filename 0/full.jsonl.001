    .with_runtime(|runtime| {\n            Ok(NodeIdentity {\n                owner,\n                device_id: runtime.user_id().into(),\n                account_id: runtime.account_id().into(),\n                display_name: runtime.display_name(),\n                history_revision: runtime.account_history_revision(),\n                supports_push_state: true,\n                supports_bounded_delivery: runtime.handle().bounded_delivery(),\n                runtime_id: node.installed_runtime_id(admission.lease())?,\n            })\n        })\n        .await\n}\n\n#[derive(Serialize)]\npub struct RosterObservation {\n    identity: NodeIdentity,\n    peers: Vec<crate::chat_commands::PeerInfo>,\n    people: std::collections::HashMap<String, crate::chat_commands::PresenceInfo>,\n}\n\n/// One authorized discovery read; group metadata and bodies have separate owners.\n#[tauri::command]\npub async fn owner_roster_observation(\n    owner: String,\n    app: tauri::State<'_, AppState>,\n                return Err(CommandError::not_started());\n            }\n            response.map(ConditionalPresence::Full)\n        })\n        .await\n}\n\n/// Observe authenticated startup identity without admitting node operations.\n#[tauri::command]\npub fn owner_startup_identity(\n    owner: String,\n    app: tauri::State<'_, AppState>,\n    node: tauri::State<'_, NodeState>,\n) -> Result<Option<crate::chat_commands::StartupIdentity>, CommandError> {\n    let admission = RuntimeAdmission::capture(&app, &node, &owner)?;\n    node.startup_identity(app.session(), admission.lease(), app.app_lock())\n}\n\n#[tauri::command]\npub async fn owner_enqueue_text(\n    owner: String,\n    account: String,\n    text: String,\n    reply_to: Option<String>,\n    expires_at_ms: Option<u64>,\n    protection: Option<mesh_talk_core::node::MessageProtection>,\n    app: tauri::State<'_, AppState>,\n    node: tauri::State<'_, NodeState>,\n) -> Result<String, CommandError> {\n    let started = std::time::Instant::now();\n    let admission = RuntimeAdmission::capture(&app, &node, &owner)?;\n      });\n    }\n    if (lease.current()) await get().loadFavorites();\n  },\n\n  // Re-attempt the node-id poll after a boot failure (events + roster interval from the\n  // original start() are still live, so we only need to re-resolve my_id/account_id).\n  retryBoot: (background = false) => {\n    const lease = captureChat(get, false);\n    const set = guardedSet(rawSet, lease.current);\n    if (!lease.current()) return;\n    if (get().bootBusy) return;\n    const request = get().bootRequest + 1;\n    set({\n      bootFailed: background && get().bootFailed,\n      ready: false,\n      bootBusy: true,\n      bootRequest: request,\n    });\n    void (async () => {\n      // Stop UI continuation when the captured owner/run or boot request is superseded.\n      const ok = await pollUntilReady(\n        set,\n        get,\n        () => !lease.current() || get().bootRequest !== request,\n        background,\n      );\n      if (ok && lease.current() && get().bootRequest === request)\n        void get().loadFavorites();\n      if (get().bootRequest === request)\n        set({ bootBusy: false, bootFailed: !ok });\n    })();\n  },\n\n  saveFile: async (fileConv, dest) => {\n    const lease = captureChat(get);\n    const set = guardedSet(rawSet, lease.current);\n    if (!lease.current()) return;\n    try {\n      const path = await saveAttachment({ fileConv, name: \"\" }, lease, {\n        mode: \"as\",\n        destination: dest,\n      });\n      if (path && lease.current()) get().dismissFile(fileConv);\n    } catch (e) {\n      set({ error: `Couldn't save file: ${errorMessage(e)}` });\n    }\n  },\n\n  dismissFile: (fileConv) => {\n    notifyIncomingFileDismissed(fileConv);\n    rawSet((s) => ({\n      incomingFiles: s.incomingFiles.filter((f) => f.fileConv !== fileConv),\n    }));\n  },\n\n  start: () => {\n    resetOutgoingMediaPreviews();\n    rawSet((s) => ({ runEpoch: s.runEpoch