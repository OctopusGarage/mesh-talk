{"timestamp":"2026-11-23T07:43:51.942Z","ordinal":40542,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1feaf-24d9-7612-a284-664abd64a2c4","turn_id":"01a2075b-e4e9-7ff1-a860-bc3e842d0fb3","item":{"type":"CommandExecution","id":"exec-24b71c48-252f-4311-891d-bc1f08fa7c72","process_id":"28916","command":["/bin/zsh","-lc","sed -n '865,926p' crates/mesh-talk-core/src/node/channels.rs; sed -n '370,472p' crates/mesh-talk-core/src/node/channel_account_maintenance.rs"],"cwd":"file:///Users/kingsonwu/programming/OctopusGarage/mesh-talk","parsed_cmd":[{"type":"read","cmd":"sed -n '865,926p' crates/mesh-talk-core/src/node/channels.rs","name":"channels.rs","path":"crates/mesh-talk-core/src/node/channels.rs"},{"type":"read","cmd":"sed -n '370,472p' crates/mesh-talk-core/src/node/channel_account_maintenance.rs","name":"channel_account_maintenance.rs","path":"crates/mesh-talk-core/src/node/channel_account_maintenance.rs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"            _ = custody => {}\n        }\n    }\n\n    async fn run_account_channel_maintenance_loop(self: Arc<Self>, periodic: bool) {\n        let mut work = super::channel_account_maintenance::ChannelAccountMaintenance::default();\n        // These subscriptions do not consume the local recovery/roster Notify\n        // permits. The existing maintenance state survives every local wake.\n        let mut metadata = self.subscribe_channel_changes();\n        let mut network = self.network_changes.subscribe();\n        let mut ui = self.subscribe_ui_changes();\n        let mut documents = self.account_document_updates.subscribe();\n        let mut roster = self.subscribe_roster_changes();\n        let mut availability = self.subscribe_sibling_availability();\n        loop {\n            let periodic_wake = tokio::select! {\n                _ = tokio::time::sleep_until(tokio::time::Instant::from_std(work.deadline())),\n                    if self.channel_recovery_periodic_enabled(periodic) => true,\n                change = availability.changed() => { if change.is_err() { return; } false },\n                change = ui.changed() => { if change.is_err() { return; } false },\n                change = documents.changed() => { if change.is_err() { return; } false },\n                change = roster.changed() => { if change.is_err() { return; } false },\n                change = metadata.recv() => match change {\n                    Ok(_) | Err(tokio::sync::broadcast::error::RecvError::Lagged(_)) => false,\n                    Err(tokio::sync::broadcast::error::RecvError::Closed) => return,\n                },\n                change = network.changed() => {\n                    if change.is_err() { return; }\n                    false\n                },\n            };\n            // The test policy can change while the selected timer is pending.\n            if periodic_wake && !self.channel_recovery_periodic_enabled(periodic) {\n                continue;\n            }\n            #[cfg(test)]\n            if periodic_wake {\n                self.trace_account_client(&self.identity.public(), || {\n                    \"channel_recovery_maintenance_periodic_begin\".into()\n                });\n            }\n            #[cfg(test)]\n            self.trace_account_client(&self.identity.public(), || {\n                \"channel_recovery_maintenance_begin\".into()\n            });\n            self.maintain_account_channels_after_wake(\n                &mut work,\n                self.channel_recovery_periodic_enabled(periodic),\n            )\n            .await;\n            #[cfg(test)]\n            self.trace_account_client(&self.identity.public(), || {\n                \"channel_recovery_maintenance_done\".into()\n            });\n            tokio::task::yield_now().await;\n        }\n    }\n\n    fn note_local_channel_recovery_input(&self) {\n        self.note_channel_plaintext_recovery_input();\n        self.note_group_metadata_recovery_input();\n        self.note_join_history_recovery_input();\n    fn legacy_owner_root(\n        &self,\n        channel: ConversationId,\n    ) -> Result<Option<crate::eventlog::EventId>, LogError> {\n        let projection = self.account_group_projection(channel)?;\n        if projection.authority.current_event().is_some()\n            || projection\n                .state\n                .as_ref()\n                .is_none_or(|state| state.is_dissolved() || state.owner() != self.user_id())\n        {\n            return Ok(None);\n        }\n        Ok(projection\n            .accepted\n            .iter()\n            .find(|member| member.public == self.identity.public())\n            .map(|member| member.membership_event))\n    }\n    /// One peer turn and one local channel turn; the existing recovery task owns all state.\n    pub(super) async fn maintain_account_channels_after_wake(\n        self: &Arc<Self>,\n        work: &mut ChannelAccountMaintenance,\n        timed_recovery: bool,\n    ) {\n        // An incomplete cycle is not a successful acknowledgment, but its\n        // unchanged notifications must still respect the owner's retry wait.\n        // Explicit drivers and event-only recovery have no timer to advance\n        // retained work, so their existing progress contract stays independent.\n        if timed_recovery && Instant::now() < work.deadline() {\n            let input = work.input(self).await.ok();\n            if input.is_some() && input == work.observed_input {\n                return;\n            }\n        }\n        self.maintain_account_channels(work).await;\n    }\n\n    pub(super) async fn maintain_account_channels(\n        self: &Arc<Self>,\n        work: &mut ChannelAccountMaintenance,\n    ) {\n        let selected_input = work.input(self).await.ok();\n        if selected_input.is_some()\n            && work.input == selected_input\n            && Instant::now() < work.deadline()\n        {\n            return;\n        }\n        // New semantic inputs invalidate successful inventory comparisons, but\n        // ordinary notifications and independent changes never erase failures.\n        if selected_input.is_some()\n            && work.observed_input.is_some()\n            && work.observed_input != selected_input\n        {\n            let now = Instant::now();\n            for value in work.peers.values_mut().filter(|value| value.supported) {\n                if !value.poll_failed {\n                    value.poll_at = now;\n                }\n                if !value.binding_failed {\n                    value.binding_poll_at = now;\n                }\n            }\n        }\n        if selected_input.is_some() {\n            work.observed_input = selected_input;\n        }\n        // Capture before work. Mutations during this turn remain dirty.\n        let mut cycle_complete = false;\n        let result: Result<(), NodeError> = async {\n            #[cfg(test)]\n            {\n                work.eligibility_reads += 1;\n            }\n            let mut peers = self.routing_peers();\n            // Capability maintenance serves existing group relationships and siblings,\n            // not every discovery entry. Unrelated probes compete with ordinary DMs\n            // and must not initiate a pull connection before contact authorization.\n            let mut selected = Vec::new();\n            for peer in peers {\n                if !peer.post_office\n                    && (peer.account_id.as_deref() == Some(self.account_id().as_str())\n                        || self.group_member(&peer.public)?\n                        || self.group_departure_peer(&peer.public))\n                {\n                    selected.push(peer);\n                }\n            }\n            peers = selected;\n            work.peers\n                .retain(|_, value| peers.iter().any(|peer| peer.public == value.public));\n            peers.sort_unstable_by_key(|peer| peer.public.user_id());\n            // Seed only cheap bounded metadata for every admitted candidate;\n            // an unvisited new peer must retain its initial probe deadline.\n            let generation = self.privacy.generation.load(Ordering::Acquire);\n            for peer in &peers {\n                work.capability(peer, generation);\n            }\n            if !peers.is_empty() {\n                let peer = &peers[work.peer_cursor % peers.len()];\n                work.peer_cursor = work.peer_cursor.wrapping_add(1);\n                let value = work.capability(peer, self.privacy.generation.load(Ordering::Acquire));\n","exit_code":0,"duration":{"secs":0,"nanos":18125}},"started_at_ms":1795419831942,"completed_at_ms":1795419831942}}
