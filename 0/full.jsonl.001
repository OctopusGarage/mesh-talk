       except subprocess.TimeoutExpired:\n            process.kill()\n            process.wait()\n            raise\n    if process.returncode != 0:\n        raise RuntimeError(f\"relay exit {process.returncode}\")\n\ndef cli(*arguments):\n    subprocess.run([BIN, \"network\", *arguments], check=True, stdout=subprocess.DEVNULL)\n\ndef wait_replica(first, second, log):\n    deadline = time.monotonic() + 180\n    while time.monotonic() < deadline:\n        if first.poll() is not None or second.poll() is not None:\n            raise RuntimeError(\"relay exited during federation\")\n        observed = re.findall(r\"^relay_storage retained_count=(\\d+) \", log.read_text(), re.M)\n        if observed and int(observed[-1]) == EXPECTED:\n            return int(observed[-1])\n        time.sleep(1)\n    raise RuntimeError(\"second relay did not reach the expected retained count\")\n\nwith tempfile.TemporaryDirectory(prefix=\"mesh-federation-eval-\") as temp:\n    root = Path(temp)\n    profiles = [root / \"source\", root / \"replica\"]\n    shutil.copytree(\"/fixture\", profiles[0])\n    profiles[1].mkdir()\n    for profile in profiles:\n        password = profile / \"password\"\n        password.touch(mode=0o600)\n        password.write_text(\"synthetic-post-office-benchmark\\n\")\n    # Bootstrap the local identities and read their actual public fingerprints.\n    ids = []\n    for i, profile in enumerate(profiles):\n        proc, _, log = launch(profile, f\"identity-{i}\", port())\n        try:\n            ids.append(re.search(r\"^post-office ([a-f0-9]{32}) listening\", log.read_text(), re.M)[1])\n        finally:\n            stop(proc)\n    assert ids[0] != ids[1]\n    policy = root / \"network.policy\"\n    authority = root / \"authority.key\"\n    cli(\"init\", \"--authority-key\", authority, \"--policy\", policy)\n    ports = [port(), port()]\n    assert ports[0] != ports[1]\n    address = socket.gethostbyname(socket.gethostname())\n    configurations = []\n    for i, profile in enumerate(profiles):\n        membership = profile / \"membership\"\n        cli(\"enroll\", \"--authority-key\", authority, \"--policy\", policy,\n            \"--device\", ids[i], \"--membership\", membership, \"--valid-days\", \"1\")\n        j = 1 - i\n        configurations.append([\"--relay-network\", policy, \"--relay-membership\", membership,\n                               \"--relay-seed\", f\"{ids[j]}@{address}:{ports[j]}\"])\n    convergence = []\n    try:\n        for i, profile in enumerate(profiles):\n            convergence.append(launch(profile, f\"convergence-{i}\", ports[i],\n                                      configurations[i], observation=True))\n        retained = wait_replica(convergence[0][0], convergence[1][0], convergence[1][2])\n        (OUT / \"replica-witness.json\").write_text(json.dumps({\"retainedEvents\": retained}) + \"\\n\")\n    finally:\n        for proc, _, _ in reversed(convergence):\n            stop(proc)\n    production = []\n    try:\n        for i, profile in enumerate(profiles):\n            production.append(launch(profile, f\"production-{i}\", ports[i], configurations[i]))\n        time.sleep(30)\n        started = time.monotonic()\n        first = [snapshot(proc) for proc, _, _ in production]\n        peak = [sample[1] for sample in first]\n        for i in range(1, 101):\n            time.sleep(max(0, started + i * 3 - time.monotonic()))\n            current = [snapshot(proc) for proc, _, _ in production]\n            peak = [max(peak[j], values[1]) for j, values in enumerate(current)]\n        elapsed = time.monotonic() - started\n        ticks = os.sysconf(\"SC_CLK_TCK\")\n        report = {\n            \"binarySha256\": hashlib.file_digest(BIN.open(\"rb\"), \"sha256\").hexdigest(),\n            \"topology\": \"two approved relays with signed routed discovery seeds\",\n            \"seconds\": elapsed, \"replicaWitnessEvents\": retained,\n            \"processes\": [\n                {\"startupSeconds\": production[i][1],\n                 \"cpuPercentOneCore\": 100 * (row[0] - first[i][0]) / ticks / elapsed,\n                 \"privateResidentKiB\": peak[i], \"writeBytes\": row[2] - first[i][2]}\n                for i, row in enumerate(current)\n            ],\n        }\n        (OUT / \"summary-300s.json\").write_text(json.dumps(report, indent=2) + \"\\n\")\n    finally:\n        for proc, _, _ in reversed(production):\n            stop(proc)\n    shutil.copytree(profiles[1], OUT / \"verified-replica\")\nPY\npython3 -m py_compile \"$out/measure-pair.py\"\ntail -8 tmp/req-011/reception-wake-green-host.log\ndate +%s"],"cwd":"file:///Users/kingsonwu/programming/OctopusGarage/mesh-talk","parsed_cmd":[{"type":"unknown","cmd":"set -e\nout=$(cat tmp/req-011/linux-relay-federated-path)\ncat >\"$out/measure-pair.py\" <<'PY'\n\"\"\"Measure two isolated production relays after a witnessed exchange.\"\"\"\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport shutil\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport time\n\nsys.path.insert(0, \"/benchmark\")\nfrom resource_benchmark import snapshot, wait_ready\n\nBIN = Path(\"/binary\")\nOUT = Path(\"/evidence\")\nEXPECTED = 1000\n\ndef port():\n    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:\n        sock.bind((\"\", 0))\n        return sock.getsockname()[1]\n\ndef launch(profile, label, udp, network=(), observation=False):\n    env = os.environ.copy()\n    if observation:\n        env[\"MESH_TALK_TRACE_WORK\"] = \"1\"\n    else:\n        env.pop(\"MESH_TALK_TRACE_WORK\", None)\n    arguments = [\n        BIN, \"--post-office\", \"--port\", \"0\", \"--discovery-port\", str(udp),\n        \"--keystore\", profile / \"identity.keystore\", \"--password-file\",\n        profile / \"password\", \"--name\", label, *network,\n    ]\n    log = OUT / f\"{label}.log\"\n    with log.open(\"wb\") as sink:\n        process = subprocess.Popen(arguments, stdin=subprocess.DEVNULL, stdout=sink,\n                                   stderr=subprocess.STDOUT, env=env)\n    try:\n        startup = wait_ready(process, log, 90)\n        return process, startup, log\n    except BaseException:\n        stop(process)\n        raise\n\ndef stop(process):\n    if process.poll() is None:\n        process.terminate()\n        try:\n            process.wait(timeout=15)\n        except subprocess.TimeoutExpired:\n            process.kill()\n            process.wait()\n            raise\n    if process.returncode != 0:\n        raise RuntimeError(f\"relay exit {process.returncode}\")\n\ndef cli(*arguments):\n    subprocess.run([BIN, \"network\", *arguments], check=True, stdout=subprocess.DEVNULL)\n\ndef wait_replica(first, second, log):\n    deadline = time.monotonic() + 180\n    while time.monotonic() < deadline:\n        if first.poll() is not None or second.poll() is not None:\n            raise RuntimeError(\"relay exited during federation\")\n        observed = re.findall(r\"^relay_storage retained_count=(\\d+) \", log.read_text(), re.M)\n        if observed and int(observed[-1]) == EXPECTED:\n            return int(observed[-1])\n        time.sleep(1)\n    raise RuntimeError(\"second relay did not reach the expected retained count\")\n\nwith tempfile.TemporaryDirectory(prefix=\"mesh-federation-eval-\") as temp:\n    root = Path(temp)\n    profiles = [root / \"source\", root / \"replica\"]\n    shutil.copytree(\"/fixture\", profiles[0])\n    profiles[1].mkdir()\n    for profile in profiles:\n        password = profile / \"password\"\n        password.touch(mode=0o600)\n        password.write_text(\"synthetic-post-office-benchmark\\n\")\n    # Bootstrap the local identities and read their actual public fingerprints.\n    ids = []\n    for i, profile in enumerate(profiles):\n        proc, _, log = launch(profile, f\"identity-{i}\", port())\n        try:\n            ids.append(re.search(r\"^post-office ([a-f0-9]{32}) listening\", log.read_text(), re.M)[1])\n        finally:\n            stop(proc)\n    assert ids[0] != ids[1]\n    policy = root / \"network.policy\"\n    authority = root / \"authority.key\"\n    cli(\"init\", \"--authority-key\", authority, \"--policy\", policy)\n    ports = [port(), port()]\n    assert ports[0] != ports[1]\n    address = socket.gethostbyname(socket.gethostname())\n    configurations = []\n    for i, profile in enumerate(profiles):\n        membership = profile / \"membership\"\n        cli(\"enroll\", \"--authority-key\", authority, \"--policy\", policy,\n            \"--device\", ids[i], \"--membership\", membership, \"--valid-days\", \"1\")\n        j = 1 - i\n        configurations.append([\"--relay-network\", policy, \"--relay-membership\", membership,\n                               \"--relay-seed\", f\"{ids[j]}@{address}:{ports[j]}\"])\n    convergence = []\n    try:\n        for i, profile in enumerate(profiles):\n            convergence.append(launch(profile, f\"convergence-{i}\", ports[i],\n                                      configurations[i], observation=True))\n        retained = wait_replica(convergence[0][0], convergence[1][0], convergence[1][2])\n        (OUT / \"replica-witness.json\").write_text(json.dumps({\"retainedEvents\": retained}) + \"\\n\")\n    finally:\n        for proc, _, _ in reversed(convergence):\n            stop(proc)\n    production = []\n    try:\n        for i, profile in enumerate(profiles):\n            production.append(launch(profile, f\"production-{i}\", ports[i], configurations[i]))\n        time.sleep(30)\n        started = time.monotonic()\n        first = [snapshot(proc) for proc, _, _ in production]\n        peak = [sample[1] for sample in first]\n        for i in range(1, 101):\n            time.sleep(max(0, started + i * 3 - time.monotonic()))\n            current = [snapshot(proc) for proc, _, _ in production]\n            peak = [max(peak[j], values[1]) for j, values in enumerate(current)]\n        elapsed = time.monotonic() - started\n        ticks = os.sysconf(\"SC_CLK_TCK\")\n        report = {\n            \"binarySha256\": hashlib.file_digest(BIN.open(\"rb\"), \"sha256\").hexdigest(),\n            \"topology\": \"two approved relays with signed routed discovery seeds\",\n            \"seconds\": elapsed, \"replicaWitnessEvents\": retained,\n            \"processes\": [\n                {\"startupSeconds\": production[i][1],\n                 \"cpuPercentOneCore\": 100 * (row[0] - first[i][0]) / ticks / elapsed,\n                 \"privateResidentKiB\": peak[i], \"writeBytes\": row[2] - first[i][2]}\n                for i, row in enumerate(current)\n            ],\n        }\n        (OUT / \"summary-300s.json\").write_text(json.dumps(report, indent=2) + \"\\n\")\n    finally:\n        for proc, _, _ in reversed(production):\n            stop(proc)\n    shutil.copytree(profiles[1], OUT / \"verified-replica\")\nPY\npython3 -m py_compile \"$out/measure-pair.py\"\ntail -8 tmp/req-011/reception-wake-green-host.log\ndate +%s"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    Blocking waiting for file lock on build directory\n   Compiling mesh-talk-core v0.4.6 (/Users/kingsonwu/programming/OctopusGarage/mesh-talk/crates/mesh-talk-core)\n   Compiling mesh-talk-integrations v0.4.6 (/Users/kingsonwu/programming/OctopusGarage/mesh-talk/crates/mesh-talk-integrations)\n1795417556\n","exit_code":0,"duration":{"secs":0,"nanos":12000}},"started_at_ms":1795417556760,"completed_at_ms":1795417556761}}
