tps?:\\/\\/tauri\\.localhost(?:\\/|$)/.test(url));\n  } catch {}\n  if (!target) await wait(500);\n}\nif (!target) throw new Error(\"Isolated WebView2 page did not register\");\nconst url = new URL(target.webSocketDebuggerUrl);\nurl.hostname = '127.0.0.1';\nurl.port = port;\nconst socket = new WebSocket(url);\nawait new Promise((resolve, reject) => {\n  socket.addEventListener(\"open\", resolve, { once: true });\n  socket.addEventListener(\"error\", reject, { once: true });\n  signal.addEventListener(\"abort\", reject, { once: true });\n});\nlet sequence = 0;\nconst pending = new Map();\nsocket.addEventListener(\"message\", ({ data }) => {\n  const response = JSON.parse(data);\n  const operation = pending.get(response.id);\n  if (!operation) return;\n  pending.delete(response.id);\n  if (response.error) operation.reject(new Error(response.error.message));\n  else operation.resolve(response.result);\n});\nfunction call(method, params = {}) {\n  const id = ++sequence;\n  return Promise.race([\n    new Promise((resolve, reject) => {\n      pending.set(id, { resolve, reject });\n      socket.send(JSON.stringify({ id, method, params }));\n    }),\n    new Promise((_, reject) => signal.addEventListener(\"abort\", reject, { once: true })),\n  ]);\n}\nconst evaluate = async (expression) => {\n  const reply = await call(\"Runtime.evaluate\", { expression, returnByValue: true, awaitPromise: true });\n  if (reply.exceptionDetails) throw new Error(reply.exceptionDetails.exception?.description ?? String(reply.exceptionDetails.exception?.value ?? reply.exceptionDetails.text));\n  return reply.result.value;\n};\nconst until = async (expression, description, timeout = 15000) => {\n  const stop = Date.now() + timeout;\n  while (!signal.aborted && Date.now() < stop) {\n    if (await evaluate(expression)) return;\n    await wait(150);\n  }\n  throw new Error(description);\n};\nconst metrics = async () => Object.fromEntries(\n  (await call(\"Performance.getMetrics\")).metrics.map(({ name, value }) => [name, value]),\n);\n\ntry {\n  await until(\"Boolean(document.querySelector('[data-testid=chat-shell] main.conversation-canvas'))\", \"Native chat never became ready\", 40000);\n  await call(\"Performance.enable\");\n  await evaluate(`(() => {\n    const original = window.fetch;\n    window.__idleIpcTrace = [];\n    window.fetch = function(input, ...args) {\n      const url = typeof input === \"string\" ? input : input?.url;\n      if (url?.startsWith(\"http://ipc.localhost/\") || url?.startsWith(\"https://ipc.localhost/\"))\n        window.__idleIpcTrace.push({ at: Date.now(), command: new URL(url).pathname });\n      return Reflect.apply(original, this, [input, ...args]);\n    };\n    return true;\n  })()`);\n  const observations = [];\n  for (let i = 0; i < 18; i++) {\n    observations.push({\n      at: Date.now(),\n      metrics: await metrics(),\n      dom: await evaluate(`({\n        visible: document.visibilityState,\n        focused: document.hasFocus(),\n        persistentAnimations: document.getAnimations().filter(a => !Number.isFinite(a.effect?.getTiming().iterations)).map(a => a.animationName),\n        calls: window.__idleIpcTrace.splice(0)\n      })`)\n    });\n    await writeFile(output, JSON.stringify(observations, null, 2));\n    await wait(5000);\n  }\n} finally {\n  socket.close();\n}\nMEASURE process-usable 1795415583.676850\r\nMEASURE window-state foreground minimized=false focused=true\r\nMEASURE foreground start 1795415588.693293\r\n","exit_code":0,"duration":{"secs":0,"nanos":447495667}},"started_at_ms":1795415651666,"completed_at_ms":1795415652113}}
