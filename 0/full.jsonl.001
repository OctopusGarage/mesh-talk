ws[min(i+10,len(rows)-1)]\n    elapsed=(b['at']-a['at'])/1000\n    first={m['pid']:m for m in a['members']}\n    roles={}\n    for m in b['members']:\n        roles[m['role']]=roles.get(m['role'],0)+100*(m['cpuSeconds']-first[m['pid']]['cpuSeconds'])/elapsed\n    report.append(dict(offsetSeconds=round(a['at']/1000-start,1),seconds=round(elapsed,1),byRole=roles,family=sum(roles.values())))\n(p/'minimized-cpu-timeline.json').write_text(json.dumps(report,indent=2)+'\\n')\nfor row in report:\n    print(row['offsetSeconds'],round(row['byRole']['host'],3),round(row['family'],3))\nPY"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"17.6 0.351 0.401\n48.8 0.352 0.402\n79.9 0.151 0.151\n111.0 0.251 0.251\n142.2 0.201 0.351\n173.4 0.3 0.4\n204.6 0.301 0.301\n235.7 1.555 1.605\n266.9 0.401 0.602\n298.0 0.201 0.201\n329.1 0.402 0.502\n","exit_code":0,"duration":{"secs":0,"nanos":12875}},"started_at_ms":1795419374314,"completed_at_ms":1795419374314}}
