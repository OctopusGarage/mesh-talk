\\"first\\\"), \\\"pw\\\", DeviceIdentity::generate()).unwrap(),\\n    ));\\n    let second_store = Arc::new(Mutex::new(\\n        PostOffice::open(\\n            &temp.path().join(\\\"second\\\"),\\n            \\\"pw\\\",\\n            DeviceIdentity::generate(),\\n        )\\n        .unwrap(),\\n    ));\\n    let alice = DeviceIdentity::generate();\\n    let bob = DeviceIdentity::generate();\\n    let event = Event::new(\\n        &alice,\\n        ConversationId::new([61; 32]),\\n        1,\\n        vec![],\\n        1,\\n        10,\\n        EventKind::Message,\\n        b\\\"secret\\\".to_vec(),\\n    );\\n    let outer = RelayMailbox::federated(&alice, &bob.public())\\n        .unwrap()\\n        .wrap(&event)\\n        .unwrap();\\n    first_store.lock().unwrap().accept(outer.clone()).unwrap();\\n    let listener = tokio::net::TcpListener::bind(\\\"127.0.0.1:0\\\").await.unwrap();\\n    let addr = listener.local_addr().unwrap();\\n    let server = tokio::spawn(run_network_relay_accept_loop_with_directory(\\n        second,\\n        listener,\\n        Arc::clone(&second_store),\\n        second_network,\\n        FederationDirectory::new(),\\n    ));\\n    let directory = FederationDirectory::new();\\n    let result = directory\\n        .sync_with_network_relay(addr, &first, &second_public, &first_store, &first_network)\\n        .await;\\n    server.abort();\\n    let _ = server.await;\\n    result.unwrap();\\n    assert!(second_store.lock().unwrap().has(&outer.id));\\n}\\n\\n#[tokio::test]\\nasync fn wrong_network_and_bare_legacy_inventory_are_denied() {\\n    use mesh_talk_core::node::run_network_relay_accept_loop_with_directory;\\n    use mesh_talk_core::postoffice::{PostOffice, federation::FederationDirectory};\\n    use mesh_talk_core::transport::SecureChannel;\\n    use std::sync::{Arc, Mutex};\\n    let temp = tempfile::tempdir().unwrap();\\n    let first = DeviceIdentity::generate();\\n    let second = DeviceIdentity::generate();\\n    let first_network = enrolled(&DeviceIdentity::generate(), &first);\\n    let second_network = enrolled(&DeviceIdentity::generate(), &second);\\n    let expected = second.public();\\n    let store = Arc::new(Mutex::new(\\n        PostOffice::open(\\n            &temp.path().join(\\\"second\\\"),\\n            \\\"pw\\\",\\n            DeviceIdentity::generate(),\\n        )\\n        .unwrap(),\\n    ));\\n    let listener = tokio::net::TcpListener::bind(\\\"127.0.0.1:0\\\").await.unwrap();\\n    let addr = listener.local_addr().unwrap();\\n    let server = tokio::spawn(run_network_relay_accept_loop_with_directory(\\n        second,\\n        listener,\\ncrates/mesh-talk-core/src/postoffice/storage/role/capacity.rs:38:            super::super::super::MAX_RELAY_EVENTS as u64,\\ncrates/mesh-talk-core/src/postoffice/storage/role/capacity.rs:40:            super::super::super::MAX_RELAY_BYTES as u64,\\ntotal 16\\ndrwxr-xr-x@ 3 kingsonwu  staff    96 Nov 23 14:30 __pycache__\\n-rw-r--r--@ 1 kingsonwu  staff  2986 Nov 23 14:30 measure.py\\n-rw-r--r--  1 kingsonwu  staff    89 Nov 23 14:30 node.log\\n1795415476\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20719-6f7f-75d3-b5ba-5b05d2c65b02","create_time":1795415476.280925}},"metadata":{"history_sequence":16154,"sampled_through_sequence":16152,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
