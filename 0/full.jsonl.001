w Error(\"Native read capacity exhausted\"));\n  pending++;\n  let operation: Promise<T>;\n  try {\n    operation = Promise.resolve(read());\n  } catch (error) {\n    pending--;\n    return Promise.reject(error);\n  }\n  return new Promise<T>((resolve, reject) => {\n    const timer = setTimeout(\n      () => reject(new Error(\"Native read timed out\")),\n      timeoutMs,\n    );\n    operation.then(\n      (value) => {\n        pending--;\n        clearTimeout(timer);\n        resolve(value);\n      },\n      (error) => {\n        pending--;\n        clearTimeout(timer);\n        reject(error);\n      },\n    );\n  });\n}\n","exit_code":0,"duration":{"secs":0,"nanos":83916}},"started_at_ms":1795406505997,"completed_at_ms":1795406505998}}
