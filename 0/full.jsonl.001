{"timestamp":"2026-11-08T17:57:27.310Z","ordinal":46429,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1b054-fe0d-76c1-a45c-4726d155f0fa","turn_id":"01a1b8a7-3fc8-7460-a590-a3bb58793d59","item":{"type":"CommandExecution","id":"exec-4aa3878c-b6cd-4376-8d84-ae4f0bfac8d4","process_id":"62481","command":["/bin/zsh","-lc","sed -n '1,120p' scripts/release/check-source-checks.mjs; sed -n '1,90p' scripts/ci/required-checks.mjs"],"cwd":"file:///Users/kingsonwu/programming/OctopusGarage/mesh-talk/.worktrees/ci-critical-path","parsed_cmd":[{"type":"read","cmd":"sed -n '1,120p' scripts/release/check-source-checks.mjs","name":"check-source-checks.mjs","path":"scripts/release/check-source-checks.mjs"},{"type":"read","cmd":"sed -n '1,90p' scripts/ci/required-checks.mjs","name":"required-checks.mjs","path":"scripts/ci/required-checks.mjs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"import assert from \"node:assert/strict\";\nimport { pendingSuccessfulChecks, releaseSourceChecks, releaseSourceWorkflows } from \"../ci/required-checks.mjs\";\nimport { execFileSync } from \"node:child_process\";\nimport { setTimeout as sleep } from \"node:timers/promises\";\nimport { pathToFileURL } from \"node:url\";\n\nexport function pendingSourceChecks(checks, openAlerts, { repo, sha, runs } = {}) {\n  assert.ok(Array.isArray(openAlerts) && openAlerts.length === 0, \"main has unresolved code scanning alerts\");\n  assert.match(repo ?? \"\", /^[\\w.-]+\\/[\\w.-]+$/, \"source repository is required\");\n  assert.match(sha ?? \"\", /^[a-f\\d]{40}$/, \"source SHA is required\");\n  assert.ok(Array.isArray(runs), \"source workflow runs are required\");\n  assert.ok(Array.isArray(checks), \"source checks must be an array\");\n  // Preserve the latest same-source check veto across all suites. Trusted main\n  // provenance adds evidence requirements; it never hides a newer failure.\n  const pending = pendingSuccessfulChecks(checks, releaseSourceChecks);\n  for (const path of new Set(Object.values(releaseSourceWorkflows))) {\n    const latest = runs.filter(run => run.path === path && run.event === \"push\" && run.head_branch === \"main\"\n      && run.head_sha === sha && run.repository?.full_name === repo && run.head_repository?.full_name === repo)\n      .sort((a, b) => b.id - a.id || b.run_attempt - a.run_attempt)[0];\n    const names = releaseSourceChecks.filter(name => releaseSourceWorkflows[name] === path);\n    if (!latest || latest.status !== \"completed\") {\n      pending.push(...names);\n      continue;\n    }\n    assert.ok(Number.isSafeInteger(latest.id) && latest.id > 0\n      && Number.isSafeInteger(latest.run_attempt) && latest.run_attempt > 0\n      && Number.isSafeInteger(latest.check_suite_id) && latest.check_suite_id > 0, \"invalid source workflow identity\");\n    assert.equal(latest.conclusion, \"success\", `required source workflow not successful: ${path}`);\n    // A successful failed-jobs-only rerun retains earlier successful jobs in this\n    // suite. The completed latest attempt attests the suite without requiring\n    // every successful job to execute again.\n    pending.push(...pendingSuccessfulChecks(checks.filter(check => check.check_suite?.id === latest.check_suite_id), names));\n  }\n  return [...new Set(pending)];\n}\n\nexport function requireSourceChecks(checks, openAlerts, provenance) {\n  const pending = pendingSourceChecks(checks, openAlerts, provenance);\n  assert.equal(pending.length, 0, `required source check not successful: ${pending.join(\", \")}`);\n}\n\n// Only Nightly preflight waits. Final publication and Stable callers remain strict.\nexport async function waitForSourceChecks(readState, { timeoutMs = 4 * 60 * 60 * 1000, intervalMs = 60_000, now = Date.now, sleep: pause = sleep, log = console.log } = {}) {\n  const deadline = now() + timeoutMs;\n  for (;;) {\n    const state = await readState();\n    const pending = pendingSourceChecks(state.checks, state.openAlerts, state);\n    if (pending.length === 0) return;\n    const remaining = deadline - now();\n    assert.ok(remaining > 0, `Timed out waiting for required source checks: ${pending.join(\", \")}`);\n    log(`Waiting for required source checks: ${pending.join(\", \")} (${Math.ceil(remaining / 60_000)} minutes remaining)`);\n    await pause(Math.min(intervalMs, remaining));\n  }\n}\n\nasync function main() {\n  const [repo, sha, mode, ...extra] = process.argv.slice(2);\n  assert.ok((mode === undefined || mode === \"--wait\") && extra.length === 0, \"usage: check-source-checks.mjs REPO SHA [--wait]\");\n  assert.match(repo, /^[\\w.-]+\\/[\\w.-]+$/);\n  assert.match(sha, /^[a-f\\d]{40}$/);\n  const readState = () => {\n    const pages = JSON.parse(execFileSync(\"gh\", [\"api\", \"--paginate\", \"--slurp\", `repos/${repo}/commits/${sha}/check-runs?per_page=100&filter=all`], { encoding: \"utf8\" }));\n    const alerts = JSON.parse(execFileSync(\"gh\", [\"api\", \"--paginate\", \"--slurp\", `repos/${repo}/code-scanning/alerts?state=open&ref=refs%2Fheads%2Fmain&per_page=100`], { encoding: \"utf8\" }));\n    const runPages = JSON.parse(execFileSync(\"gh\", [\"api\", \"--paginate\", \"--slurp\", `repos/${repo}/actions/runs?head_sha=${sha}&per_page=100`], { encoding: \"utf8\" }));\n    return { repo, sha, runs: runPages.flatMap(page => page.workflow_runs), checks: pages.flatMap((page) => page.check_runs), openAlerts: alerts.flat() };\n  };\n  if (mode === \"--wait\") await waitForSourceChecks(readState);\n  else {\n    const state = readState();\n    requireSourceChecks(state.checks, state.openAlerts, state);\n  }\n  console.log(\"Current-source CI, health, E2E and security checks passed; main has no open scanning alerts.\");\n}\n\nif (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) await main();\n// Direct execution checks shared by release acceptance and the one-time protection\n// migration. PR-only and main-only policies deliberately remain separate.\nimport assert from \"node:assert/strict\";\n\nimport { windowsPartitions as nativePartitions } from \"./windows-coverage.mjs\";\n\nconst windowsPartitions = nativePartitions.map(shard => `windows / Windows workspace tests (${shard}/${nativePartitions.length})`);\nconst windows = [\"windows / Windows workspace build\", ...windowsPartitions];\nconst workspace = [...[\"ubuntu-latest\", \"macos-latest\"].map(os => `checks (${os})`), ...windows];\nconst health = [\"health / Source and supply-chain checks\", ...[\"ubuntu-latest\", \"macos-26-intel\", \"windows-latest\"].map(os => `health / Portable checks (${os})`)];\nconst backend = [\"windows-2022\", \"macos-26-intel\"].map(os => `Backend core (${os})`);\nconst native = [\"ubuntu-24.04\", \"windows-2022\", \"macos-latest\"].map(os => `native-core / Real native UI (${os})`);\n\nexport const releaseSourceChecks = Object.freeze([\n  ...workspace, ...health, ...backend, ...native,\n  \"Playwright UI E2E\", \"ASan + LeakSanitizer (core)\", \"mutants\", \"scan\", \"Scorecard analysis\",\n  \"Analyze (rust)\", \"Analyze (actions)\", \"Analyze (javascript-typescript)\",\n]);\n\n// Top-level workflow ownership: reusable jobs belong to their caller's suite.\nexport const releaseSourceWorkflows = Object.freeze({\n  ...Object.fromEntries(workspace.map(name => [name, \".github/workflows/ci.yml\"])),\n  ...Object.fromEntries(health.map(name => [name, \".github/workflows/e2e-ui.yml\"])),\n  ...Object.fromEntries([...backend, ...native].map(name => [name, \".github/workflows/e2e-backend.yml\"])),\n  \"Playwright UI E2E\": \".github/workflows/e2e-ui.yml\",\n  \"ASan + LeakSanitizer (core)\": \".github/workflows/sanitizers.yml\",\n  mutants: \".github/workflows/mutants.yml\",\n  scan: \".github/workflows/gitleaks.yml\",\n  \"Scorecard analysis\": \".github/workflows/scorecard.yml\",\n  ...Object.fromEntries([\"rust\", \"actions\", \"javascript-typescript\"].map(language => [`Analyze (${language})`, \".github/workflows/codeql.yml\"])),\n});\n\nexport function pendingSuccessfulChecks(checks, names, appSlug = \"github-actions\") {\n  assert.ok(Array.isArray(checks), \"source checks must be an array\");\n  return names.filter(name => {\n    const latest = checks.filter(check => check.name === name && check.app?.slug === appSlug).sort((a, b) => b.id - a.id)[0];\n    if (!latest || latest.status !== \"completed\") return true;\n    assert.equal(latest.conclusion, \"success\", `required source check not successful: ${name}`);\n    return false;\n  });\n}\n\nexport function requireSuccessfulChecks(checks, names, appSlug) {\n  const pending = pendingSuccessfulChecks(checks, names, appSlug);\n  assert.equal(pending.length, 0, `required source check not successful: ${pending.join(\", \")}`);\n}\n\nconst replacements = new Map([\n  [\"verify\", workspace],\n  [\"checks (windows-latest)\", windows],\n  ...[1, 2].map(shard => [`windows / Windows workspace tests (${shard}/2)`, windowsPartitions]),\n  ...[1, 2, 3, 4].map(shard => [`windows / Windows workspace tests (${shard}/4)`, windowsPartitions]),\n  [\"health / Portable checks (macos-latest)\", [\"health / Portable checks (macos-26-intel)\"]],\n  [\"Backend core (macos-latest)\", [\"Backend core (macos-26-intel)\"]],\n  [\"Portable UI (macos-latest, webkit)\", [\"Portable UI (macos-26-intel, webkit)\"]],\n  [\"Backend core (ubuntu-24.04)\", [\"checks (ubuntu-latest)\"]],\n  [\"Multi-process E2E\", [\"checks (ubuntu-latest)\", ...backend, ...native]],\n  ...[\"ubuntu-latest\", \"macos-latest\", \"windows-latest\"].map(os => [`Code Quality and Health Check (${os})`, health]),\n  ...[\"ubuntu-24.04\", \"windows-2022\", \"macos-latest\"].map(os => [`native-core / Runner multicast diagnostic (${os})`, [`native-core / Real native UI (${os})`]]),\n  ...[\"ubuntu-24.04\", \"windows-2022\", \"macos-latest\"].map(os => [`Portable UI (${os}, chromium)`, [\"Chromium portable evidence\"]]),\n]);\n\nexport function migrateRequiredChecks(current) {\n  assert.equal(typeof current.strict, \"boolean\", \"protection strictness is required\");\n  assert.ok(Array.isArray(current.checks) && current.checks.length, \"app-bound required checks are required\");\n  const migrated = new Map();\n  for (const check of current.checks) {\n    assert.ok(typeof check.context === \"string\" && Number.isInteger(check.app_id), \"invalid required check app binding\");\n    for (const context of replacements.get(check.context) ?? [check.context]) {\n      const prior = migrated.get(context);\n      assert.ok(!prior || prior.app_id === check.app_id, `conflicting check app binding: ${context}`);\n      migrated.set(context, { context, app_id: check.app_id });\n    }\n  }\n  return { strict: current.strict, checks: [...migrated.values()].sort((a, b) => a.context.localeCompare(b.context, \"en\")) };\n}\n\nexport function requireProtectionEvidence(policy, checks) {\n  for (const { context, app_id: appId } of policy.checks) {\n    const latest = checks.filter(check => check.name === context && check.app?.id === appId).sort((a, b) => b.id - a.id)[0];\n    assert.ok(latest?.status === \"completed\" && latest.conclusion === \"success\", `required replacement check has no successful current-source app-bound evidence: ${context}`);\n  }\n}\n","exit_code":0,"duration":{"secs":0,"nanos":6167}},"started_at_ms":1794160647310,"completed_at_ms":1794160647310}}
