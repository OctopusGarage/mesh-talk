!= \\\"kB\\\":\\n                raise RuntimeError(f\\\"unexpected {field} units\\\")\\n            memory[field] = int(value)\\n    except (FileNotFoundError, ProcessLookupError):\\n        continue\\n    samples.append({\\\"pid\\\": pid, \\\"started\\\": int(fields[19]), \\\"name\\\": (process / \\\"comm\\\").read_text().strip(),\\n                    \\\"cpuSeconds\\\": (int(fields[11]) + int(fields[12])) / clock,\\n                    \\\"pssKiB\\\": memory[\\\"Pss\\\"],\\n                    \\\"privateResidentKiB\\\": memory[\\\"Private_Clean\\\"] + memory[\\\"Private_Dirty\\\"], \\\"writeBytes\\\": int(io[\\\"write_bytes\\\"])})\\nprint(json.dumps({\\\"at\\\": time.time(), \\\"host\\\": root, \\\"members\\\": samples}))\\n4:fn phase(app: &tauri::AppHandle, name: &str, minimized: bool, interval: Duration) {\\n9:        if minimized {\\n10:            window.minimize().unwrap();\\n24:        send.send((window.is_minimized().unwrap(), window.is_focused().unwrap()))\\n28:    let (actual_minimized, focused) = receive.recv_timeout(Duration::from_secs(5)).unwrap();\\n29:    assert_eq!(actual_minimized, minimized);\\n30:    assert_eq!(focused, !minimized);\\n31:    marker(name, \\\"start\\\");\\n33:    marker(name, \\\"end\\\");\\n36:fn marker(phase: &str, boundary: &str) {\\n38:        \\\"MEASURE {phase} {boundary} {:.6}\\\",\\n73:  const record = (name, at) => {\\n74:    if (loginSubmittedAt !== undefined && observed[name] === undefined)\\n75:      observed[name] = at - loginSubmittedAt;\\n94:    await fill(\\\"login-username\\\", fixture.username);\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20744-ecdc-7a41-bab7-c66a90d52b23","create_time":1795418336.141834}},"metadata":{"history_sequence":16908,"sampled_through_sequence":16905,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
