er/runtime work cannot mark a new run dirty.\nconst statusRefreshRuns = new WeakMap<Get, StatusRefreshRun>();\nconst MAX_DIRTY_STATUS_CONVERSATIONS = 50;\n\nexport async function refreshDeliveryStatuses(\n  rawSet: Set,\n  get: Get,\n  conversation?: Conversation,\n  invalidate = false,\n) {\n  const lease = captureChatOwner(get);\n  const set: Set = (partial) => {\n    if (lease.current()) rawSet(partial);\n  };\n  const c = conversation ?? get().active;\n  if (!lease.current() || !c) return;\n  const key = convKey(c);\n  if (get().statusBusy) {\n    const run = statusRefreshRuns.get(get);\n    if (invalidate && run?.current()) {\n      run.dirty.delete(key);\n      run.dirty.set(key, c);\n      if (run.dirty.size > MAX_DIRTY_STATUS_CONVERSATIONS)\n        run.dirty.delete(run.dirty.keys().next().value!);\n    }\n    return;\n  }\n  const run: StatusRefreshRun = { current: lease.current, dirty: new Map() };\n  statusRefreshRuns.set(get, run);\n  set({ statusBusy: true });\n  try {\n    if (c.kind === \"channel\") {\n      const ids = [\n        ...new Set(\n          (get().messages[key] ?? [])\n            .filter((m) => m.fromMe && m.id)\n            .map((m) => m.id!),\n        ),\n      ];\n      const requestedIds = new Set(ids);\n      const replicas = new Map<\n        string,\n        { members: number; postOffices: number }\n      >();\n      for (let i = 0; i < ids.length; i += 256) {\n        const rows = await readWithDeadline(() =>\n          chat.channelCustodyStatuses(c.id, ids.slice(i, i + 256)),\n        );\n        if (!lease.current()) return;\n        for (const row of rows)\n          replicas.set(row.id, {\n            members: row.replicas,\n            postOffices: row.post_offices ?? 0,\n          });\n      }\n      set((s) => {\n        const current = s.messages[key];\n        if (!current) return { messages: s.messages };\n        let changed = false;\n        const next = current.map((m) => {\n          if (!m.fromMe || !m.id || !requestedIds.has(m.id)) return m;\n          const counts = replicas.get(m.id);\n          if (\n            m.replicas === counts?.members &&\n            m.postOfficeCopies === counts?.postOffices\n          )\n            return m;\n          changed = true;\n          return {\n            ...m,\n            replicas: counts?.members,\n            postOfficeCopies: counts?.postOffices,\n          };\n        });\n        return {\n          messages: changed ? { ...s.messages, [key]: next } : s.messages,\n        };\n      });\n      return;\n    }\n    // The shared serial ticker also recovers capacity-fallback accepted intents.\n    // reload's status refresh sees statusBusy and cannot recursively poll.\n    if (\n      get().active &&\n      convKey(get().active!) === key &&\n      Object.values(get().intents).some(\n        (i) =>\n          convKey(i.conversation) === key &&\n          i.acceptanceHistoryOnly &&\n          i.message.id,\n      )\n    ) {\n      await get().reload();\n      if (!lease.current()) return;\n    }\n    const ids = [\n      ...new Set(\nfrontend/src/store/outgoingIntent.test.ts:12:  refreshDeliveryStatuses,\nfrontend/src/store/outgoingIntent.test.ts:273:      await refreshDeliveryStatuses(store.setState, store.getState);\nfrontend/src/store/outgoingIntent.test.ts:278:  await refreshDeliveryStatuses(store.setState, store.getState);\nfrontend/src/store/outgoingIntent.test.ts:344:  await refreshDeliveryStatuses(store.setState, store.getState);\nfrontend/src/store/outgoingIntent.test.ts:349:  await refreshDeliveryStatuses(store.setState, store.getState);\nfrontend/src/store/outgoingIntent.test.ts:354:  await refreshDeliveryStatuses(store.setState, store.getState);\nfrontend/src/store/outgoingIntent.test.ts:356:  await refreshDeliveryStatuses(store.setState, store.getState);\nfrontend/src/store/outgoingIntent.test.ts:442:  const read = refreshDeliveryStatuses(store.setState, store.getState);\nfrontend/src/store/outgoingIntent.test.ts:444: 