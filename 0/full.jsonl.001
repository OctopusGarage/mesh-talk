{"timestamp":"2026-11-23T07:45:50.385Z","ordinal":40624,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a2075e-4d31-7841-8b3e-7cd1539a1939","call_id":"call_0dd58f0801e446e199f6b2dc4ec0c8ed","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"5640f2\",\"wall_time_seconds\":0.000013583,\"exit_code\":0,\"original_token_count\":1921,\"output\":\"            node.append_event(channel, EventKind::Message, vec![0; 64])\\n                .unwrap();\\n        }\\n        let mut exhausted = crate::eventlog::sync::network::PreparationBudget {\\n            rows: 0,\\n            ..Default::default()\\n        };\\n        assert!(matches!(\\n            node.commit_account_maintenance_with_budget(channel, &mut work, &mut exhausted),\\n            Err(NodeError::Log(LogError::StaleCursor))\\n        ));\\n        assert!(\\n            queued(node, channel),\\n            \\\"unfinished changed source must retain durable recovery demand\\\"\\n        );\\n        node.await_channel_metadata(channel).await.unwrap();\\n        drain(node, channel);\\n        assert_quiet(node, channel, &mut work);\\n    }\\n\\n    #[tokio::test]\\n    async fn unchanged_channel_maintenance_does_not_rehydrate_projection_or_distributions() {\\n        let group = Group::new().await;\\n        let node = &group.nodes[0];\\n        let channel = node.create_channel(\\\"idle producer\\\", vec![]).await.unwrap();\\n        let mut work = ChannelAccountMaintenance::default();\\n        for _ in 0..4 {\\n            node.maintain_account_channels(&mut work).await;\\n            node.await_channel_metadata(channel).await.unwrap();\\n        }\\n        let hydrations = node.channel_checkpoints.projection_hydrations();\\n        let before = (work.projection_reads, work.distribution_reads);\\n        assert!(\\n            before.0 > 0,\\n            \\\"fixture must execute the real projection owner\\\"\\n        );\\n        for _ in 0..8 {\\n            node.maintain_account_channels(&mut work).await;\\n            assert!(node.maintain_one_account_channel(channel, &mut work).await);\\n        }\\n        assert!(\\n            work.deadline().saturating_duration_since(Instant::now()) >= Duration::from_secs(290),\\n            \\\"quiet maintenance must park at sparse recovery, not a hot tick\\\"\\n        );\\n        assert_eq!(\\n            (work.projection_reads, work.distribution_reads),\\n            before,\\n            \\\"unchanged producer must not hydrate projection or sender distributions\\\"\\n        );\\n        assert_eq!(\\n            node.channel_checkpoints.projection_hydrations(),\\n            hydrations,\\n            \\\"measure all published projection hydration, not only commit calls\\\"\\n        );\\n        node.append_event(channel, EventKind::Message, vec![0; 64])\\n            .unwrap();\\n        assert!(node.maintain_one_account_channel(channel, &mut work).await);\\n        assert!(\\n            work.projection_reads > before.0,\\n            \\\"source changes must invalidate scheduling evidence\\\"\\n        );\\n    }\\n\\n    #[tokio::test]\\n    async fn failed_capability_retains_pending_inventory_without_a_short_retry_loop() {\\n        let group = Group::new().await;\\n        let mut work = ChannelAccountMaintenance::default();\\n        for _ in 0..8 {\\n            node.maintain_account_channels(&mut work).await;\\n        }\\n        assert!(\\n            work.settled.contains_key(ready.as_bytes()),\\n            \\\"the other channel must complete real maintenance\\\"\\n        );\\n        assert!(!work.settled.contains_key(deferred.as_bytes()));\\n        assert!(\\n            work.input.is_none(),\\n            \\\"one ready channel cannot acknowledge another channel's deferred work\\\"\\n        );\\n        assert!(\\n            work.deadline().saturating_duration_since(Instant::now()) <= Duration::from_secs(3)\\n        );\\n        let observed = work.input(node).await.unwrap();\\n        assert_eq!(work.observed_input, Some(observed));\\n        assert!(work.deadline() > Instant::now());\\n        let eligibility = work.eligibility_reads;\\n        for _ in 0..8 {\\n            node.maintain_account_channels_after_wake(&mut work, true)\\n                .await;\\n        }\\n        assert_eq!(\\n            work.eligibility_reads, eligibility,\\n            \\\"unchanged ordinary notifications must respect the deferred owner's retry deadline\\\"\\n        );\\n        assert!(\\n            work.input.is_none(),\\n            \\\"parking cannot acknowledge deferred work\\\"\\n        );\\n        work.run_at = Some(Instant::now());\\n        node.maintain_account_channels_after_wake(&mut work, true)\\n            .await;\\n        assert!(\\n            work.eligibility_reads > eligibility,\\n            \\\"a due retry must advance real eligibility\\\"\\n        );\\n        let eligibility = work.eligibility_reads;\\n        assert!(work.deadline() > Instant::now());\\n        node.privacy\\n            .projection_revision\\n            .fetch_add(1, Ordering::SeqCst);\\n        assert_ne!(work.input(node).await.unwrap(), observed);\\n        node.maintain_account_channels_after_wake(&mut work, true)\\n            .await;\\n        assert!(\\n            work.eligibility_reads > eligibility,\\n            \\\"fresh semantics bypass the retry wait\\\"\\n        );\\n        let eligibility = work.eligibility_reads;\\n        node.maintain_account_channels_after_wake(&mut work, false)\\n            .await;\\n        assert!(\\n            work.eligibility_reads > eligibility,\\n            \\\"event-only recovery cannot wait on a disabled timer\\\"\\n        );\\n        *node.account_channel_maintenance_test_hook.lock().unwrap() = None;\\n        for _ in 0..8 {\\n            node.maintain_account_channels(&mut work).await;\\n        }\\n        assert!(\\n            work.settled.contains_key(deferred.as_bytes()),\\n            \\\"removing the hold must recover retained work\\\"\\n        );\\n        assert!(work.input.is_some());\\n    }\\n    /// Bodyless scheduling hint only; direct document integrity checks remain mandatory.\\n    pub fn group_projection_revision(&self) -> Result<[u8; 32], LogError> {\\n        use std::sync::atomic::Ordering;\\n        let source = {\\n            let log = self.log.lock().expect(\\\"log mutex\\\");\\n            let repository = log.repository()?;\\n            (\\n                repository.source_revision()?,\\n                repository.destructive_policy_revision()?,\\n            )\\n        };\\n        let profiles = self.profiles.lock().expect(\\\"profiles mutex\\\").revision()?;\\n        let avatars = self.account_profiles.revision()?;\\n        let proofs = self\\n            .privacy\\n            .state\\n            .read()\\n            .expect(\\\"privacy state mutex\\\")\\n            .as_ref()\\n            .map(|state| state.proofs.revision());\\n        let privacy = (\\n            self.privacy.generation.load(Ordering::SeqCst),\\n            self.privacy.projection_revision.load(Ordering::SeqCst),\\n            proofs,\\n        );\\n        let policy = self.device_sync_policy_snapshot().1;\\n        let documents = *self.account_document_updates.borrow();\\n        // Guards end independently. These owner-local hints exclude routes and leases;\\n        // current source, policy, privacy and authorization still remain fresh.\\n        let devices = self\\n            .account_devices\\n            .lock()\\n            .expect(\\\"account devices mutex\\\")\\n            .metadata_digest()?;\\n        let roster = self\\n            .roster\\n            .lock()\\n            .expect(\\\"roster mutex\\\")\\n            .metadata_digest()?;\\n        let mut groups = self.channels.lock().expect(\\\"channels mutex\\\").channel_ids();\\n        