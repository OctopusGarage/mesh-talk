ot verified' }\n$loaded = \"$work/idle-focus-retry-loaded\"\n$profile = \"$work/idle-focus-retry-loaded-profile\"\nCopy-Item \"D:/MeshTalk/REQ011/windows-reception-batched.hIVWN4ON/reference/desktop\" $profile -Recurse\nRemove-Item Env:REQ011_STARTUP_ONLY, Env:MESH_TALK_TRACE_WORK -ErrorAction SilentlyContinue\n& \"$PSScriptRoot/sample-reference-desktop.ps1\" -Binary $binary -Profile $profile -Evidence $loaded -PhaseSeconds 345 -Metadata \"D:/MeshTalk/REQ011/windows-reception-batched.hIVWN4ON/reference/metadata.json\" -PasswordFile \"D:/MeshTalk/REQ011/windows-reception-batched.hIVWN4ON/reference/password\"\n$empty = \"$work/idle-focus-retry-empty\"\n& \"$PSScriptRoot/sample-reference-desktop.ps1\" -Binary $binary -Profile \"$work/idle-focus-retry-empty-profile\" -Evidence $empty -PhaseSeconds 345\n@{ loaded = $loaded; empty = $empty; messages = $fixture.messages; sessionId = (Get-Process -Id $PID).SessionId } |\n    ConvertTo-Json -Compress | Set-Content -Encoding UTF8 \"$PSScriptRoot/reception-window-state-results.json\"\n} catch {\n    $_ | Out-String | Set-Content -Encoding UTF8 \"$PSScriptRoot/reception-window-state-error.log\"\n    throw\n}\n488:        \"Native quit/restart spot check verifies encrypted draft restoration; abrupt exits may lose edits within the idle window.\"\n989:      \"id\": \"desktop-window\",\n994:        \"src-tauri/src/window_visibility.rs\",\n1010:        \"On macOS run the native-window-reopen-eval example with an isolated absolute data root and --hidden. Verify physical packaged Dock and tray Open/click restoration after close-to-tray and minimization, repeated activation, locked entry and hidden autostart. Mock runtime tests do not establish native visibility or focus.\",\n1018:            \"name\": \"Normal initial show waits for an authorized prepared renderer or bounded fault fallback; hidden launch, explicit visibility and queued retirement remain authoritative. Presentation IPC never admits account content.\",\n1254:        \"src-tauri/src/window_visibility.rs\",\n1286:        \"Run native Linux capture on XFCE/X11 without a Screenshot portal, including normal and hide-window capture, editor confirmation/cancel and window restoration. Also check portal cancellation and a native Wayland session; unit/helper tests alone do not certify native webview behavior.\"\n40:const report = { schema: 1, platform: process.platform, native: true, mocked: false, scenarios: {}, startedAt: new Date().toISOString(), input: \"embedded W3C DOM automation in actual native webview; contextmenu and focus-before-click dialog triggers use execute; keyboard uses in-process AppKit on macOS, owned-PID OS input on Windows/Linux; no physical keyboard user study\", driver: nativeDriverEvidence(await readFile(new URL(\"../../Cargo.lock\", import.meta.url), \"utf8\")), kdf: { example: \"fast-test-kdf (existing dev-dependency)\", cli: \"regular production KDF\" } };\n520:  if (!backgroundOnly) await until(\"desktop rendered CLI reply\", () => execute(\"return Array.from(document.querySelectorAll('[data-testid=message-bubble]')).some(el => el.textContent.includes(arguments[0]));\", [inbound]));\n","exit_code":0,"duration":{"secs":0,"nanos":10083}},"started_at_ms":1795410668676,"completed_at_ms":1795410668676}}
