andidate; do\n  mkdir \"$out/$variant\"\n  target/release/foundation-desktop-profile \"$r/fixture\" \"$out/$variant/profile\" \"$r/password\" >\"$out/$variant/staged.json\"\n  test \"$variant\" = candidate && probe=\"$h/$bin-parallel\" || probe=\"$h/$bin\"\n  MESH_TALK_TRACE_WORK=1 caffeinate -is python3 \"$h/measure-warm-native-footprint.py\" \"$probe\" \\\n    \"$out/$variant/profile\" \"$out/$variant/staged.json\" \"$r/fixture/manifest.json\" \"$r/password\" \"$out/$variant/results\" --restarts 4 >\"$out/$variant/measurement.log\" 2>&1\ndone"}],"source":"unified_exec_startup","status":"failed","aggregated_output":"","exit_code":143,"duration":{"secs":1098,"nanos":567308250}},"started_at_ms":1795409211987,"completed_at_ms":1795410310594}}
