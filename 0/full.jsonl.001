evision={} next_commit={} visibility={} database_changes={} page_size={} page_count={} free_pages={} write_observer_enabled={}\", s.retained_count,s.retained_bytes,s.drain_requested,s.source_revision,s.next_commit,s.visibility,s.database_changes,s.page_size,s.page_count,s.free_pages,s.write_observer_enabled)),\n                            Err(_) => super::emit(\"relay_storage unavailable=true\"),\n                        }\n                        if let Some([appended,duplicate,rejected,unavailable,failed])=office.ingest_observation() {\n                            super::emit(&format!(\"relay_ingest cumulative=true approximate=true appended={appended} duplicate={duplicate} peer_classified_rejection={rejected} locally_unavailable={unavailable} authoritative_failure={failed}\"));\n                        }\n                    }\n                    completed=sessions.join_next(), if !sessions.is_empty()=>{\n                        match completed {\n                            Some(Ok(Err(error))) => {\n                                if office.requires_reopen() { break Err(Box::new(error) as Box<dyn std::error::Error>); }\n                                log::debug!(\"relay session: {error}\");\n                            }\n                            Some(Err(error)) => break Err(Box::new(error) as Box<dyn std::error::Error>),\ncrates/mesh-talk-core/src/postoffice/maintenance.rs:170:    pub async fn run_maintenance(&self, mut stop: watch::Receiver<bool>) -> Result<(), LogError> {\ncrates/mesh-talk-core/src/postoffice/maintenance.rs:494:            let worker = office.run_maintenance(rx);\ncrates/mesh-talk-core/src/postoffice/maintenance.rs:563:        let worker = office.run_maintenance(rx);\ncrates/mesh-talk-core/src/postoffice/maintenance.rs:682:        let worker = office.run_maintenance(rx);\ncrates/mesh-talk-core/src/postoffice/maintenance.rs:770:        let worker = office.run_maintenance(rx);\ncrates/mesh-talk-core/src/postoffice/maintenance.rs:907:     