te_legacy_for_account::<Record>(\n                profile,\n                path,\n                password,\n                AUTHORED_REACTIONS,\n                account,\n                super::LEGACY_MAGIC,\n            )\n        }\n    }\n\n    pub(in crate::node) fn from_profile(\n        profile: Arc<ProfileStorage>,\n        path: &Path,\n        password: &str,\n        account: [u8; 32],\n    ) -> Result<Self, LogError> {\n        profile.database().transaction(|c| {\n            let present:bool=c.query_row(\"SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name='authored_reaction_state')\",[],|r|r.get(0))?;\n            let registry:bool=c.query_row(\"SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name='account_history_sources')\",[],|r|r.get(0))?;\n            let imported=registry && c.query_row(\"SELECT EXISTS(SELECT 1 FROM account_history_sources WHERE kind=15 AND account=?1)\",[account.as_slice()],|r|r.get::<_,bool>(0))?;\n            if !present && !imported {c.execute_batch(SCHEMA)?;}\n            crate::storage::profile::manifest::validate_ddl(c,SCHEMA)?;\n            let initialized:bool=c.query_row(\"SELECT EXISTS(SELECT 1 FROM authored_reaction_state WHERE account=?1)\",[account.as_slice()],|r|r.get(0))?;\n            if initialized!=imported {return Err(invalid(\"authored reaction source authority is missing\"));}\n            let channels:bool=c.query_row(\"SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name='private_channel_reactions')\",[],|r|r.get(0))?;\n            if !channels { c.execute_batch(CHANNEL_SCHEMA)?; }\n            crate::storage::profile::manifest::validate_ddl(c,CHANNEL_SCHEMA)?;\n            Ok(())\n        })?;\n        let source = PublishedHistorySource::open_for_account(\n            profile,\n            path,\n            password,\n            AUTHORED_REACTIONS,\n            account,\n            |c, path, password| {\n                c.execute(\n                    \"INSERT INTO authored_reaction_state(account) VALUES(?1)\",\n                    [account.as_slice()],\n                )?;\n                if legacy_magic(path)? == super::MAGIC {\n                    let log = EncryptedRecordLog::<super::StoreRecord>::open_with_visitor(\n                        path,\n                        password,\n                        super::MAGIC,\n                        |record| Self::import_record(c, &account, record),\n                    )?;\n                    log.sync()\n                } else {\n                    let log = EncryptedRecordLog::<Record>::open_with_visitor(\n                        path,\n                        password,\n248:    pub(in crate::node) fn authenticate_legacy(\n259:    pub(in crate::node) fn open_profile(\n521:    pub(in crate::node) profiles: Mutex<super::account_profile_data::IndexedAccountProfileStore>,\n522:    pub(in crate::node) account_profiles: super::account_profile::AccountProfiles,\n523:    /// Live stream of received peer profiles (avatar updates), surfaced to the app. The\n904:            &dir.join(\"trust-cards.log\"),\n1154:            &dir.join(\"trust-cards.log\"),\n909:            &dir.join(\"account-profiles.log\"),\n1160:                &dir.join(\"account-profiles.log\"),\n17:Warm startup restarts the process with OS caches retained; cold startup records\n27:| Memory growth           | Repeated navigation/media cycles reach a bounded plateau. Tenfold stored history must not require tenfold startup reads or retained UI payloads.                                                    |\n55:- At startup, restore only the indexes, authority and bounded cursors needed to\n96:from a quiet disk, fast startup from a blank window, or bounded memory from one\n103:   user navigation and foreground activation. Schedule the next actual expiry or\n396:Record startup timings at their actual milestone. The desktop log records\n","exit_code":0,"duration":{"secs":0,"nanos":14083}},"started_at_ms":1795415358773,"completed_at_ms":1795415358774}}
