{"timestamp":"2026-11-23T04:32:49.891Z","ordinal":34843,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1feaf-24d9-7612-a284-664abd64a2c4","turn_id":"01a206ac-a8d9-7182-994d-635dc5a22a05","item":{"type":"CommandExecution","id":"exec-22d97abe-2997-488e-8bb2-c0f5e56078da","process_id":"54740","command":["/bin/zsh","-lc","w=$(cat tmp/req-011/windows-interface-integrated-path)\nnl -ba \"$w/unified-desktop-window-state.rs\" | head -53\nsed -n '1,84p' \"$w/sample-reference-desktop.ps1\"\nd=$(cat tmp/req-011/windows-reception-batched-path)\nrg -n 'Window|focus|minimi' \"$d\"/run-reception-window-state.ps1"],"cwd":"file:///Users/kingsonwu/programming/OctopusGarage/mesh-talk","parsed_cmd":[{"type":"unknown","cmd":"w=$(cat tmp/req-011/windows-interface-integrated-path)\nnl -ba \"$w/unified-desktop-window-state.rs\" | head -53\nsed -n '1,84p' \"$w/sample-reference-desktop.ps1\"\nd=$(cat tmp/req-011/windows-reception-batched-path)\nrg -n 'Window|focus|minimi' \"$d\"/run-reception-window-state.ps1"}],"source":"unified_exec_startup","status":"failed","aggregated_output":"     1\tuse std::time::{Duration, SystemTime, UNIX_EPOCH};\n     2\tuse tauri::{Listener, Manager, webview::PageLoadEvent};\n     3\t\n     4\tfn phase(app: &tauri::AppHandle, name: &str, minimized: bool, interval: Duration) {\n     5\t    let handle = app.clone();\n     6\t    let (send, receive) = std::sync::mpsc::sync_channel(1);\n     7\t    app.run_on_main_thread(move || {\n     8\t        let window = handle.get_webview_window(\"main\").unwrap();\n     9\t        if minimized {\n    10\t            window.minimize().unwrap();\n    11\t        } else {\n    12\t            window.show().unwrap();\n    13\t            window.set_focus().unwrap();\n    14\t        }\n    15\t        send.send(()).unwrap();\n    16\t    })\n    17\t    .unwrap();\n    18\t    receive.recv_timeout(Duration::from_secs(5)).unwrap();\n    19\t    std::thread::sleep(Duration::from_secs(5));\n    20\t    let handle = app.clone();\n    21\t    let (send, receive) = std::sync::mpsc::sync_channel(1);\n    22\t    app.run_on_main_thread(move || {\n    23\t        let window = handle.get_webview_window(\"main\").unwrap();\n    24\t        send.send((window.is_minimized().unwrap(), window.is_focused().unwrap()))\n    25\t            .unwrap();\n    26\t    })\n    27\t    .unwrap();\n    28\t    let (actual_minimized, focused) = receive.recv_timeout(Duration::from_secs(5)).unwrap();\n    29\t    assert_eq!(actual_minimized, minimized);\n    30\t    if !minimized || !cfg!(target_os = \"windows\") {\n    31\t        assert_eq!(focused, !minimized);\n    32\t    }\n    33\t    eprintln!(\"MEASURE window-state {name} minimized={actual_minimized} focused={focused}\");\n    34\t    marker(name, \"start\");\n    35\t    std::thread::sleep(interval);\n    36\t    marker(name, \"end\");\n    37\t}\n    38\t\n    39\tfn marker(phase: &str, boundary: &str) {\n    40\t    eprintln!(\n    41\t        \"MEASURE {phase} {boundary} {:.6}\",\n    42\t        SystemTime::now()\n    43\t            .duration_since(UNIX_EPOCH)\n    44\t            .unwrap()\n    45\t            .as_secs_f64()\n    46\t    );\n    47\t}\n    48\t\n    49\tfn main() {\n    50\t    let mut args = std::env::args().skip(1);\n    51\t    let root = std::path::PathBuf::from(args.next().expect(\"fixture root\"));\n    52\t    let port = args.next().expect(\"discovery port\").parse().unwrap();\n    53\t    let interval = Duration::from_secs(args.next().expect(\"sample seconds\").parse().unwrap());\nparam(\n    [Parameter(Mandatory=$true)][string]$Binary,\n    [Parameter(Mandatory=$true)][string]$Profile,\n    [Parameter(Mandatory=$true)][string]$Evidence,\n    [ValidateRange(320,7200)][int]$PhaseSeconds = 330,\n    [string]$Metadata,\n    [string]$PasswordFile\n)\n$ErrorActionPreference = 'Stop'\n$loaded = [bool]$Metadata\nif ($loaded -ne [bool]$PasswordFile) { throw 'Supply both fixture metadata and password file' }\nNew-Item -ItemType Directory -Path $Evidence | Out-Null\n$udp = New-Object System.Net.Sockets.UdpClient(0)\n$port = ([Net.IPEndPoint]$udp.Client.LocalEndPoint).Port\n$udp.Dispose()\n$stderr = \"$Evidence/fixture.log\"\n$arguments = @($Profile, $port, $PhaseSeconds)\nif ($loaded) { $arguments += @($Metadata, $PasswordFile) }\n$start = [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()\n$instance = Start-Process -FilePath $Binary -ArgumentList $arguments -PassThru -RedirectStandardError $stderr -RedirectStandardOutput \"$Evidence/stdout.log\"\n# Keep the native handle so Windows PowerShell can retrieve the exit code.\n$null = $instance.Handle\n$clock = [Diagnostics.Stopwatch]::StartNew()\n$samples = New-Object System.Collections.Generic.List[object]\ntry {\n    while (!$instance.HasExited) {\n        if ($clock.Elapsed.TotalSeconds -gt 180 + 2 * $PhaseSeconds) { throw 'Native desktop probe timed out' }\n        $inventory = @(Get-CimInstance Win32_Process)\n        $family = [Collections.Generic.HashSet[int]]::new()\n        [void]$family.Add($instance.Id)\n        do {\n            $previous = $family.Count\n            foreach ($item in $inventory) {\n                if ($family.Contains([int]$item.ParentProcessId)) { [void]$family.Add([int]$item.ProcessId) }\n            }\n        } until ($family.Count -eq $previous)\n        $members = @(\n            foreach ($item in $inventory) {\n                if (!$family.Contains([int]$item.ProcessId)) { continue }\n                $process = Get-Process -Id $item.ProcessId -ErrorAction SilentlyContinue\n                if (!$process) { continue }\n                $role = if ($item.ProcessId -eq $instance.Id) { 'host' }\n                    elseif ($item.Name -match '^msedgewebview2\\.exe$' -and $item.CommandLine -match '--type=renderer') { 'renderer' }\n                    elseif ($item.Name -match '^msedgewebview2\\.exe$' -and $item.CommandLine -match '--type=gpu-process') { 'gpu' }\n                    elseif ($item.Name -match '^msedgewebview2\\.exe$') { 'webview' }\n                    else { 'helper' }\n                try {\n                    $created = $process.StartTime\n                    $cpu = $process.TotalProcessorTime\n                    if ($null -eq $created -or $null -eq $cpu -or $process.HasExited) { continue }\n                    [ordered]@{\n                        pid = $process.Id; start = $created.ToUniversalTime().Ticks; role = $role\n                        cpuSeconds = $cpu.TotalSeconds\n                        privateBytes = $process.PrivateMemorySize64\n                        workingSetBytes = $process.WorkingSet64\n                    }\n                } catch [System.InvalidOperationException], [System.ComponentModel.Win32Exception] {\n                    if (!$process.HasExited) { throw }\n                }\n            }\n        )\n        $samples.Add([ordered]@{ at = [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds(); members = $members })\n        Start-Sleep -Seconds 3\n    }\n    $instance.WaitForExit()\n    if ($instance.ExitCode -ne 0) { throw \"Native desktop probe exited with $($instance.ExitCode)\" }\n} finally {\n    if (!$instance.HasExited) { Stop-Process -Id $instance.Id }\n    [ordered]@{ binarySha256 = (Get-FileHash $Binary -Algorithm SHA256).Hash.ToLowerInvariant()\n        launchUnixMs = $start; loaded = $loaded; phaseSeconds = $PhaseSeconds; samples = $samples.ToArray()\n    } | ConvertTo-Json -Depth 6 | Set-Content -Encoding UTF8 \"$Evidence/process-samples.json\"\n}\n","exit_code":1,"duration":{"secs":0,"nanos":10125}},"started_at_ms":1795408369891,"completed_at_ms":1795408369891}}
