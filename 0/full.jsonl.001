outes,\n// post-office introductions, private authenticated routes or arbitrary history.\nfn known_discovery_targets(roster: &Roster, port: u16) -> Vec<SocketAddr> {\n    roster\n        .peers()\n        .into_iter()\n        .flat_map(|peer| peer.routes)\n        .filter(|route| {\n            matches!(\n                route.source,\n                crate::discovery::roster::RouteSource::Lan\n                    | crate::discovery::roster::RouteSource::Discovery\n            )\n        })\n        .filter_map(|route| match route.addr.ip() {\n            IpAddr::V4(ip) => Some(SocketAddr::new(ip.into(), port)),\n            IpAddr::V6(_) => None,\n        })\n        .collect::<BTreeSet<_>>()\n        .into_iter()\n        .collect()\n}\n\nasync fn send_known_keepalives(\n    socket: &UdpSocket,\n    bytes: &[u8],\n    targets: &[SocketAddr],\n    visibility: &DiscoveryVisibility,\n    cursor: &mut usize,\n    remaining: &mut usize,\n) -> bool {\n    if targets.is_empty() {\n        *cursor = 0;\n        *remaining = 0;\n        return true;\n    }\n    let start = *cursor % targets.len();\n    if *remaining == 0 || *remaining > targets.len() {\n        *remaining = targets.len();\n    }\n    let count = *remaining;\n    let mut visited = 0;\n    let _ = tokio::time::timeout(SCAN_SWEEP_BUDGET, async {\n        for offset in 0..count {\n            if offset != 0 && offset % KNOWN_READY_BATCH == 0 {\n                tokio::task::yield_now().await;\n            }\n            let target = targets[(start + offset) % targets.len()];\n            visited += 1;\n            if matches!(\n                visibility.send_announce(socket, bytes, target).await,\n                Ok(false)\n            ) && !visibility.is_public().await\n            {\n                return;\n            }\n        }\n    })\n    .await;\n721:                    send_known_keepalives(\n800:async fn send_known_keepalives(\n1481:    async fn idle_discovery_restoration_with_empty_roster_wakes_unknown_scan() {\n1544:            send_known_keepalives(\n    if_addrs::get_if_addrs()\n        .unwrap_or_default()\n        .into_iter()\n        .filter(|iface| !iface.is_loopback() && physical_name(&iface.name, iface.is_p2p))\n        .filter_map(|iface| match iface.addr {\n            if_addrs::IfAddr::V4(addr) if !overlay(addr.ip) && addr.prefixlen > 0 => {\n                Some(LanInterface {\n                    address: addr.ip.into(),\n                    prefix: addr.prefixlen,\n                    index: iface.index,\n                })\n            }\n            if_addrs::IfAddr::V6(addr) if addr.ip.is_unicast_link_local() => Some(LanInterface {\n                address: addr.ip.into(),\n                prefix: addr.prefixlen,\n                index: iface.index,\n            }),\n            _ => None,\n        })\n        .collect()\n}\n\nfn overlay(ip: Ipv4Addr) -> bool {\n    let [a, b, _, _] = ip.octets();\n    a == 100 && (64..128).contains(&b)\n}\n\npub(crate) fn permits(interfaces: &[LanInterface], target: SocketAddr) -> bool {\n    let target = match target {\n        SocketAddr::V6(addr) => addr\n","exit_code":0,"duration":{"secs":0,"nanos":11084}},"started_at_ms":1795407798027,"completed_at_ms":1795407798027}}
