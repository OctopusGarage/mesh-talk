Visibility() {\n  if (!isTauri()) return;\n  let active = true;\n  let seenEvent = false;\n  const update = (value: boolean) => {\n    if (!active || minimized === value) return;\n    minimized = value;\n    for (const observer of observers) observer();\n  };\n  const subscription = listen<boolean>(\n    \"main-window-minimized\",\n    ({ payload }) => {\n      seenEvent = true;\n      update(payload);\n    },\n  );\n  void subscription\n    .then(async () => {\n      if (!active || seenEvent) return;\n      const current = await getCurrentWindow().isMinimized();\n      if (!seenEvent) update(current);\n    })\n    .catch(() => {});\n  return () => {\n    active = false;\n    void subscription.then((unlisten) => unlisten()).catch(() => {});\n  };\n}\nimport { afterEach, beforeEach, expect, it, vi } from \"vitest\";\nimport { startRecoveryRefresh, RECOVERY_REFRESH_MS } from \"./recoveryRefresh\";\nlet stop: (() => void) | undefined;\nlet events: EventTarget;\nlet page: EventTarget & { visibilityState: string };\nbeforeEach(() => {\n  vi.useFakeTimers();\n  events = new EventTarget();\n  page = Object.assign(new EventTarget(), { visibilityState: \"visible\" });\n  vi.stubGlobal(\"window\", events);\n  vi.stubGlobal(\"document\", page);\n});\nafterEach(() => {\n  stop?.();\n  stop = undefined;\n  vi.unstubAllGlobals();\n  vi.useRealTimers();\n});\nit(\"does no eager work, coalesces activation, and keeps a minute-scale recovery\", async () => {\n  const run = vi.fn();\n  stop = startRecoveryRefresh(run);\n  await vi.advanceTimersByTimeAsync(30_000);\n  expect(run).not.toHaveBeenCalled();\n  events.dispatchEvent(new Event(\"focus\"));\n  page.dispatchEvent(new Event(\"visibilitychange\"));\n  await vi.advanceTimersByTimeAsync(0);\n  expect(run).toHaveBeenCalledOnce();\n  await vi.advanceTimersByTimeAsync(RECOVERY_REFRESH_MS);\n  expect(run).toHaveBeenCalledTimes(2);\n});\nit(\"retires queued activation, fallback, and listeners with the owner\", async () => {\n  const run = vi.fn();\n  stop = startRecoveryRefresh(run);\n  events.dispatchEvent(new Event(\"focus\"));\n  stop();\n  page.dispatchEvent(new Event(\"visibilitychange\"));\n  await vi.advanceTimersByTimeAsync(RECOVERY_REFRESH_MS * 2);\n  expect(run).not.toHaveBeenCalled();\n  expect(vi.getTimerCount()).toBe(0);\n});\nit(\"parks presentation-only recovery while hidden and refreshes on return\", async () => {\n  const run = vi.fn();\n  stop = startRecoveryRefresh(run, { background: false });\n  page.visibilityState = \"hidden\";\n  page.dispatchEvent(new Event(\"visibilitychange\"));\n  await vi.advanceTimersByTimeAsync(RECOVERY_REFRESH_MS * 2);\n  expect(run).not.toHaveBeenCalled();\n  expect(vi.getTimerCount()).toBe(0);\n  page.visibilityState = \"visible\";\n  page.dispatchEvent(new Event(\"visibilitychange\"));\n  await vi.advanceTimersByTimeAsync(0);\n  expect(run).toHaveBeenCalledOnce();\n});\nit(\"retains durable reconciliation recovery while hidden\", async () => {\n  const run = vi.fn();\n  page.visibilityState = \"hidden\";\n  stop = startRecoveryRefresh(run);\n  events.dispatchEvent(new Event(\"focus\"));\n  await vi.advanceTimersByTimeAsync(RECOVERY_REFRESH_MS);\n  expect(run).toHaveBeenCalledOnce();\n});\n\nit(\"supports foreground-only recovery with no periodic timer\", async () => {\n  const run = vi.fn();\n  stop = startRecoveryRefresh(run, { intervalMs: null });\n  await vi.advanceTimersByTimeAsync(RECOVERY_REFRESH_MS * 2);\n  expect(run).not.toHaveBeenCalled();\n  expect(vi.getTimerCount()).toBe(0);\n  page.visibilityState = \"hidden\";\n  page.dispatchEvent(new Event(\"visibilitychange\"));\n  await vi.advanceTimersByTimeAsync(0);\n  expect(run).not.toHaveBeenCalled();\n  page.visibilityState = \"visible\";\n  page.dispatchEvent(new Event(\"visibilitychange\"));\n  events.dispatchEvent(new Event(\"focus\"));\n  await vi.advanceTimersByTimeAsync(0);\n  expect(run).toHaveBeenCalledOnce();\n  stop();\n  events.dispatchEvent(new Event(\"focus\"));\n  await vi.advanceTimersByTimeAsync(RECOVERY_REFRESH_MS);\n  expect(run).toHaveBeenCalledOnce();\n});\n1432:    const wakeReception = () => {\n1489:        wakeReception();\n1523:    const stopRosterRecovery = startRecoveryRefresh(\n1526:        wakeReception();\n1646:        if (matchesRuntime(scope)) wakeReception();\n1752:      stopRosterRecovery();\n1243:        \"frontend/src/lib/recoveryRefresh.ts\",\n1244:        \"frontend/src/lib/recoveryRefresh.test.ts\",\n1267:        \"src/lib/recoveryRefresh.test.ts\",\n10:## Choose the right kind of signal\n16:| Runtime observation | Current state or a bounded transient signal from an active owner | Scope to the installed runtime and define how missed signals are handled. | Network cost, transfer progress, call signaling |\n29:| Runtime startup readiness | The Host installs an authenticated runtime and sends the existing scoped reception wake. | The [renderer boot owner](../frontend/src/store/chat.ts) coalesces the wake for its active startup request and re-reads native identity. An earlier hint can accelerate the read. The repair timer covers missing hints, and current desktop identity still gates readiness. |\n34:| Call signaling, audio and media | Call signaling is transient and separately bounded. Device and media callbacks describe active resources. | Use [node event registration](../frontend/src/lib/events.ts), the [call owner](../frontend/src/store/calls.ts) and native browser media callbacks. Stop tracks, sounds and listeners when their call or interaction retires. |\n148:already signals the relevant state and whether the listener can reconstruct\n154:Start with redundant observation work such as a timer that only checks an\n","exit_code":0,"duration":{"secs":0,"nanos":10750}},"started_at_ms":1795415045969,"completed_at_ms":1795415045969}}
