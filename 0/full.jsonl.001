n\nfn phase(app: &tauri::AppHandle, name: &str, minimized: bool, interval: Duration) {\n    let handle = app.clone();\n    let (send, receive) = std::sync::mpsc::sync_channel(1);\n    app.run_on_main_thread(move || {\n        let window = handle.get_webview_window(\"main\").unwrap();\n        if minimized {\n            window.minimize().unwrap();\n        } else {\n            window.show().unwrap();\n            window.set_focus().unwrap();\n        }\n        send.send(()).unwrap();\n    })\n    .unwrap();\n    receive.recv_timeout(Duration::from_secs(5)).unwrap();\n    std::thread::sleep(Duration::from_secs(5));\n    let handle = app.clone();\n    let (send, receive) = std::sync::mpsc::sync_channel(1);\n    app.run_on_main_thread(move || {\n        let window = handle.get_webview_window(\"main\").unwrap();\n        send.send((window.is_minimized().unwrap(), window.is_focused().unwrap()))\n            .unwrap();\n    })\n    .unwrap();\n    let (actual_minimized, focused) = receive.recv_timeout(Duration::from_secs(5)).unwrap();\n[13/16] [chromium] › e2e/person-presence.spec.ts:639:1 › pure LAN presence expires promptly without a long network-quality notice\n[14/16] [chromium] › e2e/person-presence.spec.ts:683:1 › a fresh LAN observation clears the routed slow hint without a thirty-second wait\n[15/16] [chromium] › e2e/resource-idle.spec.ts:4:1 › roster reception updates presence without reloading unrelated state\n[16/16] [chromium] › e2e/resource-idle.spec.ts:211:3 › live date display › date display cache follows live timezone, midnight, and locale changes\n  16 passed (1.4m)\n1795415989\n","exit_code":0,"duration":{"secs":0,"nanos":25682542}},"started_at_ms":1795415989032,"completed_at_ms":1795415989058}}
