eturnType<typeof setTimeout> | undefined;\n  const visible = () =>\n    typeof document === \"undefined\" || document.visibilityState !== \"hidden\";\n  const arm = () => {\n    if (timer !== undefined) clearTimeout(timer);\n    timer = undefined;\n    if (!active || intervalMs === null || (!background && !visible())) return;\n    timer = setTimeout(\n      () => {\n        timer = undefined;\n        arm();\n        if (active) refresh();\n      },\n      Math.max(1, intervalMs()),\n    );\n  };\n  const activate = () => {\n    arm();\n    if (!active || !visible() || queued) return;\n    queued = true;\n    queueMicrotask(() => {\n      queued = false;\n      if (active && visible()) refresh();\n    });\n  };\n  const host = typeof window === \"undefined\" ? undefined : window;\n  const page = typeof document === \"undefined\" ? undefined : document;\n  host?.addEventListener?.(\"focus\", activate);\n  page?.addEventListener?.(\"visibilitychange\", activate);\n  arm();\n  return () => {\n    active = false;\n    if (timer !== undefined) clearTimeout(timer);\n    host?.removeEventListener?.(\"focus\", activate);\n    page?.removeEventListener?.(\"visibilitychange\", activate);\n  };\n}\n","exit_code":0,"duration":{"secs":0,"nanos":11541}},"started_at_ms":1795408562684,"completed_at_ms":1795408562685}}
