hange your\n * photo and name). Avatar editing reuses {@link AvatarEditMenu}; the name is edited inline\n * via `useAuth.rename`. The login username and account id are shown read-only — they're the\n * stable identity, only the display name (nickname) and photo are editable.\n */\nexport function ProfileDialog({\n  open,\n  onOpenChange,\n}: {\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n}) {\n  const { t } = useTranslation();\n  const user = useAuth((s) => s.user);\n  const rename = useAuth((s) => s.rename);\n  const myId = useChat((s) => s.myId);\n  const myAccountId = useChat((s) => s.myAccountId);\n\n  const username = user?.username ?? \"\";\n  const displayName = user?.display_name || username;\n  // Same seed the sidebar uses, so the photo/glyph matches everywhere.\n  const seed = myAccountId || myId || username;\n\n  const [editing, setEditing] = useState(false);\n  const [draft, setDraft] = useState(displayName);\n  const [busy, setBusy] = useState(false);\n\n  // Seed the draft when (re)opening, and drop back to read-only when the stored name changes.\n  useEffect(() => {\n    if (open) {\n      setDraft(displayName);\n      setEditing(false);\n    }\n  }, [open, displayName]);\n\n  const save = async () => {\n133:  const [profileOpen, setProfileOpen] = useState(false);\n168:  const [offlineOpen, setOfflineOpen] = useState(false);\n271:        <ProfileDialog open={profileOpen} onOpenChange={setProfileOpen} />\n429:            onClick={() => setOfflineOpen(true)}\n449:        open={offlineOpen}\n450:        onOpenChange={setOfflineOpen}\n458:          onClick={() => setProfileOpen(true)}\nfrontend/e2e/privacy.spec.ts:91:    page.getByTestId(\"open-profile\").locator('[role=\"status\"]'),\nfrontend/e2e/privacy.spec.ts:99:    .getByTestId(\"open-profile\")\nfrontend/e2e/privacy.spec.ts:206:    .getByTestId(\"open-profile\")\nfrontend/e2e/site-capture.spec.ts:177:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/avatar-gallery.s