uses, so the photo/glyph matches everywhere.\n  const seed = myAccountId || myId || username;\n\n  const [editing, setEditing] = useState(false);\n  const [draft, setDraft] = useState(displayName);\n  const [busy, setBusy] = useState(false);\n\n  // Seed the draft when (re)opening, and drop back to read-only when the stored name changes.\n  useEffect(() => {\n    if (open) {\n      setDraft(displayName);\n      setEditing(false);\n    }\n  }, [open, displayName]);\n\n  const save = async () => {\n133:  const [profileOpen, setProfileOpen] = useState(false);\n168:  const [offlineOpen, setOfflineOpen] = useState(false);\n271:        <ProfileDialog open={profileOpen} onOpenChange={setProfileOpen} />\n429:            onClick={() => setOfflineOpen(true)}\n449:        open={offlineOpen}\n450:        onOpenChange={setOfflineOpen}\n458:          onClick={() => setProfileOpen(true)}\nfrontend/e2e/privacy.spec.ts:91:    page.getByTestId(\"open-profile\").locator('[role=\"status\"]'),\nfrontend/e2e/privacy.spec.ts:99:    .getByTestId(\"open-profile\")\nfrontend/e2e/privacy.spec.ts:206:    .getByTestId(\"open-profile\")\nfrontend/e2e/site-capture.spec.ts:177:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/avatar-gallery.spec.ts:20:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/avatar-gallery.spec.ts:34:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/avatar-gallery.spec.ts:50:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/avatar-gallery-loading.spec.ts:10:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/avatar-gallery-loading.spec.ts:35:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/break-ui.spec.ts:44:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/break-ui.spec.ts:321:  const dialog = page.getByTestId(\"offline-connect-dialog\");\nfrontend/e2e/break-ui.spec.ts:324:  await expectDialogFitsViewport(page, \"offline-connect-dialog\");\nfrontend/e2e/ui-audit-dialogs.spec.ts:97:      open: async () => page.getByTestId(\"open-profile\").click(),\nfrontend/e2e/avatar-preset-bg.spec.ts:18:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/avatar-preset-bg.spec.ts:28:          '[data-testid=\"open-profile\"] img',\nfrontend/e2e/packs.spec.ts:118:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/packs.spec.ts:178:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/packs.spec.ts:214:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/packs.spec.ts:247:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/packs.spec.ts:284:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/packs.spec.ts:318:  await page.getByTestId(\"open-profile\").click();\nfrontend/e2e/avatar-crop.spec.ts:22:  await page.getByTestId(\"open-profile\").click();\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a206b6-3b34-7250-82bb-aa5f75f34df5","create_time":1795408993.446675}},"metadata":{"history_sequence":14984,"sampled_through_sequence":14981,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
