valMs === null || (!background && !visible())) return;\n    timer = setTimeout(\n      () => {\n        timer = undefined;\n        arm();\n        if (active) refresh();\n      },\n      Math.max(1, intervalMs()),\n    );\n  };\n  const activate = () => {\n    arm();\n    if (!active || !visible() || queued) return;\n    queued = true;\n    queueMicrotask(() => {\n      queued = false;\n      if (active && visible()) refresh();\n    });\n  };\n  const host = typeof window === \"undefined\" ? undefined : window;\n  const page = typeof document === \"undefined\" ? undefined : document;\n  host?.addEventListener?.(\"focus\", activate);\n  page?.addEventListener?.(\"visibilitychange\", activate);\n  arm();\n  return () => {\n    active = false;\n    if (timer !== undefined) clearTimeout(timer);\n    host?.removeEventListener?.(\"focus\", activate);\n    page?.removeEventListener?.(\"visibilitychange\", activate);\n  };\n}\n   Compiling mesh-talk-core v0.4.6 (/Users/kingsonwu/programming/OctopusGarage/mesh-talk/tmp/req-011/native-proof-gated.KeJDPGsv/crates/mesh-talk-core)\n   Compiling mesh-talk-integrations v0.4.6 (/Users/kingsonwu/programming/OctopusGarage/mesh-talk/tmp/req-011/native-proof-gated.KeJDPGsv/crates/mesh-talk-integrations)\n   Compiling mesh-talk v0.4.6 (/Users/kingsonwu/programming/OctopusGarage/mesh-talk/tmp/req-011/native-proof-gated.KeJDPGsv/src-tauri)\nlaunch-reception-window-state.ps1\nnative.log\nrun-reception-window-state.ps1\nsample-reference-desktop.ps1\n","exit_code":0,"duration":{"secs":0,"nanos":11000}},"started_at_ms":1795415031758,"completed_at_ms":1795415031758}}
