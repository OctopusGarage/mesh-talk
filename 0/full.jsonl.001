ta[channel.channel_id] ?? {\n                cover: null,\n                announcement: null,\n                announcement_history: [],\n              },\n            })),\n          // The test user (SELF) is the channel owner, so the member-management controls\n          // (add/remove) stay visible to the existing e2e flow.\n          channel_members: (a) => ({\n            history_policy:\n              channelHistoryPolicies[String(a.channelId)] ??\n              \"last_ten_within_three_days\",\n            owner: channelOwner,\n            members: channelMembers.map((member) => ({\n              ...member,\n              account_id: memberAccount(member.user_id) ?? null,\n            })),\n          }),\n          channel_activity: () => [],\n\n          // history\n          history: (a) => msgs[`dm:${a.peer}`] ?? [],\n          account_history: (a) => msgs[`acc:${a.account}`] ?? [],\n          channel_history: (a) => {\n            const history =\n              dataMode === \"invite\" ? [] : (msgs[`ch:${a.channelId}`] ?? []);\n            return dataMode === \"group-reception-window\"\n              ? history.slice(-Number(a.limit ?? 200))\n              : history;\n          },\n\n          // reactions\n          owner_reaction_summaries: (a) => {\n    \"note_activity\",\n    \"set_call_active\",\n  ]) {\n    expect(after[command] ?? 0, command).toBe(before[command] ?? 0);\n  }\n  // Exercise the same acknowledged reception path for qualified local changes.\n  for (const kind of [\"sync_status\", \"documents\"] as const) {\n    const narrowBefore = (await snapshot()).counts;\n    await page.evaluate((kind) => {\n      (\n        window as unknown as {\n          __resourceProbe: {\n            wake: (kind: \"sync_status\" | \"documents\") => void;\n          };\n        }\n      ).__resourceProbe.wake(kind);\n    }, kind);\n    await expect\n      .poll(async () => (await snapshot()).counts.owner_reception_ack ?? 0)\n      .toBeGreaterThan(narrowBefore.owner_reception_ack ?? 0);\n    if (kind === \"documents\") {\n      await expect\n        .poll(\n          async () => (await snapshot()).counts.load_conversation_drafts ?? 0,\n        )\n        .toBeGreaterThan(narrowBefore.load_conversation_drafts ?? 0);\n    }\n    await expect.poll(async () => (await snapshot()).pending).toBe(0);\n    await page.evaluate(\n      () => new Promise<void>((done) => requestAnimationFrame(() => done())),\n    );\n    await expect.poll(async () => (await snapshot()).pending).toBe(0);\n    const narrowAfter = (await snapshot()).counts;\n    for (const command of [\n      \"list_channels\",\n      \"channel_members\",\n      \"owner_personal_conversation_states\",\n    ]) {\n      expect(narrowAfter[command] ?? 0, `${kind}: ${command}`).toBe(\n        narrowBefore[command] ?? 0,\n      );\n    }\n    if (kind === \"sync_status\") {\n      for (const command of [\n        \"get_account_documents\",\n        \"load_conversation_drafts\",\n      ]) {\n        expect(narrowAfter[command] ?? 0, `${kind}: ${command}`).toBe(\n          narrowBefore[command] ?? 0,\n        );\n      }\n    }\n  }\n  await page.evaluate(() => {\n    (\n      window as unknown as {\n        __resourceProbe: { wake: (kind: \"state\") => void };\n      }\n    ).__resourceProbe.wake(\"state\");\n  });\n  await expect\n                    file_incoming,\n                }),\n                Some((incoming_rx, channel_rx, file_rx)),\n            )\n        } else {\n            (None, None)\n        };\n        // Opening the node runs several more password KDFs (one per durable store). Offload\n        // to the blocking pool so it doesn't monopolize a tokio worker during cold start;\n        // `open_with_account` internally parallelizes those KDFs across scoped threads, so\n        // the behavior (and result) is identical — just off the reactor.\n        // Open the durable name directory in parallel with the node (its own password KDF),\n        // so it doesn't add a serial step to cold start.\n        let (node, names) = {\n            let roster = Arc::clone(&roster);\n            let messages_log = dir.join(\"messages.log\");\n            let sent_log = dir.join(\"sent.log\");\n            let names_path = dir.join(\"names.log\");\n            let password = password.to_string();\n            let initial_display_name = display_name.to_owned();\n            let permit = startup_work.admit().expect(\"startup root admitted\");\n            permit\n                .spawn_blocking(move || {\n                    let storage =\n                        crate::storage::profile::context::ProfileStorage::open_participant(\n                            lease,\n                            &identity.public(),\n                            &account.public(),\n                            &messages_log,\n                            &sent_log,\n                            REDACTED,\n                        )?;\n                    observe_phase(\"encrypted_database_opened\");\n                    // Scoped children finish before this owner can return or unwind.\n                    // Both results are joined before either failure is propagated.\n                    let (node, names) = std::thread::scope(|scope| {\n                        let names_storage = storage.clone();\n                        let names_password = REDACTED;\n                        let names = scope.spawn(move || {\n                            #[cfg(test)]\n                            if let Some(hook) = NAMES_OPEN_HOOKS.lock().unwrap().remove(&names_path)\n        let account_access_updates =\n            tokio::sync::watch::channel(account_access.current(&account.account_id())).0;\n        observe_phase(\"independent_account_journals_opened\");\n        let reaction_path =\n            log_path.with_extension(format!(\"{}-reactions.log\", account.account_id()));\n        super::reaction_store::IndexedReactionStore::authenticate_legacy(\n            &storage,\n  