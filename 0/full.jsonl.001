{"timestamp":"2026-11-23T06:33:28.695Z","ordinal":38167,"type":"token_usage_record","payload":{"thread_id":"01a1feaf-24d9-7612-a284-664abd64a2c4","turn_id":"01a2071b-f154-7d32-9f9e-0e317d2f6eed","session_id":"01a1feaf-24d9-7612-a284-664abd64a2c4","root_turn_id":"01a2071b-f154-7d32-9f9e-0e317d2f6eed","response_id":"resp_0dca4931a04d8132016b03de32d97c87d0b9bdad46855f7bf0","usage":{"input_tokens":149906,"cached_input_tokens":148352,"cache_write_input_tokens":0,"output_tokens":183,"reasoning_output_tokens":0,"total_tokens":150089},"turn_token_usage":{"input_tokens":149906,"cached_input_tokens":148352,"cache_write_input_tokens":0,"output_tokens":183,"reasoning_output_tokens":0,"total_tokens":150089},"thread_token_usage":{"input_tokens":1372000423,"cached_input_tokens":1366365824,"cache_write_input_tokens":0,"output_tokens":1197998,"reasoning_output_tokens":311693,"total_tokens":1373198421}}}
{"timestamp":"2026-11-23T06:33:28.753Z","ordinal":38168,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1feaf-24d9-7612-a284-664abd64a2c4","turn_id":"01a2071b-f154-7d32-9f9e-0e317d2f6eed","item":{"type":"CommandExecution","id":"exec-f077c7e6-77ee-43b8-afac-8df137957e50","process_id":"29396","command":["/bin/zsh","-lc","date +%s; tail -5 tmp/req-011/channel-access-native-build.log\nd=$(cat tmp/req-011/linux-relay-loaded-path); tail -7 \"$d/build.log\"; ls \"$d\"\ne=$(cat tmp/req-011/linux-relay-empty-path); ls \"$e\"\nw=$(cat tmp/req-011/windows-native-minimize-path); h=$(cat \"$w/minimized-isolated-path\"); jq 'keys' \"$h/process-samples.json\"; sed -n '13,64p' tmp/req-011/desktop-phase-summary.py"],"cwd":"file:///Users/kingsonwu/programming/OctopusGarage/mesh-talk","parsed_cmd":[{"type":"unknown","cmd":"date +%s; tail -5 tmp/req-011/channel-access-native-build.log\nd=$(cat tmp/req-011/linux-relay-loaded-path); tail -7 \"$d/build.log\"; ls \"$d\"\ne=$(cat tmp/req-011/linux-relay-empty-path); ls \"$e\"\nw=$(cat tmp/req-011/windows-native-minimize-path); h=$(cat \"$w/minimized-isolated-path\"); jq 'keys' \"$h/process-samples.json\"; sed -n '13,64p' tmp/req-011/desktop-phase-summary.py"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"1795415608\n   Compiling mesh-talk v0.4.6 (/Users/kingsonwu/programming/OctopusGarage/mesh-talk/src-tauri)\n    Blocking waiting for file lock on build directory\nbuild.log\n__pycache__\nmeasure.py\nnode.log\n[\n  \"binarySha256\",\n  \"launchUnixMs\",\n  \"loaded\",\n  \"phaseSeconds\",\n  \"samples\"\n]\n    for phase, edge, value in MARKER.findall(log):\n        key = phase, edge\n        if key in markers:\n            raise ValueError(f\"duplicate marker {key}\")\n        markers[key] = float(value)\n    summaries = {}\n    for phase, cpu_limit in CPU_LIMITS.items():\n        start, stop = (markers[phase, edge] for edge in (\"start\", \"end\"))\n        window = [\n            (row[\"at\"] / 1000, row[\"members\"])\n            for row in observations[\"samples\"]\n            if start + settle <= row[\"at\"] / 1000 < stop\n        ]\n        if len(window) < 2 or window[-1][0] - window[0][0] < min_seconds:\n            raise ValueError(f\"incomplete measurement window: {phase}\")\n        identity = lambda item: (item[\"pid\"], item[\"start\"], item[\"role\"])\n        first = {identity(item): item for item in window[0][1]}\n        roles = {key[2] for key in first}\n        if not {\"host\", \"renderer\"} <= roles:\n            raise ValueError(f\"desktop family is missing its host or renderer: {phase}\")\n        previous = first\n        peak_private = peak_working_set = 0\n        for _, members in window:\n            samples = {identity(item): item for item in members}\n            if samples.keys() != first.keys():\n                raise ValueError(f\"desktop family changed during {phase}\")\n            if any(samples[key][\"cpuSeconds\"] < previous[key][\"cpuSeconds\"] for key in samples):\n                raise ValueError(f\"CPU counter regressed during {phase}\")\n            previous = samples\n            peak_private = max(peak_private, sum(item[\"privateBytes\"] for item in members))\n            peak_working_set = max(peak_working_set, sum(item[\"workingSetBytes\"] for item in members))\n        seconds = window[-1][0] - window[0][0]\n        by_role = {\n            role: 100 * sum(previous[key][\"cpuSeconds\"] - first[key][\"cpuSeconds\"]\n                            for key in first if key[2] == role) / seconds\n            for role in sorted(roles)\n        }\n        cpu = sum(by_role.values())\n        summaries[phase] = {\n            \"seconds\": seconds, \"samples\": len(window),\n            \"cpuPercentOneCore\": cpu, \"cpuPercentOneCoreByRole\": by_role,\n            \"peakPrivateBytes\": peak_private, \"peakWorkingSetBytes\": peak_working_set,\n            \"cpuWithinBudget\": cpu <= cpu_limit,\n        }\n    return {\n        \"binarySha256\": observations[\"binarySha256\"],\n        \"loaded\": observations[\"loaded\"],\n        \"phases\": summaries,\n    }\n\n\ndef compare_memory(empty, loaded):\n","exit_code":0,"duration":{"secs":0,"nanos":11542}},"started_at_ms":1795415608753,"completed_at_ms":1795415608753}}
