{"timestamp":"2026-11-23T04:29:12.782Z","ordinal":34697,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a206aa-48ce-7610-b450-cd76a1c6a585","call_id":"call_6447e6b03fe0439ea9eca1103a9b4142","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"\n    fn post_office_drain_candidates(&self) -> Vec<PeerRecord> {\n        let candidates = {\n            let roster = self.roster.lock().expect(\"roster mutex not poisoned\");\n            self.post_office_candidates(&roster)\n        };\n        candidates\n            .into_iter()\n            .filter(|po| self.relay_receive_allowed(&po.public))\n            .collect()\n    }\n\n    /// Pull from every known post office. Mailboxes are relay-specific, so a\n    /// message accepted during failover may remain on the fallback relay after\n    /// the preferred one returns.\n    pub async fn drain_from_post_office(&self) {\n        if self.cached_peer_snapshot_async().await.is_err() {\n            log::warn!(\"verified discovery cache update failed\");\n        }\n        let post_offices = {\n            let roster = self.roster.lock().expect(\"roster mutex not poisoned\");\n            self.post_office_candidates(&roster)\n        };\n        use futures_util::stream::{self, StreamExt};\n        let peers = self.post_office_drain_peers();\n        if peers.is_empty() {\n            return;\n        }\n        let post_offices = self.relay_candidate_batch(\"drain:relays\", post_offices);\n        stream::iter(post_offices)\n            .for_each_concurrent(2, |po| {\n                let peers = &peers;\n                async move {\n                    self.drain_one_post_office(&po, peers).await;\n                }\n            })\n            .await;\n    }\n\n    fn post_office_drain_peers(&self) -> Vec<crate::discovery::Announce> {\n        let mut peers = self\n            .historical_dm_peers()\n            .into_iter()\n            .filter(|peer| self.verified_dm_pull_peer(&peer.public().user_id()))\n            .collect::<Vec<_>>();\n            changed\n        };\n        if changed {\n            self.clear_bridge_introductions();\n            self.storage.database().maintenance_waker().notify();\n        }\n        self.bridge_notify.notify_one();\n        self.delivery_notify.notify_one();\n        Ok(())\n    }\n\n    pub(in crate::node) fn post_office_candidates(&self, roster: &Roster) -> Vec<PeerRecord> {\n        let preferred = self\n            .bridge_hub_id\n            .lock()\n            .expect(\"bridge hub lock not poisoned\");\n        let mut candidates = post_office_candidates(roster, preferred.as_deref());\n        self.rank_relay_candidates(&mut candidates, preferred.as_deref(), None);\n        candidates\n    }\n\n    pub(in crate::node) fn post_office_candidates_for(\n        &self,\n        roster: &Roster,\n        recipient: &PublicIdentity,\n    ) -> Vec<PeerRecord> {\n        let preferred = self\n            .bridge_hub_id\n            .lock()\n            .expect(\"bridge hub lock not poisoned\");\n        let mut candidates = post_office_candidates_for(roster, preferred.as_deref(), recipient);\n        self.rank_relay_candidates(\n            &mut candidates,\n                .lock()\n                .expect(\"verified DM pull mutex not poisoned\");\n            if *current == next {\n                return;\n            }\n            *current = next;\n            self.delivery_demand_generation\n                .fetch_add(1, Ordering::Release);\n        }\n        self.delivery_notify.notify_one();\n        self.post_office_receive_notify.notify_one();\n    }\n\n    pub(in crate::node) fn verified_dm_pull_peer(&self, fingerprint: &str) -> bool {\n        self.verified_dm_pull_peers\n            .lock()\n            .expect(\"verified DM pull mutex not poisoned\")\n            .contains(fingerprint)\n            || (self.bridge_directory_allowed()\n                && self\n                    .bridge_dm_pull_peers\n                    .lock()\n                    .expect(\"bridge DM pull mutex not poisoned\")\n                    .get(fingerprint)\n                    .is_some_and(|seen| seen.elapsed() < std::time::Duration::from_secs(45)))\n    }\n\n    /// Authorize one immutable outgoing journal entry, then attempt local replay.\n    /// Once the journal accepts it, replay failure must not become a retryable send.\n    /// Call only after durable acceptance of new work, never after an unchanged\n    /// projection, successful poll or ordinary completion notification.\n    pub(in crate::node) fn note_delivery_demand(&self) {\n        self.delivery_demand_generation\n            .fetch_add(1, Ordering::Release);\n        self.delivery_notify.notify_one();\n    }\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a206a9-86fc-7b12-81b3-f3175b996b47","create_time":1795408152.782856}},"metadata":{"history_sequence":14738,"sampled_through_sequence":14736,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
