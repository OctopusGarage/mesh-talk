{"timestamp":"2026-11-23T06:49:14.604Z","ordinal":38818,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1feaf-24d9-7612-a284-664abd64a2c4","turn_id":"01a2072a-086e-78e0-8da1-f589cfa367ae","item":{"type":"CommandExecution","id":"exec-d21d7328-a14d-41b9-8f28-3b4113b600b5","process_id":"40655","command":["/bin/zsh","-lc","sed -n '2012,2040p;2075,2105p' crates/mesh-talk-core/src/node/serving.rs\nsed -n '1814,1845p;1874,1901p' crates/mesh-talk-core/src/node/delivery_runtime.rs\nsed -n '110,142p' crates/mesh-talk-core/src/node/channel/checkpoint/recall.rs\nsed -n '1388,1432p' src-tauri/src/runtime_bootstrap.rs"],"cwd":"file:///Users/kingsonwu/programming/OctopusGarage/mesh-talk","parsed_cmd":[{"type":"read","cmd":"sed -n '110,142p' crates/mesh-talk-core/src/node/channel/checkpoint/recall.rs","name":"recall.rs","path":"crates/mesh-talk-core/src/node/channel/checkpoint/recall.rs"},{"type":"read","cmd":"sed -n '1388,1432p' src-tauri/src/runtime_bootstrap.rs","name":"runtime_bootstrap.rs","path":"src-tauri/src/runtime_bootstrap.rs"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"                    plaintext: candidate.plaintext().to_vec(),\n                };\n                let metadata = ReceptionMetadata {\n                    from_device: entry.from.clone(),\n                    received_at: super::node::now_millis(),\n                    arrival_kind: arrival,\n                    own_device: own,\n                    batch_id: None,\n                    batch_complete: true,\n                    batch_size: 1,\n                    reception_only: false,\n                };\n                let committed = self.channel_checkpoints.commit_reception(\n                    &candidate,\n                    &mut self.received.lock().expect(\"received lock\"),\n                    &entry,\n                    metadata,\n                    !suppressed && !expired,\n                )?;\n                if let Some(metadata) = committed {\n                    self.note_reception_change();\n                    #[cfg(test)]\n                    published.ids.push(entry.event_id);\n                    if !own && entry.from != self.user_id() {\n                        self.note_account_local_change();\n                    }\n                    if !pre_open && self.channel_incoming.is_legacy() {\n                        if metadata.batch_id.is_some() {\n                            pending.lanes.entry(conv).or_default().legacy_batch_visible = true;\n            }\n            if !turn.more_work {\n                break;\n            }\n            if budget.exhausted() {\n                let lane = pending.lanes.entry(conv).or_default();\n                lane.continuation = Some(arrival);\n                lane.retry_at = None;\n                self.channel_recovery_notify.notify_one();\n                return Ok(());\n            }\n        }\n        if budget.spent() {\n            pending.lanes.entry(conv).or_default().continuation = Some(arrival);\n            self.channel_recovery_notify.notify_one();\n            return Ok(());\n        }\n        if !self.process_join_history_reception(conv)? {\n            pending.lanes.entry(conv).or_default().continuation = Some(arrival);\n            return Ok(());\n        }\n        if let Some((event, metadata)) = self.channel_checkpoints.finish_batch(conv)? {\n            self.note_reception_change();\n            let visible =\n                std::mem::take(&mut pending.lanes.entry(conv).or_default().legacy_batch_visible);\n            if visible && self.channel_incoming.is_legacy() {\n                let _ = self\n                    .channel_incoming\n                    .send(super::channel::ReceivedChannelMessage {\n                        received_via: None,\n                        channel_id: conv,\n            }\n            if removed && let Some(channel) = control_channel {\n                // Finish short control tails after releasing projection guards.\n                // A larger tail keeps its existing runtime ticket without\n                // turning an installed effect into failed durable recovery.\n                // Terminal status never permits reading a stale projection.\n                #[cfg(test)]\n                recovery_phase(\"projection_begin\");\n                match self.prepare_channel_admission(channel, &mut control_budget) {\n                    Ok(()) | Err(LogError::StaleCursor) => {}\n                    Err(error) => return Err(error),\n                }\n                #[cfg(test)]\n                recovery_phase(\"projection_returned\");\n                self.account_sync_notify.notify_one();\n            }\n            if removed && wake_local {\n                self.note_account_local_change();\n            }\n            if removed && let Some((sender, original_conv, entry, file, incoming)) = notification {\n                self.note_account_history_change();\n                if file {\n                    if incoming {\n                        self.note_reception_change();\n                    }\n                    if let Some(manifest) = super::files::validated_manifest(&entry.plaintext) {\n                        self.remember_manifest_scope(\n                            manifest.file_conv(),\n                            original_conv,\n                            crate::eventlog::Author::from_ed25519(sender.ed25519_pub),\n                            entry.event_id,\n                        );\n                                    } else {\n                                        manifest.name().to_owned()\n                                    },\n                                    size: manifest.size(),\n                                    mime: manifest.mime().to_owned(),\n                                    file_conv: manifest.file_conv(),\n                                    media: super::media_store::manifest_is_media(&manifest),\n                                    event_id: logical,\n                                    authored_at: entry.wall_clock,\n                                    received_at: super::node::now_millis(),\n                                    arrival_kind: \"live\",\n                                    own_device: false,\n                                    batch_id: None,\n                                    batch_complete: true,\n                                    batch_size: 1,\n                                });\n                            }\n                        }\n                    }\n                } else {\n                    self.note_reception_change();\n                    let envelope = DmEnvelope::decode(&entry.plaintext);\n                    let inner = envelope\n                        .as_ref()\n                        .map_or(entry.plaintext.as_slice(), |env| env.body.as_slice());\n                    if self.recipient_expired(inner, entry.event_id, entry.wall_clock) {\n                        continue;\n                    }\n                    ReceivedStore::install_evidence_on(c, channel, id)?;\n                    c.execute(\n                        \"INSERT INTO channel_processed VALUES(?1,?2,5)\",\n                        params![channel.as_bytes().as_slice(), id.as_bytes().as_slice()],\n                    )?;\n                    c.execute(\n                        \"DELETE FROM channel_pending WHERE channel=?1 AND event=?2\",\n                        params![channel.as_bytes().as_slice(), id.as_bytes().as_slice()],\n                    )?;\n                    c.execute(\n                        \"DELETE FROM channel_recall_dependencies WHERE channel=?1 AND event=?2\",\n                        params![channel.as_bytes().as_slice(), id.as_bytes().as_slice()],\n                    )?;\n                    Ok(inserted)\n                })?;\n                recalls.note_committed(usize::from(inserted));\n                drop(recalls);\n                drop(received);\n                if inserted {\n                    let _ = self.channel_changes.send(channel);\n                    self.note_reception_change();\n                }\n            }\n            Ok((\n                self.channel_checkpoints.history_read_ready(channel)?,\n                worked,\n            ))\n        }\n    }\n}\n            let kind = event[\"kind\"].as_str().unwrap().to_owned();\n            events.send(kind.clone()).unwrap();\n            if kind == \"documents\" && injection.swap(false, Ordering::SeqCst) {\n                arrivals.send_modify(|current| {\n                    current.state += 1;\n                    current.sync_status += 1;\n                });\n            }\n        });\n        let (installed, ready) = tokio::sync::watch::channel(false);\n        let task = tokio::spawn(after_install(\n            ready,\n            forward_ui_changes(\n                app.handle().clone(),\n                authority.clone(),\n                \"account\".into(),\n                \"device\".into(),\n                observed,\n                receiver,\n            ),\n        ));\n        changes.send_replace(DesktopUiRevisions {\n            state: 1,\n            documents: 1,\n            sync_status: 1,\n            read_receipts: 1,\n        });\n        tokio::task::yield_now().await;\n        assert!(received.try_recv().is_err());\n        installed.send_replace(true);\n        let event = tokio::time::timeout(std::time::Duration::from_secs(2), received.recv())\n            .await\n            .unwrap()\n            .unwrap();\n        assert_eq!(event, \"state\");\n        assert!(received.try_recv().is_err());\n        changes.send_modify(|current| {\n            current.read_receipts += 1;\n            current.sync_status += 1;\n        });\n        for expected in [\"sync_status\", \"read_receipts\"] {\n            assert_eq!(\n                tokio::time::timeout(std::time::Duration::from_secs(2), received.recv())\n                    .await\n                    .unwrap()\n","exit_code":0,"duration":{"secs":0,"nanos":12458}},"started_at_ms":1795416554604,"completed_at_ms":1795416554604}}
