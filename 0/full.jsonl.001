{"timestamp":"2026-11-23T04:32:23.506Z","ordinal":34821,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a206ad-31d2-7712-9be6-60de5b7ba74b","call_id":"call_067c328589e340409ce9c9e4d30c65ef","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"/// Persist settings to disk (best-effort; logged on failure).\nfn save<R: tauri::Runtime>(app: &tauri::AppHandle<R>, value: &GlobalSettings) {\n    config_store::save(app, SETTINGS_FILE, \"settings\", value);\n}\n\n/// Persist `last_user` (the keychain account to auto-login next launch) into the\n/// managed state and to disk, preserving every other setting. Called by the login\n/// path so a successful sign-in records who to auto-unlock next time. Best-effort.\npub fn record_last_user<R: tauri::Runtime>(\n    app: &tauri::AppHandle<R>,\n    state: &SettingsState,\n    last_user: Option<String>,\n) -> bool {\n    let mut inner = state.0.lock().unwrap();\n    inner.global.last_user = last_user.clone();\n    inner.current.last_user = last_user;\n    #[cfg(test)]\n    let path = state\n        .2\n        .clone()\n        .or_else(|| config_store::config_path(app, SETTINGS_FILE));\n    #[cfg(not(test))]\n    let path = config_store::config_path(app, SETTINGS_FILE);\n    let Some(path) = path else {\n        log::warn!(\"No config directory: saved-login metadata not persisted\");\n        return false;\n    };\n    if let Err(error) = config_store::write_account(&path, &inner.global) {\n        log::warn!(\"Failed to persist saved-login metadata: {error}\");\n        return false;\n    }\n    true\n}\n\n/// Read the current two non-autostart toggles. (Launch-at-login is queried via\n/// the autostart plugin's `is_enabled` on the frontend.)\n#[tauri::command]\npub async fn get_app_settings(\n    app: tauri::State<'_, crate::state::AppState>,\n        if FAIL_LOCAL_CLEAR.lock().unwrap().remove(username) {\n            return Err(\"Injected directory sync failure after local removal\".into());\n        }\n        Ok(())\n    }\n    #[cfg(all(not(test), not(target_os = \"macos\")))]\n    {\n        let _ = username;\n        Ok(())\n    }\n}\n\n#[cfg(all(not(test), target_os = \"macos\"))]\npub fn clear(username: &str) {\n    // Local recovery is withdrawn before potentially interactive native cleanup.\n    if let Err(error) = clear_local(username) {\n        log::error!(\"Could not clear local saved login: {error}\");\n    }\n    macos::clear(username);\n}\n\n/// Automatic recovery cleans only the selected provider. Explicit sign-out clears all.\npub(crate) fn clear_with_policy(username: &str, verification: bool) -> Result<(), String> {\n    #[cfg(any(test, target_os = \"macos\"))]\n    if !verification {\n        return clear_local(username);\n    }\n    let _ = verification;\n    clear(username);\n    Ok(())\n}\n\n#[cfg(test)]\nstatic FAIL_LOCAL_CLEAR: std::sync::LazyLock<std::sync::Mutex<std::collections::HashSet<String>>> =\n    std::sync::LazyLock::new(Default::default);\n#[cfg(test)]\npub(crate) fn fail_local_clear_after_removal(username: &str) {\n    FAIL_LOCAL_CLEAR.lock().unwrap().insert(username.into());\n}\n    }\n\n    pub(in crate::node) fn group_departure_peer(&self, public: &PublicIdentity) -> bool {\n        let book = self.channels.lock().expect(\"channels lock not poisoned\");\n        book.departure_link(&self.user_id(), &public.user_id())\n    }\n    pub(in crate::node) fn known_account_allowed(&self, public: &PublicIdentity) -> bool {\n        let announce = self\n            .roster\n            .lock()\n            .expect(\"roster lock not poisoned\")\n            .announcement(public)\n            .cloned();\n        self.account_allowed(public, announce.as_ref())\n    }\n    pub(in crate::node) fn manifest_scopes(\n        &self,\n        file: crate::eventlog::ConversationId,\n    ) -> impl Iterator<Item = Result<ManifestScope, LogError>> + use<> {\n        let offers = self\n            .files\n            .lock()\n            .expect(\"files lock\")\n            .offers(Some(file), None)\n            .map(|offer| {\n                offer.map(|offer| ManifestScope {\n                    parent: offer.parent,\n                    author: offer.author,\n                    event: offer.event,\n                })\n            });\n                    msg: &bytes[HEADER..],\n                    aad: &associated_data(username),\n                },\n            )\n            .map_err(|_| error(\"credential authentication failed\"))?,\n    );\n    let password =\n        std::str::from_utf8(&plaintext).map_err(|_| error(\"invalid credential encoding\"))?;\n    Ok(Some(password.to_owned()))\n}\n\npub(super) fn clear(root: &Path, username: &str) -> Result<(), String> {\n    if !directory(root, false)? {\n        return Ok(());\n    }\n    let location = path(root, username);\n    if check_file(&location)? {\n        fs::remove_file(location).map_err(error)?;\n        sync_directory(root)?;\n    }\n    Ok(())\n}\n\nfn sync_directory(root: &Path) -> Result<(), String> {\n    #[cfg(unix)]\n    fs::File::open(root)\n        .and_then(|file| file.sync_all())\n        .map_err(error)?;\n    #[cfg(not(unix))]\n    let _ = root;\n    Ok(())\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn local_roundtrip_owner_binding_and_clear() {\n        let temp = tempfile::tempdir().unwrap();\n        let root = temp.path().join(\"sessions\");\n        assert_eq!(load(&root, \"alice\").unwrap(), None);\n        save(&root, \"alice\", \" password 🐙 \").unwrap();\n        assert_eq!(\n            load(&root, \"alice\").unwrap().as_deref(),\n            Some(\" password 🐙 \")\n        );\n        assert_eq!(load(&root, \"bob\").unwrap(), None);\n        std::fs::copy(path(&root, \"alice\"), path(&root, \"bob\")).unwrap();\n        assert!(load(&root, \"bob\").is_err());\n        clear(&root, \"alice\").unwrap();\n        assert_eq!(load(&root, \"alice\").unwrap(), None);\n        clear(&root, \"alice\").unwrap();\n    }\n\n    #[test]\n        CFBoolean::from(true).into_CFType(),\n    ));\n    Some(options)\n}\n\nfn clear_legacy(username: &str) {\n    let Ok(entry) = keyring::Entry::new(LEGACY_SERVICE, username) else {\n        return;\n    };\n    match entry.delete_credential() {\n        Ok(()) | Err(keyring::Error::NoEntry) => {}\n        Err(error) => log::warn!(\"failed to remove old saved-session credential: {error}\"),\n    }\n}\n\nfn clear_protected(username: &str) {\n    if let Some(options) = options(username) {\n        match delete_generic_password_options(options) {\n            Ok(()) => {}\n            Err(error) if error.code() == errSecItemNotFound => {}\n            Err(error) => log::warn!(\"failed to remove Touch ID credential: {error}\"),\n        }\n    }\n}\n\n/// Save the raw login password in the OS Keychain for the next launch.\npub fn save(username: &str, password: &str) -> bool {\n    save_to(&MacKeychain, username, password)\n            log::info!(\"Touch ID credential was not unlocked during migration: {error}\");\n            return None;\n        }\n    };\n    let password = String::from_utf8(bytes).ok()?;\n    save_to(store, username, &password);\n    Some(password)\n}\n\n/// Delete both the standard item and the biometric unlock item.\npub fn clear(username: &str) {\n    clear_protected(username);\n    clear_legacy(username);\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use security_framework::base::Error;\n    use security_framework_sys::base::errSecAuthFailed;\n    use std::cell::{Cell, RefCell};\n\n    struct FakeStore {\n        protected: RefCell<Option<Vec<u8>>>,\n        legacy: RefCell<Option<String>>,\n        deny_save: bool,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a206ac-a8d9-7182-994d-635dc5a22a05","create_time":1795408343.506448}},"metadata":{"history_sequence":14789,"sampled_through_sequence":14787,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
