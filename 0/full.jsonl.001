default_value_t = 30, value_parser = clap::value_parser!(u64).range(1..=90))]\\n        valid_days: u64,\\n    },\\n    /// Inspect public trust, optional membership validity, and attestation limits.\\n    Inspect {\\n        #[arg(long)]\\n        policy: PathBuf,\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20738-da76-71f0-a6a5-ff2872d505f7","create_time":1795417513.232075}},"metadata":{"history_sequence":16729,"sampled_through_sequence":16726,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
