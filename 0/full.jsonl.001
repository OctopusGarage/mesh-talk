er = self.0.lock().unwrap();\n        if inner.owner.as_deref() != Some(owner) {\n            return Err(CommandError::Authorization(\n                \"settings owner mismatch\".into(),\n            ));\n        }\n        Ok((inner.revision, inner.current.clone()))\n    }\n\n    fn needs_application(\n        &self,\n            .as_ref()\n            .map(|owner| (owner.clone(), inner.current.retention_days))\n    }\n    pub fn set(&self, value: AppSettings) {\n        let mut inner = self.0.lock().unwrap();\n        inner.revision += 1;\n        inner.global = GlobalSettings::from(&value);\n        inner.owner = None;\n        inner.current = value;\n    }\n\n    pub(crate) fn activate(&self, owner: &str) {\n        let path = config_store::account_path(&crate::data_dir(), owner, SETTINGS_FILE)\n            .expect(\"authenticated owner has a valid profile path\");\n        self.activate_at(owner, &path);\n    }\n\n    fn activate_at(&self, owner: &str, path: &std::path::Path) {\n        let account: AccountSettings = config_store::read_account(path);\n        let mut inner = self.0.lock().unwrap();\n        inner.revision += 1;\n        inner.current = account.with_global(&inner.global);\n        inner.owner = Some(owner.to_owned());\n        if let Some(socket_v6) = socket_v6.as_ref() {\n            tasks.push(spawn_routed_listener(\n                Arc::clone(socket_v6),\n                Arc::clone(&roster),\n                Arc::clone(&announce),\n                self_uid.clone(),\n                discovery_port,\n                Arc::clone(&visibility),\n                Arc::clone(&routed),\n            ));\n        }\n        let discovery_health = tasks.iter().map(JoinHandle::abort_handle).collect();\n        if let Some(source) = candidate_source {\n            let socket = Arc::clone(&socket);\n            let socket_v6 = socket_v6.clone();\n            let visibility = Arc::clone(&visibility);\n            let routed = Arc::clone(&routed);\n            let trigger = Arc::clone(&candidate_refresh);\n            // Subscribe before the first snapshot. Changes during source/probe\n            // work retain one follow-up instead of depending on a Notify waiter.\n            let mut network = node.network_changes.subscribe();\n            let mut disclosure = visibility.subscribe_changes();\n            let mut topology = source.subscribe_changes();\n            tasks.push(tokio::spawn(async move {\n                use futures_util::FutureExt;\n                let mut probes = tokio::time::interval(Duration::from_secs(5));\n                probes.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);\n                probes.tick().await; // Startup refresh already sends the first probes.\n                let mut refresh = true;\n                let mut refresh_at = tokio::time::Instant::now();\n                let mut hints = Vec::new();\n                loop {\n                    refresh |= trigger.notified().now_or_never().is_some()\n                        || network.has_changed().unwrap_or(false)\n                        || disclosure.has_changed().unwrap_or(false);\n                    if let Some(changes) = topology.as_ref() {\n                        match changes.has_changed() {\n149:pub fn config_path<R: tauri::Runtime>(\n206:/// account preferences. The archive is never loaded as an account's settings.\n   Compiling hyper-rustls v0.27.9\n   Compiling axum-core v0.5.6\n   Compiling tower-http v0.6.11\n   Compiling axum v0.8.9\n   Compiling mesh-talk-core v0.4.6 (/candidate/crates/mesh-talk-core)\n","exit_code":0,"duration":{"secs":0,"nanos":14208}},"started_at_ms":1795419109160,"completed_at_ms":1795419109161}}
