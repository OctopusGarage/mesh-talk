lled runtime owner\\\");\\n129:      owner: fixture.owner, account: fixture.firstContact, limit: 1,\\n133:    if (channels.length !== fixture.groups) throw new Error(\\\"unexpected installed group count\\\");\\n144:    await emit(\\\"native-idle:failed\\\", error instanceof Error ? error.message : \\\"fixture IPC failed\\\");\\n151:            assert!(!root.exists(), \\\"require a fresh empty fixture root\\\");\\n177:    await fill(\\\"login-password\\\", crypto.randomUUID() + \\\"Aa1!\\\");\\n203:        _ => panic!(\\\"supply both fixture metadata and password file\\\"),\\n207:            tauri::plugin::Builder::<tauri::Wry, ()>::new(\\\"idle-fixture\\\")\\n211:                        eprintln!(\\\"fixture bootstrap failed: {}\\\", event.payload());\\n248:                            .expect(\\\"inject one-shot fixture sign-in\\\");\\nreference-metadata.json\\nreference-retry-metadata.json\\nsource-volume\\ntarget-volume\\n1:import argparse\\n7:def summarize(directory, minimum_seconds, settle_seconds):\\n20:    for phase, cpu_budget in ((\\\"foreground\\\", 1.0), (\\\"minimized\\\", 0.25)):\\n22:        eligible = [row for row in samples if begin + settle_seconds <= row[\\\"at\\\"] < end]\\n44:                for counter in (\\\"cpuSeconds\\\", \\\"writeBytes\\\")\\n49:        cpu = 100 * sum(previous[key][\\\"cpuSeconds\\\"] - p[\\\"cpuSeconds\\\"] for key, p in start.items()) / seconds\\n54:            \\\"cpuPercentOneCore\\\": cpu,\\n55:            \\\"cpuWithinBudget\\\": cpu <= cpu_budget if seconds >= 300 else None,\\n67:    parser = argparse.ArgumentParser()\\n68:    parser.add_argument(\\\"directory\\\", type=Path)\\n69:    parser.add_argument(\\\"--minimum-seconds\\\", type=int, default=300)\\n70:    parser.add_argument(\\\"--settle-seconds\\\", type=int, default=15)\\n71:    args = parser.parse_args()\\n72:    report = summarize(args.directory, args.minimum_seconds, args.settle_seconds)\\n73:    (args.directory / \\\"desktop-summary.json\\\").write_text(json.dumps(report, indent=2) + \\\"\\\\n\\\")\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20696-1213-7100-8faa-48c44a76bc9e","create_time":1795407054.78344}},"metadata":{"history_sequence":14373,"sampled_through_sequence":14371,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
