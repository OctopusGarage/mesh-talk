ccount_on(c)? != *account {\n        return Err(LogError::StaleCursor);\n    }\n    let mut statement = c.prepare(\n        \"SELECT epoch,high_water,retired_through FROM reception_stream WHERE account=?1\",\n    )?;\n    let mut rows = statement.query([account.as_slice()])?;\n    let row = rows\n        .next()?\n        .ok_or_else(|| invalid(\"missing reception stream owner\"))?;\n    Ok(StreamState {\n        head: ReceptionCursor {\n            epoch: blob(row, 0)?,\n            sequence: natural(row.get(1)?)?,\n        },\n        retired: natural(row.get(2)?)?,\n    })\n}\n\npub(super) fn validate_cursor(\n    state: &StreamState,\n    cursor: ReceptionCursor,\n) -> Result<(), LogError> {\n    if cursor.epoch != state.head.epoch\n        || cursor.sequence > state.head.sequence\n        || cursor.sequence < state.retired\n    {\n        return Err(LogError::StaleCursor);\n    }\n    Ok(())\n}\n\n/// Called inside the existing plaintext/evidence transaction, before its journal\n/// intent is retired. The source body must already exist in that transaction.\npub(crate) fn install_on(\n    c: &Connection,\n    source: ReceptionSource,\n    metadata: &ReceptionMetadata,\n) -> Result<u64, LogError> {\n                \"reception effect has no installed transcript source\",\n            ));\n        }\n    }\n    let encoded =\n        bincode::serialize(metadata).map_err(|_| invalid(\"invalid reception encoding\"))?;\n    if encoded.len() > MAX_METADATA_BYTES {\n        return Err(invalid(\"reception metadata exceeds budget\"));\n    }\n    c.execute(\"INSERT INTO reception_identities(kind,conversation,event_id,terminal_key,account) VALUES(?1,?2,?3,?4,?5)\",params![source.kind.tag(),source.conversation.as_bytes().as_slice(),source.event_id.as_bytes().as_slice(),terminal_key,account.as_slice()])?;\n    let sequence = c.last_insert_rowid();\n    c.execute(\n        \"INSERT INTO reception_pending VALUES(?1,?2)\",\n        params![sequence, encoded],\n    )?;\n    if c.execute(\n        \"UPDATE reception_stream SET high_water=?1 WHERE account=?2 AND high_water<?1\",\n        params![sequence, account.as_slice()],\n    )? != 1\n    {\n        return Err(invalid(\"reception sequence did not advance\"));\n    }\n    if !metadata.reception_only {\n        super::origins::project_on(c, &account, source)?;\n    }\n    natural(sequence)\n}\n\nimpl ReceptionEffects {\n    pub(crate) fn open(profile: Arc<ProfileStorage>) -> Result<Self, LogError> {\n        let (account, owner)=profile.database().transaction(|c| {\n            let present: bool = c.query_row(\"SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name='reception_stream')\",[],|row|row.get(0))?;\n            if !present {\n                let partial: bool = c.query_row(\"SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name IN ('reception_identities','reception_pending','reception_consumers'))\",[],|row|row.get(0))?;\n                if partial { return Err(invalid(\"incomplete reception schema\")); }\n                c.execute_batch(SCHEMA)?;\n            }\n            manifest::validate_ddl(c,SCHEMA)?;\n            super::origins::initialize_on(c)?;\n            let account=active_account_on(c)?;\n            ensure_stream_on(c,&account)?;\n            state_on(c,&account)?;\n            let loaded=crate::identity::account::AccountPublic {ed25519_pub:account};\n            let owner=match event_ownership::capture_event_owner_on(c,&loaded) {\n                Ok(owner)=>Some(owner),\n                Err(LogError::StaleCursor)=>None,\n                Err(error)=>return Err(error),\n            };\n            Ok((account,owner))\n        })?;\n        Ok(Self {\n            profile,\n            account,\n            owner,\n            #[cfg(test)]\n            body_reads: std::sync::atomic::AtomicUsize::new(0),\n        })\n    }\n    pub(super) fn state_on(&self, c: &Connection) -> Result<StreamState, LogError> {\nuse super::*;\nuse bincode::Options;\nuse rusqlite::params;\n\nimpl ReceptionEffects {\n    /// Snapshot a finite installation prefix. Header lengths admit both raw and\n    /// worst-case JSON bytes before the first source body is fetched. Deleted,\n    /// suppressed and expired sources still advance the scan cursor; terminal\n    /// batch work is independent of its former template body.\n    pub(crate) fn page(\n        &self,\n        after: ReceptionCursor,\n        through: ReceptionCursor,\n        limit: ReceptionLimit,\n        now: u64,\n    ) -> Result<ReceptionPage, LogError> {\n        limit.validate()?;\n        self.profile.database().read(|c| {\n            let state=self.state_on(c)?;\n            storage::validate_cursor(&state,after)?;\n            storage::validate_cursor(&state,through)?;\n            if after.sequence > through.sequence { return Err(LogError::StaleCursor); }\n            if limit.serialized_bytes < JSON_ENVELOPE_BYTES { return Err(LogError::PageBudgetTooSmall {required:JSON_ENVELOPE_BYTES}); }\n            // A fresh participant has no transcript source to query yet. This\n            // also avoids reopening body indexes for an unchanged observation.\n            if after==through { return Ok(ReceptionPage {rows:Vec::new(),next:through,through,complete:true,body_bytes:0,serialized_bound:JSON_ENVELOPE_BYTES}); }\n            let mut statement=c.prepare(\"SELECT i.sequence,i.kind,i.conversation,i.event_id,p.metadata,t.ordinal,t.body_bytes,t.sender_bytes,t.clock FROM reception_pending p JOIN reception_identities i ON i.sequence=p.sequence LEFT JOIN transcript_rows t ON i.kind<>4 AND t.kind=CASE WHEN i.kind=3 THEN 3 ELSE 2 END AND t.conversation=i.conversation AND t.row_key=i.event_id AND (t.deadline IS NULL OR t.deadline>?4) AND NOT EXISTS(SELECT 1 FROM transcript_suppression s WHERE s.conversation=t.conversation AND (s.id=t.row_key OR s.id=t.logical_id)) WHERE p.sequence>?1 AND p.sequence<=?2 AND i.account=?5 ORDER BY p.sequence LIMIT ?3\")?;\n            let mut rows=statement.query(params![integer(after.sequence)?,integer(through.sequence)?,limit.rows as i64,now.to_be_bytes().as_slice(),self.account.as_slice()])?;\n            let mut result=ReceptionPage { rows:Vec::new(),next:after,through,complete:false,body_bytes:0,serialized_bound:JSON_ENVELOPE_BYTES };\n            let mut examined=0;\n            while let Some(row)=rows.next()? {\n                let sequence=natural(row.get(0)?)?;\n                let kind=ReceptionKind::from_tag(row.get(1)?)?;\n                let source=ReceptionSource {kind,conversation:ConversationId::new(blob(row,2)?),event_id:EventId::new(blob(row,3)?)};\n                let ordinal:Option<i64>=row.get(5)?;\n                if ordinal.is_none() && kind != ReceptionKind::ChannelTerminal {\n                    examined+=1; result.next.sequence=sequence; continue;\n                }\n                let encoded=row.get_ref(4)?.as_blob().map_err(|_|invalid(\"invalid reception metadata\"))?;\n                if encoded.len()>MAX_METADATA_BYTES {return Err(invalid(\"reception metadata exceeds budget\"));}\n                let metadata:ReceptionMetadata=bincode::DefaultOptions::new().with_fixint_encoding().with_limit(MAX_METADATA_BYTES as u64).reject_trailing_bytes().deserialize(encoded).map_err(|_|invalid(\"invalid reception metadata\"))?;\n                metadata.validate(kind)?;\n                let body_size=if ordinal.is_some() { usize::try_from(row.get::<_,i64>(6)?).map_err(|_|invalid(\"invalid reception body length\"))? } else {0};\n                let sender_size=if ordinal.is_some() { usize::try_from(row.get::<_,i64>(7)?).map_err(|_|invalid(\"invalid reception sender length\"))? } else {0};\n                let charge=body_size.checked_add(sender_size).ok_or_else(||invalid(\"reception size overflow\"))?;\n                let serialized=charge.checked_add(encoded.len()).and_then(|n|n.checked_mul(6)).and_then(|n|n.checked_add(JSON_ENVELOPE_BYTES)).ok_or_else(||invalid(\"reception encoded size overflow\"))?;\n                let next_body=result.body_bytes.checked_add(charge).ok_or_else(||invalid(\"reception size overflow\"))?;\n                let next_serialized=result.serialized_bound.checked_add(serialized).ok_or_else(||invalid(\"reception encoded size overflow\"))?;\n                if next_body>limit.body_bytes || next_serialized>limit.serialized_bytes {\n                    if examined==0 {return Err(LogError::PageBudgetTooSmall {required:if next_body>limit.body_bytes {next_body}else{next_serialized}});}\n                    return Ok(result);\n                }\n                let entry=if kind==ReceptionKind::ChannelTerminal {None} else {\n                    let ordinal=ordinal.ok_or_else(||invalid(\"missing reception source\"))?;\n                    let wall_clock=u64::from_be_bytes(blob(row,8)?);\ncrates/mesh-talk-core/src/node/account_profile.rs:66:    pub(super) fn page(\ncrates/mesh-talk-core/src/storage/profile/participant/event_ownership.rs:265:pub(crate) fn check_event_owner_on(\n1168:        let reception_effects = super::reception_effects::ReceptionEffects::open(storage.clone())?;\n1545:            super::reception_effects::ReceptionEffects::open(node.storage.clone())?;\n{\"loaded\":\"D:\\\\MeshTalk\\\\REQ011\\\\windows-native-minimize.BYtDdUfh/reception-errors.ROLMSl6e-loaded\",\"sessionId\":1,\"messages\":100000}\r\n\r\n","exit_code":0,"duration":{"secs":0,"nanos":13375}},"started_at_ms":1795414177196,"completed_at_ms":1795414177197}}
