{"timestamp":"2026-11-23T06:32:25.810Z","ordinal":38117,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1feaf-24d9-7612-a284-664abd64a2c4","turn_id":"01a20719-6f7f-75d3-b5ba-5b05d2c65b02","item":{"type":"CommandExecution","id":"exec-f664f55b-b97c-4631-abcb-694c607b552b","process_id":"59736","command":["/bin/zsh","-lc","w=$(cat tmp/req-011/windows-native-minimize-path); h=$(cat \"$w/minimized-isolated-path\"); sed -n '1,48p' \"$h/sample-reference-desktop.ps1\"; head -16 tmp/req-011/desktop-phase-summary.py; rg -n 'summary.py|--loaded' \"$h/summary.log\""],"cwd":"file:///Users/kingsonwu/programming/OctopusGarage/mesh-talk","parsed_cmd":[{"type":"unknown","cmd":"w=$(cat tmp/req-011/windows-native-minimize-path); h=$(cat \"$w/minimized-isolated-path\"); sed -n '1,48p' \"$h/sample-reference-desktop.ps1\"; head -16 tmp/req-011/desktop-phase-summary.py; rg -n 'summary.py|--loaded' \"$h/summary.log\""}],"source":"unified_exec_startup","status":"failed","aggregated_output":"param(\n    [Parameter(Mandatory=$true)][string]$Binary,\n    [Parameter(Mandatory=$true)][string]$Profile,\n    [Parameter(Mandatory=$true)][string]$Evidence,\n    [ValidateRange(320,7200)][int]$PhaseSeconds = 330,\n    [string]$Metadata,\n    [string]$PasswordFile\n)\n$ErrorActionPreference = 'Stop'\n$loaded = [bool]$Metadata\nif ($loaded -ne [bool]$PasswordFile) { throw 'Supply both fixture metadata and password file' }\nNew-Item -ItemType Directory -Path $Evidence | Out-Null\n$udp = New-Object System.Net.Sockets.UdpClient(0)\n$port = ([Net.IPEndPoint]$udp.Client.LocalEndPoint).Port\n$udp.Dispose()\n$stderr = \"$Evidence/fixture.log\"\n$arguments = @($Profile, $port, $PhaseSeconds)\nif ($loaded) { $arguments += @($Metadata, $PasswordFile) }\n$start = [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()\n$instance = Start-Process -FilePath $Binary -ArgumentList $arguments -PassThru -RedirectStandardError $stderr -RedirectStandardOutput \"$Evidence/stdout.log\"\n# Keep the native handle so Windows PowerShell can retrieve the exit code.\n$null = $instance.Handle\nAdd-Type @'\nusing System;\nusing System.Runtime.InteropServices;\npublic static class NativeTransition {\n    [DllImport(\"user32.dll\")] public static extern IntPtr GetForegroundWindow();\n}\n'@\n$clock = [Diagnostics.Stopwatch]::StartNew()\n# Windows can deny the child foreground activation when it is launched from\n# the scheduled task. Request activation once for this benchmark process.\n$foreground = New-Object -ComObject WScript.Shell\n$limit = [DateTime]::UtcNow.AddSeconds(18)\nwhile (!$instance.HasExited -and [DateTime]::UtcNow -lt $limit) {\n    if ((Test-Path $stderr) -and (Select-String -Path $stderr -Pattern '^MEASURE foreground start' -Quiet)) { break }\n    $instance.Refresh()\n    if ($instance.MainWindowHandle -ne 0 -and [NativeTransition]::GetForegroundWindow() -ne $instance.MainWindowHandle) {\n        [void]$foreground.AppActivate($instance.Id)\n    }\n    Start-Sleep -Milliseconds 100\n}\n$samples = New-Object System.Collections.Generic.List[object]\ntry {\n    while (!$instance.HasExited) {\n        if ($clock.Elapsed.TotalSeconds -gt 180 + 2 * $PhaseSeconds) { throw 'Native desktop probe timed out' }\n        $inventory = @(Get-CimInstance Win32_Process)\n        $family = [Collections.Generic.HashSet[int]]::new()\n\"\"\"Analyze native desktop counters within fixture-marked phases.\"\"\"\nimport json\nimport re\nimport sys\nfrom pathlib import Path\n\nMARKER = re.compile(r\"^MEASURE (foreground|minimized) (start|end) (\\d+\\.\\d+)$\", re.MULTILINE)\nCPU_LIMITS = {\"foreground\": 1.0, \"minimized\": 0.25}\n\n\ndef summarize(log, observations, min_seconds=300, settle=15):\n    markers = {}\n    for phase, edge, value in MARKER.findall(log):\n        key = phase, edge\n        if key in markers:\n            raise ValueError(f\"duplicate marker {key}\")\n","exit_code":1,"duration":{"secs":0,"nanos":13250}},"started_at_ms":1795415545810,"completed_at_ms":1795415545810}}
