uth.getState().user?.display_name !== identity.display_name\n      )\n        useAuth.setState((state) => ({\n          user: state.user\n            ? { ...state.user, display_name: identity.display_name! }\n            : null,\n        }));\n      applyVerifiedIdentity(set, identity, true);\n      const acct = identity.account_id;\n      setPushStateSupport(identity.supports_push_state ? owner : null);\n      syncChatAvatarIdentity(\n        acct,\n        () => !isCancelled(),\n        !!identity.supports_bounded_delivery,\n      );\n      // Identity completes boot. Roster/history hydration owns its separate\n      // bounded lane and must not extend the startup deadline or hold bootBusy.\n      void get().refreshRoster();\n      return true;\n    } catch {\n      if (superseded()) return false;\n      try {\n        const startup =\n          observedStartup !== undefined\n            ? observedStartup\n            : await readWithDeadline(\n                () => chat.ownerStartupIdentity(owner),\n                Math.max(1, Math.min(2_000, deadline - performance.now())),\n              );\n        if (superseded() || performance.now() >= deadline) return false;\n        if (startup === null && get().startupId !== null) {\n      window.addEventListener(\"focus\", resumeReception);\n    }\n    if (typeof document !== \"undefined\") {\n      document.addEventListener?.(\"visibilitychange\", flushReceipts);\n      document.addEventListener?.(\"visibilitychange\", expire);\n      document.addEventListener?.(\"visibilitychange\", resumeReception);\n    }\n\n    let rosterBusy = false;\n    let rosterDirty = false;\n    const refreshRoster = async (invalidate = false) => {\n      if (rosterBusy) {\n        rosterDirty ||= invalidate;\n        return;\n      }\n      rosterBusy = true;\n      try {\n        do {\n          rosterDirty = false;\n          await get().refreshRoster();\n        } while (rosterDirty && lease.current());\n      } finally {\n        rosterBusy = false;\n      }\n    };\n    const stopRosterRecovery = startRecoveryRefresh(\n      () => {\n        if (!lease.current() || !get().ready) return;\n        wakeReception();\n        void refreshRoster();\n        void get().refreshStatuses();\n      },\n      {\n        intervalMs: () =>\n          supportsPushState(lease.owner) ? RECOVERY_REFRESH_MS : 2000,\n      },\n    );\n    const controlObservation = groupOperationObservation(rawSet, get);\n          ? createRosterObservation(\n              lease.owner!,\n              async () => {\n                const value = await rosterPresenceApi.observeRoster(\n                  lease.owner!,\n                );\n                if (\n                  value.identity.owner !== lease.owner ||\n                  value.identity.device_id !== get().myId ||\n                  value.identity.account_id !== get().myAccountId ||\n                  (value.identity.runtime_id !== undefined &&\n                    value.identity.runtime_id !== get().deliveryRuntime)\n                )\n                  throw new Error(\"Roster source identity changed\");\n                return value;\n              },\n              rosterLease!.current,\n            )\n          : undefined;\n      notifySyncInvalidation({\n        owner: lease.owner!,\n        kind,\n        rosterObservation: ticket,\n      });\n      if (kind === \"state\") {\n        void refreshRoster(true);\n        void get().refreshChannels();\n        void get().refreshStatuses(undefined, true);\n      } else if (kind === \"roster\") void presenceRosterRefresh(ticket);\n      else void get().refreshStatuses(undefined, true);\n      if (kind !== \"roster\") void refreshGroupOperationIntents(rawSet, get);\n    };\n\n    const matchesRuntime = (scope: ReceptionScope) => {\nfrontend/src/store/chat.ts:47:import { createChannelRefresh } from \"./channelRefresh\";\nfrontend/src/store/chat.ts:601:const channelRefresh = createChannelRefresh({\nfrontend/src/store/chat.