ry: F)\n1009:    struct ShortcutFixture {\n1068:    struct ShortcutRegistry(Arc<Mutex<ShortcutRegistryInner>>);\n1070:    struct ShortcutRegistryInner {\n1356:        suspend_retired_for(fixture.host.handle(), move || failing).await;\n1362:        suspend_retired_for(fixture.host.handle(), move || retry).await;\n1378:            suspend_retired_for(fixture.host.handle(), move || active).await;\n1400:            suspend_retired_for(fixture.host.handle(), move || retired).await;\n    }\n\n    pub fn tick<R: tauri::Runtime>(&self, handle: &tauri::AppHandle<R>) {\n        let app = handle.state::<AppState>();\n        let settings = handle.state::<crate::settings::SettingsState>().get();\n        let Ok(lease) = app.session().capture() else {\n            return;\n        };\n        // The visibility query dispatches to the native window thread.\n        // Idle-time locking and the default disabled policy do not need it.\n        let hidden = settings.lock_when_hidden\n            && handle\n                .get_webview_window(\"main\")\n                .is_some_and(|window| !window.is_visible().unwrap_or(true));\n        let should_lock = {\n            let Ok(mut inner) = self.0.lock() else {\n                return;\n            };\n            if inner.generation != lease.generation() {\n                inner.generation = lease.generation();\n                inner.last_activity = Instant::now();\n                inner.call_active = false;\n                return;\n            }\n            due(&inner, &settings, hidden)\n        };\n        if !should_lock {\n            return;\n        }\n        let locked = app\n            .session()\n            .matching(&lease, |_| {\n                let Ok(mut inner) = self.0.lock() else {\n                    return false;\n                };\n                let still_due =\n                    inner.generation == lease.generation() && due(&inner, &settings, hidden);\n                if still_due {\n                    inner.authorization_revision = inner.authorization_revision.wrapping_add(1);\n                    inner.lease = Some(lease.clone());\n                }\n                still_due\n            })\n            .unwrap_or(false);\n        if locked {\n            *app.drafts.lock().unwrap() = None;\n            let _ = handle.emit(\"app-locked\", ());\n        }\n    }\n}\n\n#[tauri::command]\npub fn note_activity(app: tauri::State<'_, AppState>, state: tauri::State<'_, AppLock>) {\n//! Account-local capture accelerators and their native registration lifetime.\nuse crate::{\n    commands::CommandError,\n    settings::SettingsState,\n    state::{AppState, SessionLease},\n};\nuse serde::{Deserialize, Serialize};\nuse std::{\n    collections::BTreeSet,\n    sync::{Arc, Mutex},\n};\nuse tauri::{Emitter, Manager, Runtime};\n#[cfg(not(target_os = \"linux\"))]\nuse tauri_plugin_global_shortcut::GlobalShortcutExt;\nuse tauri_plugin_global_shortcut::{Shortcut, ShortcutState};\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(default)]\npub struct ScreenshotShortcuts {\n    pub capture: Option<String>,\n    pub capture_hidden: Option<String>,\n    pub global: bool,\n}\nimpl Default for ScreenshotShortcuts {\n    fn default() -> Self {\n        Self {\n            capture: Some(\"CommandOrControl+Shift+KeyX\".into()),\n            capture_hidden: Some(\"CommandOrControl+Alt+Shift+KeyX\".into()),\n            global: false,\n        }\n    }\n}\nimpl ScreenshotShortcuts {\n    pub(crate) fn validate(&self) -> Result<(), CommandError> {\n        let keys = self.bindings()?;\n        if self.global && keys.is_empty() {\n            return Err(CommandError::InvalidInput(\n                \"set a screenshot shortcut before enabling global activation\".into(),\n            ));\n        }\n        if keys.len() == 2 && keys[0].0 == keys[1].0 {\n            return Err(CommandError::InvalidInput(\n                \"screenshot shortcuts must be different\".into(),\n            ));\n        }\n        Ok(())\n    }\n    fn bindings(&self) -> Result<Vec<(Shortcut, bool)>, CommandError> {\n        [(&self.capture, false), (&self.capture_hidden, true)]\n            .into_iter()\n            .filter_map(|(text, hidden)| {\n                text.as_deref()\n                    .map(|text| parse(text).map(|key| (key, hidden)))\n            })\n            .collect()\n    }\n}\nfn parse(text: &str) -> Result<Shortcut, CommandError> {\n    let invalid = || CommandError::InvalidInput(\"invalid or reserved screenshot shortcut\".into());\n    let parts: Vec<_> = text.split('+').collect();\n    let Some((key, modifiers)) = parts.split_last() else {\n        return Err(invalid());\n    };\n    let order = [\"CommandOrControl\", \"Control\", \"Alt\", \"Shift\", \"Super\"];\n    let mut last = None;\n    for modifier in modifiers {\n        let Some(index) = order.iter().position(|value| value == modifier) else {\n            return Err(invalid());\n        };\n        if last.is_some_and(|last| index <= last) {\n            return Err(invalid());\n        }\n        last = Some(index);\n    }\n    let primary = modifiers.contains(&\"CommandOrControl\") || modifiers.contains(&\"Control\");\n    let alt = modifiers.contains(&\"Alt\");\n    let shift = modifiers.contains(&\"Shift\");\n    if modifiers.contains(&\"Super\")\n        || (modifiers.contains(&\"CommandOrControl\") && modifiers.contains(&\"Control\"))\n        || (!primary && !alt)\n    {\n        return Err(invalid());\n    }\n    let letter = key\n        .strip_prefix(\"Key\")\n        .filter(|v| v.len() == 1 && v.as_bytes()[0].is_ascii_uppercase());\n    let digit = key\n        .strip_prefix(\"Digit\")\n        .is_some_and(|v| v.len() == 1 && v.as_bytes()[0].is_ascii_digit());\n    let function = key\n        .strip_prefix('F')\n        .and_then(|v| v.parse::<u8>().ok())\n        .filter(|n| (1..=12).contains(n))\n        .is_some_and(|n| format!(\"F{n}\") == *key);\n    if 