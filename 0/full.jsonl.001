oreground.AppActivate($instance.Id)'\nassert s.count(needle)==1\ns=s.replace(needle,needle+'''\n        if ([NativeTransition]::GetForegroundWindow() -ne $instance.MainWindowHandle) {\n            [void][NativeTransition]::Activate($instance.MainWindowHandle)\n        }''')\n(retry/\"sample-reference-desktop.ps1\").write_text(s)\nPY\nprintf '%s\\\\n' \"$retry\" >\"$out/qualification-path\"\nssh -o BatchMode=yes -o ConnectTimeout=5 windows10 \"powershell.exe -NoProfile -Command \\\\\"New-Item -ItemType Directory -Path '$remote/$name' | Out-Null\\\\\"\"\nscp -q \"$retry/\"*.ps1 \"windows10:$remote/$name/\"\nssh -o BatchMode=yes -o ConnectTimeout=5 windows10 powershell.exe -NoProfile -NonInteractive -File \"$remote/$name/launch-reception-window-state.ps1\" >\"$retry/native.log\" 2>&1\nscp -q \"windows10:$remote/$name-loaded/fixture.log\" \"windows10:$remote/$name-loaded/process-samples.json\" \"$out/\"\npython3 tmp/req-011/desktop-phase-summary.py \"$out\" >\"$out/summary.log\"`,yield_time_ms:1000}))\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a20749-33d0-76f3-99e0-e9eb9942d58b","create_time":1795418595.8109684}},"metadata":{"history_sequence":16957,"sampled_through_sequence":16954,"client_authored":false,"model_search_state":"unused"}}
