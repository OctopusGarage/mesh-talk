changed(entry_generation, || ()).is_err()\n            || !settings.stay_signed_in\n            || settings.last_user.as_deref() != Some(credential_user.as_str())\n        {\n            return None;\n        }\n        crate::session_store::load_with_policy(&credential_user, settings.startup_verification)\n    })\n    .await\n    .unwrap_or_else(|error| {\n        log::warn!(\"saved-session credential read failed: {error}\");\n        None\n    });\n    let Some(password) = saved else {\n        return Ok(None);\n    };\n    #[cfg(test)]\n    {\n        let gate = REDACTED.auto_admission_gate.lock().unwrap().take();\n        if let Some((entered, release)) = gate {\n            let _ = entered.send(());\n            let _ = release.await;\n        }\n    }\n    match login_impl_guarded(\n        username.clone(),\n        password.clone(),\n        REDACTED.inner(),\n        Some((entry_generation, settings_state.inner())),\n    )\n    .await\n    {\n        Ok(outcome) if outcome.result.success => {\n            REDACTED\n                .session()\n                .matching(&outcome.lease, |_| {\n                    settings_state.activate(outcome.lease.owner())\n                })\n                .map_err(CommandError::Authorization)?;\n            let node_password = REDACTED\n                .session()\n                .matching(&outcome.lease, |info| info.node_storage_password.clone())\n                .map_err(CommandError::Authorization)?;\n            let user_info = UserInfo::from(outcome.user);\n            spawn_node_runtime(\ncrates/mesh-talk-core/src/node/privacy_runtime.rs:858:    pub(in crate::node) fn known_account_allowed(&self, public: &PublicIdentity) -> bool {\ncrates/mesh-talk-core/src/node/privacy_routing.rs:131:        proof.filter(|p| self.known_account_allowed(&p.public()))\ncrates/mesh-talk-core/src/node/privacy_routing.rs:143:        !proof.post_office && peer != self.identity.public() && self.known_account_allowed(&peer)\ncrates/mesh-talk-core/src/node/privacy_sync.rs:1438:            || !self.node.known_account_allowed(&self.peer)\ncrates/mesh-talk-core/src/node/privacy_sync.rs:1521:            || !self.node.known_account_allowed(&self.peer)\ncrates/mesh-talk-core/src/node/privacy_sync.rs:1555:        if self.denied || !self.node.known_account_allowed(&self.peer) {\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a206ac-a8d9-7182-994d-635dc5a22a05","create_time":1795408337.19441}},"metadata":{"history_sequence":14787,"sampled_through_sequence":14784,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
