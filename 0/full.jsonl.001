s.log\\\"),\\n                password,\\n            )?;\\n        account_transitions.commit_own(&identity.public(), &account.public().ed25519_pub)?;\\n        account_transitions.discard_pending(&identity.public(), &account.public().ed25519_pub)?;\\n        let continuity =\\n            account_transitions.own_chain(&identity.public(), &account.public().ed25519_pub);\\n        log::info!(\\n            \\\"account binding continuity: available={}, links={}\\\",\\n            !continuity.is_empty(),\\n            continuity.len()\\n        );\\n        let account_document_updates = tokio::sync::watch::channel(0).0;\\n        super::account_documents::store::AccountDocumentStore::authenticate_legacy(\\n            &storage,\\n            dir,\\n            password,\\n            &account.public().ed25519_pub,\\n        )?;\\n        observe_phase(\\\"account_stores_opened\\\");\\n        let published_profile = storage.participant_database().is_some();\\n        storage.complete_participant(password, legacy_previous.as_deref())?;\\n        let open_documents = || {\\n            super::account_documents::store::AccountDocumentStore::open_profile(\\n                storage.clone(),\\n                dir,\\n                password,\\n                &account.public().ed25519_pub,\\n            )\\n        };\\n        // Media and documents have separate journals, directories and salts.\\n        // A new publication keeps its original initialization order.\\n        // Their shared database still serializes namespace transactions.\\n        let (media, favorite_media, documents) = std::thread::scope(|scope| {\\n            let documents = published_profile.then(|| scope.spawn(open_documents));\\n            let favorite_media = scope.spawn(|| {\\n                super::media_store::MediaStore::open_profile(\\n                    storage.clone(),\\n                    &dir.join(format!(\\\"favorites-{account_id}\\\")),\\n                    password,\\n                    &account_id,\\n                    None,\\n                )\\n            });\\n            let media = super::media_store::MediaStore::open_profile(\\n                storage.clone(),\\n                dir,\\n                password,\\n                &identity.user_id(),\\n                None,\\n            );\\n            (\\n                media,\\n                favorite_media.join(),\\n                documents.map(|task| task.join()),\\n            )\\n        });\\n        let media = media.map_err(LogError::Io)?;\\n        let favorite_media = favorite_media\\n            .unwrap_or_else(|panic| std::panic::resume_unwind(panic))\\n            .map_err(LogError::Io)?;\\n        let account_documents = match documents {\\n            Some(result) => result.unwrap_or_else(|panic| std::panic::resume_unwind(panic))?,\\n            None => open_documents()?,\\n        };\\n\\n        let channel_custody = ChannelCustodyStore::from_profile(\\n            storage.clone(),\\n            &dir.join(\\\"channel.custody\\\"),\\n            password,\\n        )?;\\n        let my_dm_reactions = super::reaction_store::IndexedReactionStore::from_profile(\\n            storage.clone(),\\n            &reaction_path,\\n            password,\\n            account.public().ed25519_pub,\\n        )?;\\n        let avatars = super::profile_store::IndexedProfileStore::from_profile(\\n            storage.clone(),\\n            &dir.join(\\\"profiles.log\\\"),\\n            password,\\n        )?;\\n        let account_profiles = super::account_profile::AccountProfiles::new(&account, avatars)?;\\n        let trust_cards = Mutex::new(super::trust_card::IndexedTrustCardStore::from_profile(\\n            storage.clone(),\\n            &dir.join(\\\"trust-cards.log\\\"),\\n            password,\\n        )?);\\n        let profiles = Mutex::new(\\n            super::account_profile_data::IndexedAccountProfileStore::from_profile(\\n                storage.clone(),\\n                &dir.join(\\\"account-profiles.log\\\"),\\n                password,\\n            )?,\\n        );\\n\\n        observe_phase(\\\"transcript_owners_opened\\\");\\n        let profile_receive_work =\\n            super::profile_receive_work::ProfileReceiveWork::open(storage.clone())?;\\n        let reception_effects = super::reception_effects::ReceptionEffects::open(storage.clone())?;\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20716-3db6-7082-80bc-7b02ed524e72","create_time":1795415250.887209}},"metadata":{"history_sequence":16075,"sampled_through_sequence":16072,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
