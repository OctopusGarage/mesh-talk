 number of days\\n        confirming: bool,\\n    ) {\\n        let Some(slot) = &self.order_work_observation else {\\n            return;\\n        };\\n        if let Ok(mut observer) = slot.try_lock() {\\n            observer.record_distribution_origin(\\n                origin.file(),\\n                origin.line(),\\n                origin.column(),\\n                confirming,\\n            );\\n        }\\n    }\\n\\n    /// Called only by the admitted blocking maintenance owner. Disabled nodes\\n    /// perform no observation query; an active observer retains one cursor.\\n    pub(in crate::node) fn observe_order_work(&self) {\\n        self.observe_order_work_with_logger(log::logger());\\n    }\\n\\n    fn observe_order_work_with_logger(&self, logger: &dyn log::Log) {\\n        let Some(slot) = &self.order_work_observation else {\\n            return;\\n        };\\nsrc-tauri/src/logger/mod.rs:136:/// Get the logs directory path (~/.mesh-talk/logs/)\\nsrc-tauri/src/logger/mod.rs:137:fn get_mesh_talk_logs_dir() -> Result<PathBuf, Box<dyn std::error::Error>> {\\nsrc-tauri/src/logger/mod.rs:138:    let logs_dir = crate::data_dir().join(\\\"logs\\\");\\nsrc-tauri/src/logger/mod.rs:139:    fs::create_dir_all(&logs_dir)?;\\nsrc-tauri/src/logger/mod.rs:143:        fs::set_permissions(&logs_dir, fs::Permissions::from_mode(0o700))?;\\nsrc-tauri/src/logger/mod.rs:145:    Ok(logs_dir)\\nsrc-tauri/src/logger/mod.rs:150:    // Get the custom logs directory (~/.mesh-talk/logs/)\\nsrc-tauri/src/logger/mod.rs:151:    let logs_dir = get_mesh_talk_logs_dir()?;\\nsrc-tauri/src/logger/mod.rs:154:    cleanup_old_logs(&logs_dir, MAX_LOG_RETENTION_DAYS)?;\\nsrc-tauri/src/logger/mod.rs:158:        path: logs_dir.clone(),\\nsrc-tauri/src/logger/mod.rs:188:fn cleanup_old_logs(logs_dir: &Path, max_days: u64) -> Result<(), std::io::Error> {\\nsrc-tauri/src/logger/mod.rs:191:    if let Ok(entries) = fs::read_dir(logs_dir) {\\nsrc-tauri/src/logger/mod.rs:212:/// Get the path to the logs directory\\nsrc-tauri/src/logger/mod.rs:213:pub fn get_logs_directory(\\nsrc-tauri/src/logger/mod.rs:216:    get_mesh_talk_logs_dir().map_err(|e| tauri::Error::from(std::io::Error::other(e.to_string())))\\nsrc-tauri/src/logger/mod.rs:223:    let logs_dir = get_logs_directory(_app_handle)?;\\nsrc-tauri/src/logger/mod.rs:224:    Ok(logs_dir.join(\\\"mesh-talk.log\\\"))\\nsrc-tauri/src/logger/mod.rs:231:/// The logs directory, as a string (for the Diagnostics \\\"Reveal logs folder\\\" button).\\nsrc-tauri/src/logger/mod.rs:233:pub fn get_logs_dir(app_handle: tauri::AppHandle) -> Result<String, crate::commands::CommandError> {\\nsrc-tauri/src/logger/mod.rs:234:    let dir = get_logs_directory(&app_handle).map_err(|e| e.to_string())?;\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a20723-1cc5-7253-a212-4f4a5524f334","create_time":1795416126.394635}},"metadata":{"history_sequence":16349,"sampled_through_sequence":16346,"client_authored":false,"fallback_token_limit_override":12000,"model_search_state":"unused"}}
