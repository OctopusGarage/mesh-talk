t).await;\n    }\n    let mut tick = tokio::time::interval(interval);\n    tick.tick().await; // consume the immediate first tick (the burst just sent)\n    loop {\n        // Steady re-announce on the timer, OR an immediate one when triggered.\n        match &trigger {\n            Some(notify) => tokio::select! {\n                _ = tick.tick() => {}\n                _ = notify.notified() => {}\n            },\n            None => {\n                tick.tick().await;\n            }\n        }\n        // Read the current announce each send so a runtime rename takes effect here.\n        // Ignore send errors: the network may be transiently down. Retry next tick.\n        let bytes = current_announce(&announce);\n        let _ = visibility.send_announce(&socket, &bytes, target).await;\n    }\n}\n\n/// The discovery port unicast-scan cadence: offsets from launch for quick startup\n/// sweeps so a peer that came up just before us is found fast, then a steady\n/// slow interval (multicast/broadcast carry the steady-state load; the scan is\n/// the fallback for when those are blocked but unicast is allowed).\nconst SCAN_STARTUP_DELAYS_SECS: [u64; 3] = [1, 3, 7];\nconst SCAN_STEADY_INTERVAL: Duration = Duration::from_secs(5);\n// Together with the two-second sweep budget this stays below public presence's\n// 15-second lease on networks where unicast is the only discovery path.\nconst SCAN_MAX_INTERVAL: Duration = Duration::from_secs(10);\nconst SCAN_SWEEP_BUDGET: Duration = Duration::from_secs(2);\nconst SCAN_MAX_TARGETS: usize = 512;\nconst SCAN_PACKET_SPACING: Duration = Duration::from_millis(2);\nconst SCAN_QUIET_INTERVAL: Duration = Duration::from_secs(300);\nconst KNOWN_KEEPALIVE_INTERVAL: Duration = Duration::from_secs(5);\nconst KNOWN_READY_BATCH: usize = 64;\n\n/// Unicast-UDP /24 scan fallback (the analog of LocalSend's HTTP /24 scan, adapted\n/// to our fixed UDP discovery port). For each local non-loopback IPv4 interface,\n                    }\n                } => true,\n                changed = visibility_changes.changed() => {\n                    if changed.is_err() { return; }\n                    known_at.get_or_insert_with(tokio::time::Instant::now);\n                    true\n                },\n                changed = roster_changes.changed(), if known_at.is_none() => {\n                    if changed.is_err() { return; }\n                    known_at = Some(tokio::time::Instant::now());\n                    false\n                },\n            };\n            if triggered || tokio::time::Instant::now() >= full_at {\n                let bytes = current_announce(&announce);\n                scan_once_with_visibility(\n                    &socket,\n                    &bytes,\n                    discovery_port,\n                    &visibility,\n                    &mut cursor,\n                )\n                .await;\n                full_at = tokio::time::Instant::now() + SCAN_QUIET_INTERVAL;\n            }\n            if known_at.is_some_and(|at| tokio::time::Instant::now() >= at) {\n                // Mark the wake before reading the roster so a concurrent\n                // publication cannot be lost when the keepalive parks.\n                roster_changes.borrow_and_update();\n                let targets = if visibility.is_public().await {\n                    known_discovery_targets(&roster.lock().expect(\"roster mutex\"), discovery_port)\n                } else {\n                    Vec::new()\n                };\n                if targets.is_empty() {\n                    known_at = None;\n                    known_cursor = 0;\n                    known_remaining = 0;\n                    continue;\n                }\n                let bytes = current_announce(&announce);\n                let complete = send_known_keepalives(\n                    &socket,\n                    &bytes,\n                    &targets,\n                    &visibility,\n                    &mut known_cursor,\n                    &mut known_remaining,\n                )\n                .await;\n                // A timed-out batch retains its fair cursor and resumes without\n                // another five-second delay. No child outlives this producer.\n                known_at = Some(\n                    tokio::time::Instant::now()\n                        + if complete {\n                            KNOWN_KEEPALIVE_INTERVAL\n                        } else {\n                            Duration::from_millis(10)\n                        },\n                );\n            }\n        }\n    }\n    // Standalone run_scan has no roster owner. Preserve its historical fallback\n    // cadence; every production desktop/headless spawn supplies the existing roster.\n    let mut idle_sweeps = 0u32;\n    loop {\n        let ceiling = SCAN_STEADY_INTERVAL\n            .saturating_mul(1u32 << idle_sweeps.min(2))\n            .min(SCAN_MAX_INTERVAL);\n        let max_ms = ceiling.as_millis() as u64;\n        let floor_ms = max_ms * 4 / 5;\n        let delay = Duration::from_millis(\n            floor_ms + uuid::Uuid::new_v4().as_u128() as u64 % (max_ms - floor_ms + 1),\n        );\n        let triggered = match &trigger {\n            Some(notify) => tokio::select! {\n                _ = tokio::time::sleep(delay) => false,\n                _ = notify.notified() => true,\n            },\n            None => {\n                tokio::time::sleep(delay).await;\n                false\n            }\n        };\n        idle_sweeps = if triggered {\n            0\n        } else {\n            idle_sweeps.saturating_add(1)\n        };\n        let bytes = current_announce(&announce);\n        scan_once_with_visibility(&socket, &bytes, discovery_port, &visibility, &mut cursor).await;\n    }\n}\n\n// Roster cardinality and per-peer routes are bounded by their existing owner.\n// Use observed direct discovery IPs, never advertised TCP ports, gateway routes,\n// post-office introduction