ldest(&self) -> Result<ReceptionCursor, LogError> {\n        self.profile.database().read(|c| {\n            let state = self.state_on(c)?;\n            Ok(ReceptionCursor {\n                sequence: state.retired,\n                ..state.head\n            })\n        })\n    }\n\n    pub(crate) fn registered(\n        &self,\n        consumer: ReceptionConsumer,\n    ) -> Result<Option<ReceptionCursor>, LogError> {\n        self.profile.database().read(|c| {\n            let state = self.state_on(c)?;\n            let sequence: Option<i64> = c\n                .query_row(\n                    \"SELECT acknowledged FROM reception_consumers WHERE account=?1 AND kind=?2\",\n                    params![self.account.as_slice(), consumer.tag()],\n                    |row| row.get(0),\n                )\n                .optional()?;\n            sequence\n                .map(|sequence| {\n                    Ok(ReceptionCursor {\n                        sequence: natural(sequence)?,\n                        ..state.head\n                    })\n                })\n                .transpose()\n        })\n    }\n    /// A consumer name is fixed by the host role, never allocated per window or\n    /// per reconnect. Existing durable progress wins over a caller's baseline.\n    pub(crate) fn register(\n        &self,\n        consumer: ReceptionConsumer,\n        baseline: ReceptionCursor,\n    ) -> Result<ReceptionCursor, LogError> {\n        self.profile.database().transaction(|c| {\n            let state = self.state_on(c)?;\n            if baseline.epoch != state.head.epoch {\n                return Err(LogError::StaleCursor);\n            }\n            if let Some(sequence) = c\n                .query_row(\n                    \"SELECT acknowledged FROM reception_consumers WHERE kind=?1 AND account=?2\",\n                    params![consumer.tag(), self.account.as_slice()],\n                    |row| row.get::<_, i64>(0),\n                )\n                .optional()?\n            {\n                return Ok(ReceptionCursor {\n                    sequence: natural(sequence)?,\n                    ..state.head\n                });\n            }\n            validate_cursor(&state, baseline)?;\n            c.execute(\n                \"INSERT INTO reception_consumers VALUES(?3,?1,?2)\",\n                params![\n                    consumer.tag(),\n                    integer(baseline.sequence)?,\n                    self.account.as_slice()\n                ],\n            )?;\n            Ok(baseline)\n        })\n    }\n/// - `authorization`    — permission denied\n/// - `io`               — file / disk / log I/O failure\n/// - `not-started`      — the node runtime isn't running yet\n/// - `invalid-input`    — caller-supplied input was rejected\n/// - `link-*`           — the core's explicit device-pairing stage/recovery cause\n/// - `internal`         — anything not distinguishable as one of the above\n#[derive(Debug, serde::Serialize)]\n#[serde(tag = \"kind\", content = \"message\")]\npub enum CommandError {\n    #[serde(rename = \"link-no-direct-route\")]\n    LinkNoDirectRoute(String),\n    #[serde(rename = \"link-connection\")]\n    LinkConnection(String),\n    #[serde(rename = \"link-timeout\")]\n    LinkTimeout(String),\n    #[serde(rename = \"link-rejected\")]\n    LinkRejected(String),\n    #[serde(rename = \"link-upgrade-required\")]\n    LinkUpgradeRequired(String),\n    #[serde(rename = \"link-protocol\")]\n    LinkProtocol(String),\n    #[serde(rename = \"peer-unknown\")]\n    PeerUnknown(String),\n    #[serde(rename = \"relay-unreachable\")]\n    RelayUnreachable(String),\n    #[serde(rename = \"crypto\")]\n    Crypto(String),\n    #[serde(rename = \"auth\")]\n    Auth(String),\n    #[serde(rename = \"authentication-required\")]\n    AuthenticationRequired(String),\n    #[serde(rename = \"authorization\")]\n    Authorization(String),\n    #[serde(rename = \"io\")]\n    Io(String),\n    #[serde(rename = \"not-started\")]\n    NotStarted(String),\n    #[serde(rename = \"invalid-input\")]\n    InvalidInput(String),\n    #[serde(rename = \"internal\")]\n    Internal(String),\n}\n\nimpl CommandError {\n    /// The node runtime isn't running yet (no session / pre-login).\n    pub fn not_started() -> Self {\n135:impl From<mesh_talk_core::node::NodeError> for CommandError {\n\nit(\"retries failed persistence without applying unread effects twice or ACKing unsaved state\", async () => {\n  vi.useFakeTimers();\n  const failure = new Error(\"quota exhausted\");\n  const pull = vi.fn().mockResolvedValue(page(1));\n  const apply = vi.fn();\n  const persist = vi.fn().mockImplementationOnce(() => {\n    throw failure;\n  });\n  const acknowledge = vi.fn().mockResolvedValue(false);\n  const failed = vi.fn();\n  const delivery = createReceptionDelivery({\n    scope,\n    cursor: null,\n    current: () => true,\n    pull,\n    apply,\n    persist,\n    acknowledge,\n    failed,\n    retryMs: 1000,\n  });\n  await delivery.wake();\n  expect(failed).toHaveBeenCalledWith(failure);\n  expect(acknowledge).not.toHaveBeenCalled();\n  await delivery.wake();\n  expect(apply).toHaveBeenCalledTimes(1);\n  expect(pull).toHaveBeenCalledTimes(1);\n  expect(persist).toHaveBeenCalledTimes(2);\n  expect(acknowledge).toHaveBeenCalledTimes(1);\n  delivery.stop();\n});\n\nit(\"retries an ambiguous ACK without replaying applied or persisted receipt effects\", async () => {\n  vi.useFakeTimers();\n  const pull = vi.fn().mockResolvedValue(page(1));\n  const apply = vi.fn();\n  const persist = vi.fn();\n  const acknowledge = vi\n    .fn()\n    .mockRejectedValueOnce(new Error(\"response lost\"))\n    .mockResolvedValueOnce(false);\n  const delivery = createReceptionDelivery({\n    scope,\n    cursor: null,\n    current: () => true,\n    pull,\n    apply,\n    persist,\n    acknowledge,\n    failed: vi.fn(),\n  });\n  await delivery.wake();\n","exit_code":0,"duration":{"secs":0,"nanos":9333}},"started_at_ms":1795414129108,"completed_at_ms":1795414129108}}
