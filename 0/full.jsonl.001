son\").read_text())\n        fixture[\"firstContact\"] = manifest[\"accounts\"][0]\n        staging = Path(temp) / \"fixture.json\"\n        staging.write_text(json.dumps(fixture))\n        (output / \"fixture-metadata.json\").write_text(json.dumps(fixture, indent=2) + \"\\n\")\n        args.extend([str(staging), str(password)])\n    def file_state():\n        observed = {}\n        for path in sorted(data_root.rglob(\"*\")):\n            if not path.is_symlink() and path.is_file():\n                try:\n                    status = path.stat()\n                except FileNotFoundError:\n                    continue\n                ),\n            )\n            .await\n            .unwrap();\n        let mut bytes = [0; 32];\n        let (size, source) =\n            tokio::time::timeout(Duration::from_secs(2), receiver.recv_from(&mut bytes))\n                .await\n                .expect(\"a Windows discovery socket must receive co-resident multicast\")\n                .unwrap();\n        assert_eq!(&bytes[..size], b\"local discovery\");\n        assert!(source.ip().is_loopback());\n    }\n\n    #[tokio::test]\n    async fn multicast_uses_selected_interface_and_survives_an_unavailable_adapter() {\n        let receiver = UdpSocket::bind((Ipv4Addr::UNSPECIFIED, 0)).await.unwrap();\n        receiver\n            .join_multicast_v4(DISCOVERY_MULTICAST_GROUP, Ipv4Addr::LOCALHOST)\n            .unwrap();\n        let target = (\n            DISCOVERY_MULTICAST_GROUP,\n            receiver.local_addr().unwrap().port(),\n        )\n            .into();\n        multicast_on_interfaces(\n            b\"interface discovery\",\n            target,\n            &[Ipv4Addr::new(192, 0, 2, 254), Ipv4Addr::LOCALHOST],\n        )\n        .await\n        .unwrap();\n        let mut bytes = [0; 32];\n        let (size, source) =\n            tokio::time::timeout(Duration::from_secs(2), receiver.recv_from(&mut bytes))\n                .await\n                .unwrap()\n                .unwrap();\n        assert_eq!(&bytes[..size], b\"interface discovery\");\n        assert!(source.ip().is_loopback());\n        assert!(\n            multicast_on_interfaces(b\"no adapters\", target, &[])\n                .await\n                .is_err()\n        );\n        assert!(\n            multicast_on_interfaces(b\"unavailable\", target, &[Ipv4Addr::new(192, 0, 2, 254)])\n                .await\n                .is_err()\n        );\n    }\n\n    #[tokio::test]\n    async fn routed_ipv6_socket_receives_loopback_datagrams() {\n        let socket = routed_ipv6_socket(0).unwrap();\n        let target = socket.local_addr().unwrap();\n        let client = UdpSocket::bind(\"[::1]:0\").await.unwrap();\n        client\n            .send_to(b\"query\", (Ipv6Addr::LOCALHOST, target.port()))\n            .await\n            .unwrap();\n1674:    fn interface_changes_refresh_discovery_without_waiting_for_periodic_rejoin() {\n","exit_code":0,"duration":{"secs":0,"nanos":22792}},"started_at_ms":1795407151784,"completed_at_ms":1795407151784}}
