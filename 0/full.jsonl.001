::node) fn note_reception_change(&self) {\ncrates/mesh-talk-core/src/node/ui_state.rs:142:            DesktopUiRevisions {\ncrates/mesh-talk-core/src/node/ui_state.rs:153:            DesktopUiRevisions {\ncrates/mesh-talk-core/src/node/ui_state.rs:173:            DesktopUiRevisions {\ncrates/mesh-talk-core/src/node/files/channel_receive.rs:212:                    self.note_reception_change();\ncrates/mesh-talk-core/src/node/files/channel_receive.rs:358:        self.note_reception_change();\ncrates/mesh-talk-core/src/node/delivery_runtime.rs:1837:                        self.note_reception_change();\ncrates/mesh-talk-core/src/node/delivery_runtime.rs:1894:                    self.note_reception_change();\ncrates/mesh-talk-core/src/node/join_history/indexed/receive.rs:205:            self.note_reception_change();\ncrates/mesh-talk-core/src/node/channel/checkpoint/recall.rs:130:                    self.note_reception_change();\nasync fn after_install(\n    mut ready: tokio::sync::watch::Receiver<bool>,\n    operation: impl std::future::Future<Output = ()>,\n) {\n    if ready.wait_for(|installed| *installed).await.is_err() {\n        return;\n    }\n    operation.await;\n}\n\nasync fn forward_ui_changes<R: tauri::Runtime>(\n    app: tauri::AppHandle<R>,\n    authority: RuntimeAuthority,\n    account: String,\n    device: String,\n    mut observed: mesh_talk_core::node::DesktopUiRevisions,\n    mut changes: tokio::sync::watch::Receiver<mesh_talk_core::node::DesktopUiRevisions>,\n) {\n    while changes.changed().await.is_ok() {\n        tokio::time::sleep(std::time::Duration::from_millis(100)).await;\n        let current = *changes.borrow_and_update();\n        let documents = current.documents != observed.documents;\n        let status = current.sync_status != observed.sync_status;\n        let receipts = current.read_receipts != observed.read_receipts;\n        let kinds = if current.state != observed.state {\n            [Some(\"state\"), None, None]\n        } else {\n            [\n                documents.then_some(\"documents\"),\n                status.then_some(\"sync_status\"),\n                (receipts && !documents).then_some(\"read_receipts\"),\n            ]\n        };\n        // A later revision during emission remains ready on the next changed().\n        // Broad state covers both narrow domains in this captured batch only.\n        observed = current;\n        for kind in kinds.into_iter().flatten() {\n            if authority\n                .current(|_| {\n                    crate::events::emit_node_state_changed(\n                        &app,\n                        crate::events::NodeStateChangedEvent {\n                            owner: authority.lease.owner().to_owned(),\n                            account_id: account.clone(),\n                            device_id: device.clone(),\n                            kind,\n                        },\n                    );\n                })\n                .is_err()\n            {\n                return;\n            }\n        }\n            .ok()?\n            .as_ref()\n            .map(|state| state.gate.scope.clone())\n    }\n}\npub(crate) fn invalidate<R: tauri::Runtime>(app: &tauri::AppHandle<R>, scope: &Scope) {\n    invalidate_kind(app, scope, Some(\"state\"));\n}\nfn invalidate_kind<R: tauri::Runtime>(\n    app: &tauri::AppHandle<R>,\n    scope: &Scope,\n    kind: Option<&str>,\n) {\n    let Some(state) = app.try_state::<ReceptionHostState>() else {\n        return;\n    };\n    let publish = {\n        let mut guard = state.0.lock().expect(\"reception host lock not poisoned\");\n        guard\n            .as_mut()\n            .is_some_and(|state| state.gate.scope == *scope && state.gate.invalidate_kind(kind))\n    };\n    if publish {\n        let success = app.emit(\"node-reception-wake\", scope).is_ok();\n        if let Some(state) = state\n            .0\n            .lock()\n            .expect(\"reception host lock not poisoned\")\n            .as_mut()\n            .filter(|state| state.gate.scope == *scope)\n        {\n            state.gate.emitted(success);\n        }\n    }\n}\npub(crate) fn invalidate_identity<R: tauri::Runtime>(\n    app: &tauri::AppHandle<R>,\n    owner: &str,\n    account: &str,\n    device: &str,\n) -> bool {\n    invalidate_identity_kind(app, owner, account, device, \"state\")\n}\npub(crate) fn invalidate_identity_kind<R: tauri::Runtime>(\n    app: &tauri::AppHandle<R>,\n    owner: &str,\n    account: &str,\n    device: &str,\n    kind: &str,\n) -> bool {\n    let Some(scope) = app\n        .try_state::<ReceptionHostState>()\n        .and_then(|state| state.scope())\n    else {\n        return false;\n    };\n    if scope.owner != owner || scope.account_id != account || scope.device_id != device {\n        return true;\n    }\n    invalidate_kind(app, &scope, Some(kind));\n    true\n}\npub(crate) fn progress<R: tauri::Runtime>(\n    app: &tauri::AppHandle<R>,\n    scope: &Scope,\n    event: crate::events::FileProgressEvent,\n) {\n    let Some(state) = app.try_state::<ReceptionHostState>() else {\n        return;\n    };\n    {\n        let mut guard = state.0.lock().expect(\"reception host lock not poisoned\");\n        let Some(state) = guard.as_mut().filter(|state| state.gate.scope == *scope) else {\n            return;\n        };\n        let key = (event.file_conv.clone(), event.direction);\n        if state.progress.len() == 64 && !state.progress.contains_key(&key) {\n            // Progress is a current-value hint. Authoritative transfer status is\n            // repaired by file invalidations and bounded recovery, including evicted terminals.\n            state.progress.pop_first();\n        }\n        let generation = state.gate.generation.wrapping_add(1);\n        state.progress.insert(key, (generation, event));\n    }\n    invalidate_kind(app, scope, None);\n}\n\n#[derive(Serialize)]\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn cumulative_domains_preserve_broad_and_narrow_work_in_one_observation() {\n        let changes = UiChanges::default();\n        let legacy = changes.subscribe();\n        let desktop = changes.subscribe_desktop();\n        changes.sync_status();\n        changes.documents(DocumentUiScope::Documents, true);\n        changes.documents(DocumentUiScope::ReadReceipts, false);\n        changes.send_modify(|revision| *revision = revision.wrapping_add(1));\n        assert_eq!(\n            *legacy.borrow(),\n            4,\n            \"one legacy wake per committed publication\"\n        );\n        assert_eq!(\n            *desktop.borrow(),\n            DesktopUiRevisions {\n                state: 1,\n                documents: 1,\n                sync_status: 2,\n                read_receipts: 1,\n            },\n            \"a later broad event must retain both narrow domains\"\n        );\n        changes.documents(DocumentUiScope::State, false);\n        assert_eq!(\n            *desktop.borrow(),\n            DesktopUiRevisions {\n                state: 2,\n                documents: 1,\n                sync_status: 2,\n                read_receipts: 1,\n            },\n            \"unclassified documents stay broad without manufacturing status work\"\n        );\n        assert_eq!(*legacy.borrow(), 5);\n    }\n\n    #[test]\n    fn legacy_sender_conversion_and_late_desktop_subscription_retain_revisions() {\n        let (legacy, observer) = watch::channel(7u64);\n        let changes = UiChanges::from(legacy);\n        changes.documents(DocumentUiScope::Documents, false);\n        changes.sync_status();\n        assert_eq!(*observer.borrow(), 9);\n        assert_eq!(\n            *changes.subscribe_desktop().borrow(),\n            DesktopUiRevisions {\n                state: 0,\n                documents: 1,\n                sync_status: 1,\n                read_receipts: 0,\n            },\n            \"a slow or not-yet-installed desktop loses no coalesced domain\"\n        );\n    }\n}\n","exit_code":0,"duration":{"secs":0,"nanos":12708}},"started_at_ms":1795416546283,"completed_at_ms":1795416546283}}
