{"timestamp":"2026-11-23T05:02:24.340Z","ordinal":36062,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1feaf-24d9-7612-a284-664abd64a2c4","turn_id":"01a206c8-677a-7201-a087-d90a5c493460","item":{"type":"CommandExecution","id":"exec-985eb4f5-d635-4a08-a537-1f62d29084a6","process_id":"34193","command":["/bin/zsh","-lc","rg -n 'allow-is-minimized' ~/.cargo/registry/src/*/tauri-*/permissions/window | head -6\nhead -35 frontend/src/components/WindowControls.tsx\nhead -32 frontend/src/features/chat/useSerialPoll.test.ts\ncat frontend/src/lib/platform.ts | head -21"],"cwd":"file:///Users/kingsonwu/programming/OctopusGarage/mesh-talk","parsed_cmd":[{"type":"unknown","cmd":"rg -n 'allow-is-minimized' ~/.cargo/registry/src/*/tauri-*/permissions/window | head -6\nhead -35 frontend/src/components/WindowControls.tsx\nhead -32 frontend/src/features/chat/useSerialPoll.test.ts\ncat frontend/src/lib/platform.ts | head -21"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"/Users/kingsonwu/.cargo/registry/src/rsproxy.cn-e3de039b2554c837/tauri-2.12.4/permissions/window/autogenerated/reference.md:14:- `allow-is-minimized`\n/Users/kingsonwu/.cargo/registry/src/rsproxy.cn-e3de039b2554c837/tauri-2.12.4/permissions/window/autogenerated/reference.md:620:`core:window:allow-is-minimized`\n/Users/kingsonwu/.cargo/registry/src/rsproxy.cn-e3de039b2554c837/tauri-2.12.5/permissions/window/autogenerated/reference.md:14:- `allow-is-minimized`\n/Users/kingsonwu/.cargo/registry/src/rsproxy.cn-e3de039b2554c837/tauri-2.12.5/permissions/window/autogenerated/reference.md:620:`core:window:allow-is-minimized`\nimport { getCurrentWindow } from \"@tauri-apps/api/window\";\nimport { Minus, Square, X } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\nimport { needsCustomWindowControls } from \"@/lib/platform\";\n\n/**\n * Custom minimize/maximize/close controls for the frameless window. We drop the native\n * title bar on Windows/Linux (macOS keeps its overlay traffic-lights), so the app draws its\n * own controls top-right. Renders nothing on macOS or in a plain browser (e2e/dev tab).\n *\n * Close routes through the normal window close → the Rust `on_window_event` handler honors\n * \"minimize to tray\" (hide vs quit), so this behaves exactly like the old native button.\n */\nexport function WindowControls() {\n  const { t } = useTranslation();\n  if (!needsCustomWindowControls()) return null;\n  const win = getCurrentWindow();\n  const btn =\n    \"flex h-8 w-12 items-center justify-center text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none\";\n  return (\n    <div\n      data-testid=\"window-controls\"\n      className=\"fixed right-0 top-0 z-[60] flex select-none\"\n    >\n      <button\n        type=\"button\"\n        aria-label={t(\"windowControls.minimize\")}\n        className={btn}\n        onClick={() => void win.minimize()}\n      >\n        <Minus className=\"h-3.5 w-3.5\" />\n      </button>\n      <button\n        type=\"button\"\n        aria-label={t(\"windowControls.maximize\")}\n// @vitest-environment jsdom\nimport { act, createElement } from \"react\";\nimport { createRoot } from \"react-dom/client\";\nimport { afterEach, beforeEach, expect, it, vi } from \"vitest\";\nimport { useSerialPoll } from \"./useSerialPoll\";\nimport {\n  notifySyncInvalidation,\n  setPushStateSupport,\n} from \"@/lib/syncInvalidation\";\nimport { readWithDeadline } from \"@/lib/readDeadline\";\n\nbeforeEach(() => {\n  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });\n  vi.spyOn(document, \"hidden\", \"get\").mockReturnValue(false);\n});\nafterEach(() => {\n  vi.useRealTimers();\n  vi.restoreAllMocks();\n  setPushStateSupport(null);\n});\n\nit(\"keeps push-backed recovery sparse rather than reading unchanged state every thirty seconds\", async () => {\n  vi.useFakeTimers();\n  setPushStateSupport(\"alice\");\n  const request = vi.fn().mockResolvedValue(1);\n  const root = createRoot(document.createElement(\"div\"));\n  function Probe() {\n    useSerialPoll(\n      true,\n      5000,\n      request,\n      () => {},\n// Lightweight, dependency-free platform detection for chrome and font adjustments.\n//\n// The custom title bar (tauri.conf `titleBarStyle: \"Overlay\"`) is macOS-only: the native\n// traffic-lights float over the top-left of our content, so the sidebar header needs a\n// top/left inset there — and ONLY there. On Windows/Linux the native title bar is kept,\n// so no inset (it would just be awkward empty space). In a plain browser (the Playwright\n// e2e harness, dev in a tab) there are no traffic-lights either, so no inset.\n//\n// We mark the document root with `data-os=\"macos\"` only when BOTH: we're inside the Tauri\n// webview (`__TAURI_INTERNALS__`) AND the platform looks like a Mac. CSS keys off it.\n\nfunction isTauri(): boolean {\n  return (\n    typeof window !== \"undefined\" &&\n    \"__TAURI_INTERNALS__\" in (window as unknown as Record<string, unknown>)\n  );\n}\n\nfunction looksLikeMac(): boolean {\n  if (typeof navigator === \"undefined\") return false;\n  // The macOS WebView (WKWebView) user-agent always contains \"Macintosh\" / \"Mac OS X\".\n","exit_code":0,"duration":{"secs":0,"nanos":10000}},"started_at_ms":1795410144340,"completed_at_ms":1795410144340}}
