node.reconcile_account_profiles_on_open().map_err(|error| {\n            LogError::CorruptFile(format!(\"account profile projection: {error}\"))\n        })?;\n        // Optional signed-document repair runs in finite account-sync turns.\n        // Its durable sources and exact receipts survive a stopped runtime.\n        node.prune_expired_received_on_open()\n            .map_err(|error| LogError::CorruptFile(format!(\"expiry cleanup: {error}\")))?;\n        if node.retry_conversation_personal_cleanup().is_err() {\n            log::debug!(\"personal conversation cleanup remains pending\");\n        }\n        node.storage\n            .complete_participant(password, legacy_previous.as_deref())?;\n        node.delivery\n            .lock()\n            .expect(\"delivery lock not poisoned\")\n            .finish_profile_binding()?;\n        crate::storage::profile::publication::cut(\"participant-after-legacy-binding\")?;\n        crate::storage::profile::participant::finish_adoption(\n            node.storage.database(),\n            &node.account.public(),\n        )?;\n        crate::storage::profile::publication::cut(\"participant-after-adoption-clear\")?;\n        // Schema was initialized before WAL recovery. Capture the final account\n        // only after the existing authenticated adoption owner has committed.\n        node.reception_effects =\n            super::reception_effects::ReceptionEffects::open(node.storage.clone())?;\n        node.channel_checkpoints =\n            super::channel::checkpoint::ChannelCheckpointStore::open(node.storage.clone())?;\n        node.received\n            .lock()\n            .expect(\"received lock\")\n            .recapture_reception_owner(&node.account.public())?;\n        node.received_files\n            .lock()\n            .expect(\"received files lock\")\n            .recapture_reception_owner(&node.account.public())?;\n        node.profile_receive_work = Mutex::new(\n            super::profile_receive_work::ProfileReceiveWork::open(node.storage.clone())?,\n        );\n        node.files = Mutex::new(IndexedFileBook::open(node.storage.clone())?);\n        node.attachment_consent\n            .lock()\n            .expect(\"consent lock\")\n            .recapture()?;\n    }\n    fn state(&self) -> MutexGuard<'_, State> {\n        self.state\n            .lock()\n            .expect(\"account profile mutex not poisoned\")\n    }\n    #[cfg(test)]\n    pub(super) fn fail_appends_for_test(&self, enabled: bool) {\n        self.state().avatars.fail_appends_for_test(enabled);\n    }\n    pub fn current(&self) -> Option<ProfilePayload> {\n        self.state().current.clone()\n    }\n    pub fn avatar(&self, account: &str) -> Result<Option<Vec<u8>>, LogError> {\n        self.state().avatars.avatar(account)\n    }\n    pub fn selected(&self, account: &str) -> Result<Option<super::ReceivedProfile>, LogError> {\n        Ok(self\n            .state()\n            .avatars\n            .selected(account)?\n            .map(|entry| super::ReceivedProfile {\n                account_id: entry.account_id,\n                avatar: entry.avatar,\n            }))\n    }\n    pub(super) fn page(\n        &self,\n        revision: Option<u64>,\n        after: Option<&str>,\n    ) -> Result<super::profile_store::AvatarPage, LogError> {\n        let state = self.state();\n        state\n            .avatars\n            .page(if revision == Some(state.avatars.revision()?) {\n                after\n            } else {\n                None\n            })\n    }\n    pub(super) fn revision(&self) -> Result<u64, LogError> {\n        self.state().avatars.revision()\n    }\n    /// An identical avatar is a no-op, including an existing clear tombstone.\n    pub fn set_avatar(&self, avatar: Option<Vec<u8>>) -> Result<Option<ProfilePayload>, NodeError> {\n        if let Some(bytes) = &avatar\n            && bytes.len() > MAX_AVATAR_BYTES\n        {\n            return Err(NodeError::Channel(format!(\n                \"avatar too large: {} bytes (max {MAX_AVATAR_BYTES})\",\n                bytes.len()\n            )));\n    Ok(())\n}\n\npub(crate) fn capture_event_owner_on(\n    c: &Connection,\n    loaded: &AccountPublic,\n) -> Result<ParticipantEventOwner, LogError> {\n    let (active, _, previous) = super::state_on(c)?;\n    if &active != loaded || previous.is_some() {\n        return Err(LogError::StaleCursor);\n    }\n    validate_on(c)?;\n    let generation = c.query_row(\n        \"SELECT generation FROM participant_event_ownership WHERE singleton=1\",\n        [],\n        |r| r.get(0),\n    )?;\n    Ok(ParticipantEventOwner {\n        account: loaded.ed25519_pub,\n        generation,\n    })\n}\n\npub(crate) fn check_event_owner_on(\n    c: &Connection,\n    owner: &ParticipantEventOwner,\n) -> Result<(), LogError> {\n    let current: bool = c\n        .prepare_cached(CHECK_EVENT_OWNER_SQL)?\n        .query_row(params![owner.account.as_slice(), owner.generation], |r| {\n            r.get(0)\n        })?;\n    if !current {\n        return Err(LogError::StaleCursor);\n    }\n    Ok(())\n}\n\n/// Derived schedulers may store this namespace beside a pending key so their\n/// account index qualifies work before LIMIT. This range remains the authority.\npub(crate) fn participant_event_namespace_on(\n    c: &Connection,\n","exit_code":1,"duration":{"secs":0,"nanos":9792}},"started_at_ms":1795414186100,"completed_at_ms":1795414186101}}
