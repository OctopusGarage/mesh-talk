ython3 - \u003c\u003c'PY'\nfrom pathlib import Path\np=Path('frontend/src/features/chat/SearchDialog.tsx')\ns=p.read_text()\ns=s.replace('  const timer = useRef\u003cReturnType\u003ctypeof setTimeout\u003e | undefined\u003e(undefined);','  const searchInFlight = useRef(false);\\\\n  const pendingSearch = useRef\u003c(() =\u003e Promise\u003cvoid\u003e) | null\u003e(null);')\nold='''    clearTimeout(timer.current);\n    // \\`active\\` guards against a stale resolution: if the query changes (or the dialog\n    // closes) while a search is in flight, its result must not overwrite the newer one.\n    let active = true;\n    timer.current = setTimeout(async () =\u003e {\n      try {'''\nnew='''    // The native scan retains admission until it settles. While it runs,\n    // only the latest debounced query from the current dialog may wait.\n    let active = true;\n    const runSearch = async () =\u003e {\n      if (!active || !lease.current()) return;\n      if (searchInFlight.current) {\n        pendingSearch.current = runSearch;\n        return;\n      }\n      searchInFlight.current = true;\n      try {'''\nassert s.count(old)==1\ns=s.replace(old,new)\nold='''      } finally {\n        if (active \u0026\u0026 lease.current()) setSearching(false);\n      }\n    }, 250);\n    return () =\u003e {\n      active = false;\n      clearTimeout(timer.current);\n    };'''\nnew='''      } finally {\n        if (active \u0026\u0026 lease.current()) setSearching(false);\n        searchInFlight.current = false;\n        const next = pendingSearch.current;\n        pendingSearch.current = null;\n        void next?.();\n      }\n    };\n    const debounce = setTimeout(runSearch, 250);\n    return () =\u003e {\n      active = false;\n      clearTimeout(debounce);\n      if (pendingSearch.current === runSearch) pendingSearch.current = null;\n    };'''\nassert s.count(old)==1\np.write_text(s.replace(old,new))\nPY\ncd frontend\nnpx prettier --write src/features/chat/SearchDialog.tsx src/features/chat/SearchDialog.test.ts\nnpm test -- src/features/chat/SearchDialog.test.ts \u003e../tmp/req-011/search-backpressure-green.log 2\u003e\u00261\nnpm run typecheck \u003e../tmp/req-011/search-backpressure-types.log 2\u003e\u00261`,yield_time_ms:1000}))\n","internal_chat_message_metadata_passthrough":{"create_time":1795406605.3912144,"turn_id":"01a20691-6d63-7020-b3f3-af8984c725f3"},"name":"exec","status":"completed","type":"custom_tool_call"},{"call_id":"call_fa157607d8344ff4b5d802df515a7fb7","guardian_metadata":{"client_authored":false,"fallback_token_limit_override":12000,"history_sequence":14283,"model_search_state":"unused","sampled_through_sequence":14280},"id":"ctco_01a20692-d607-79c2-b2f5-df26e70b23ef","internal_chat_message_metadata_passthrough":{"create_time":1795406616.071081,"turn_id":"01a20691-6d63-7020-b3f3-af8984c725f3"},"output":[{"text":"Script completed\nWall time 1.3 seconds\nOutput:\n","type":"input_text"},{"text":"{\"chunk_id\":\"038c73\",\"wall_time_seconds\":1.002432042,\"session_id\":88945,\"original_token_count\":0,\"output\":\"\"}","type":"input_text"}],"type":"custom_tool_call_output"},{"encrypted_content":"REDACTED","guardian_metadata":{"client_authored":false,"history_sequence":14284,"model_search_state":"unused","sampled_through_sequence":14283},"id":"rs_0dca4931a04d8132016b03bb1dd7f487d0ac7040d44eed161c","internal_chat_message_metadata_passthrough":{"turn_id":"01a20691-6d63-7020-b3f3-af8984c725f3"},"summary":[],"type":"reasoning"},{"call_id":"call_0da8108657884b33ad15e42880bf0e6a","guardian_metadata":{"client_authored":false,"history_sequence":14285,"model_search_state":"unused","sampled_through_sequence":14283},"id":"ctc_0dca4931a04d8132016b03bb225cf487d083b137123c03cf7b","input":"text(await tools.exec_command({cmd:`rg -n 'SearchDialog|search-context|search-context-and' frontend/validation.json | head -18; tail -9 tmp/req-011/search-backpressure-green.log; w=$(cat tmp/req-011/windows-reception-batched-path); tail -3 \"$w/native