account_id\n                                || left.member_count != right.member_count\n                                || left_directory.history_policy != right_directory.history_policy\n                        }\n                        _ => false,\n                    })\n            });\n            // A conflicting or resource-limited source never certifies a stale\n            // positive. Keep one coherent observed display and mark uncertainty.\n            let selected = maximal\n                .iter()\n                .copied()\n                .filter(|(_, reference)| {\n                    !reference\n                        .directory\n                        .as_ref()\n                        .is_some_and(|directory| directory.unavailable)\n                })\n                .max_by(|left, right| {\n                    if has_directory {\n                        left.1.source_device.cmp(&right.1.source_device)\n                    } else {\n                        left.0.order().cmp(&right.0.order())\n                    }\n                })\n                .or_else(|| maximal.first().copied())?;\n            let mut reference = selected.1.clone();\n            reference.directory_reconciling = reconciling;\n            node.project_inventory_bindings(&mut reference);\n            Some((id, reference))\n        })\n        .collect()\n}\n\nimpl Node {\n    /// Test-artifact observer for inventory payload reads on the caller thread.\n    #[doc(hidden)]\n    #[cfg(feature = \"fast-test-kdf\")]\n    pub fn test_group_inventory_body_read_count(&self) -> usize {\n        self.account_documents\n            .lock()\n            .expect(\"documents mutex\")\n            .inventory_body_read_count()\n    }\n\n    /// Scheduling reads share the serial repair owner; even bodyless metadata\n    /// waits on storage and must not park a network reactor. Capacity and runtime\n    /// admission remain with the actual worker through cancellation.\n    pub(in crate::node) async fn observe_group_projection_revision(\n        self: &std::sync::Arc<Self>,\n    ) -> Result<[u8; 32], LogError> {\n        let retired = || LogError::AdmissionRejected(\"participant runtime retired\".into());\n        let capacity = self\n            .runtime_work\n            .local_repair_capacity()\n            .await\n            .ok_or_else(retired)?;\n        let work = self.runtime_work.admit().ok_or_else(retired)?;\n        let node = self.clone();\n        work.spawn_local_repair_blocking(capacity, move || node.group_projection_revision())\n            .await\n            .map_err(|error| LogError::Io(std::io::Error::other(error)))?\n            .into_inner()\n    }\n\n    /// Bodyless scheduling hint only; direct document integrity checks remain mandatory.\n    pub fn group_projection_revision(&self) -> Result<[u8; 32], LogError> {\n        use std::sync::atomic::Ordering;\n        let source = {\n            let log = self.log.lock().expect(\"log mutex\");\n            let repository = log.repository()?;\n            (\n                repository.source_revision()?,\n                repository.destructive_policy_revision()?,\n            )\n        };\n        let profiles = self.profiles.lock().expect(\"profiles mutex\").revision()?;\n        let avatars = self.account_profiles.revision()?;\n        let proofs = self\n            .privacy\n            .state\n    async fn settled_account_channel_maintenance_is_quiet_and_changed_source_retries() {\n        fn queued(node: &Node, channel: ConversationId) -> bool {\n            node.storage\n                .database()\n                .read(|c| {\n                    Ok(c.query_row(\n                        \"SELECT EXISTS(SELECT 1 FROM channel_runtime_work WHERE channel=?1)\",\n                        [channel.as_bytes().as_slice()],\n                        |r| r.get(0),\n                    )?)\n                })\n                .unwrap()\n        }\n        fn drain(node: &Node, channel: ConversationId) {\n            for _ in 0..64 {\n                node.process_channel_reception_inner(channel, \"live\")\n                    .unwrap();\n                if !queued(node, channel) {\n                    break;\n                }\n            }\n            assert!(\n                !queued(node, channel),\n                \"fixture must retire its actual reception lane\"\n            );\n        }\n        fn assert_quiet(\n            node: &Node,\n            channel: ConversationId,\n            work: &mut ChannelAccountMaintenance,\n        ) {\n            assert!(\n                !queued(node, channel),\n                \"measure fully drained demand, not queue deduplication\"\n            );\n            let database = node.storage.database();\n            let changes = database.read(|c| Ok(c.total_changes())).unwrap();\n            let commits = database.successful_write_commits();\n            let reads = node\n                .log\n                .lock()\n                .unwrap()\n                .repository()\n                .unwrap()\n                .body_read_counts();\n            for _ in 0..8 {\n                assert!(\n                    node.commit_account_maintenance(channel, work)\n                        .unwrap()\n                        .is_none()\n                );\n                node.process_channel_reception_inner(channel, \"live\")\n                    .unwrap();\n                assert!(!queued(node, channel));\n            }\n            assert_eq!(\n                database.read(|c| Ok(c.total_changes())).unwrap(),\n                changes,\n                \"settled account maintenance must not recreate and retire its durable lane\"\n            );\n            assert_eq!(database.successful_write_commits(), commits);\n            assert_eq!(\n                node.log\n                    .lock()\n                    .unwrap()\n                    .repository()\n                    .unwrap()\n                    .body_read_counts(),\n                reads\n            );\n        }\n\n        let group = Group::new().await;\n        let node = &group.nodes[0];\n","exit_code":0,"duration":{"secs":0,"nanos":13333}},"started_at_ms":1795419925001,"completed_at_ms":1795419925001}}
