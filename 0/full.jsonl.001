lease.current() || !lease.owner) return;\n      const scope: ReceptionScope = {\n        owner: lease.owner,\n        account_id: state.myAccountId,\n        device_id: state.myId,\n        runtime_id: runtime,\n      };\n      try {\n        receiptCursor = loadReceptionSnapshot(scope)?.cursor ?? null;\n        receiptScope = scope;\n        // A restored cursor proves the saved snapshot, not equality with live\n        // state changed while delivery was unavailable. Establish that once.\n        receiptDirty = true;\n        let firstPull = true;\n        let avatarIdentityLoaded = false;\n        delivery = createReceptionDelivery({\n          scope,\n          cursor: receiptCursor,\n          current: () =>\n            lease.current() &&\n            get().ready &&\n            get().deliveryRuntime === runtime &&\n            get().myAccountId === scope.account_id &&\n            get().myId === scope.device_id,\n          pull: async (after, through) => {\nuse super::{Cursor, Scope};\n\n#[derive(Clone)]\npub(super) struct Pending {\n    pub token: String,\n    pub after: Cursor,\n    pub next: Cursor,\n    pub generation: u64,\n    pub profiles: ProfilePosition,\n    pub domains: [u64; 7],\n}\n/// Current values are paged again after renderer replacement or a revision\n/// change. Advancing this cursor requires the same renderer ACK as the page.\n#[derive(Clone, Default)]\npub(super) struct ProfilePosition {\n    pub revision: Option<u64>,\n    pub after: Option<String>,\n    pub complete: bool,\n}\nimpl ProfilePosition {\n    pub fn observe(&mut self, revision: u64) {\n        if self.revision != Some(revision) {\n            *self = Self {\n                revision: Some(revision),\n                ..Self::default()\n            };\n        }\n    }\n}\npub(super) struct Gate {\n    pub scope: Scope,\n    pub generation: u64,\n    pub pending: Option<Pending>,\n    pub last_ack: Option<Pending>,\n    pub profiles: ProfilePosition,\n    // Fixed slots: state, roster, delivery, files, documents, sync status, read receipts. Versions stay\n    // dirty until an ACK observes that exact version, including while a page waits.\n    pub domains: [u64; 7],\n    wake_outstanding: bool,\n}\nimpl Gate {\n    pub fn new(scope: Scope) -> Self {\n        Self {\n            scope,\n            generation: 1,\n            pending: None,\n            last_ack: None,\n            profiles: ProfilePosition::default(),\n            domains: [1, 0, 0, 0, 0, 0, 0],\n            wake_outstanding: false,\n        }\n    }\n    #[cfg(test)]\n    pub fn invalidate(&mut self) -> bool {\n        self.invalidate_kind(None)\n    }\n    pub fn invalidate_kind(&mut self, kind: Option<&str>) -> bool {\n        if let Some(kind) = kind {\n            let index = match kind {\n                \"roster\" => 1,\n                \"delivery\" => 2,\n                \"files\" => 3,\n                \"documents\" => 4,\n                \"sync_status\" => 5,\n                \"read_receipts\" => 6,\n                _ => 0,\n            };\n            self.domains[index] = self.generation.wrapping_add(1);\n        }\n        self.generation = self.generation.wrapping_add(1);\n        if self.wake_outstanding {\n            false\n        } else {\n            self.wake_outstanding = true;\n            true\n        }\n    }\n    pub fn emitted(&mut self, success: bool) {\n        if !success {\n            self.wake_outstanding = false;\n        }\n    }\n    pub fn begin(&mut self, reset: bool) -> Result<(), &'static str> {\n        if self.pending.is_some() && !reset {\n            return Err(\"reception page is awaiting acknowledgement\");\n        }\n        self.pending = None;\n        if reset {\n            self.profiles = ProfilePosition::default();\n            self.generation = self.generation.wrapping_add(1);\n            self.domains[0] = self.generation;\n        }\n        self.wake_outstanding = true;\n        Ok(())\n    }\n    pub fn acknowledge(&mut self, pending: Pending, more: bool) -> bool {\n        let dirty = more || !pending.profiles.complete || self.generation != pending.generation;\n        self.pending = None;\n        for (current, observed) in self.domains.iter_mut().zip(pending.domains) {\n            if *current == observed {\n                *current = 0;\n            }\n        }\n        self.profiles = pending.profiles.clone();\n        self.last_ack = Some(pending);\n        self.wake_outstanding = dirty;\n        dirty\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    fn scope() -> Scope {\n        Scope {\n            owner: \"local\".into(),\n            account_id: \"account\".into(),\n            device_id: \"device\".into(),\n            runtime_id: \"ticket\".into(),\n        }\n    }\n    fn pending(generation: u64) -> Pending {\n        Pending {\n            token: \"page\".into(),\n            after: Cursor {\n","exit_code":1,"duration":{"secs":0,"nanos":10083}},"started_at_ms":1795414054010,"completed_at_ms":1795414054010}}
