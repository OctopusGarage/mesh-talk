# Compiled files
target/
**/*/target/

# Node.js dependencies
node_modules/
**/*/node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
*.pid
*.seed
*.pid.lock

# Coverage directory used by Jest
coverage/

# Distribution artifacts
dist/
**/*/dist/
frontend/dist/

# Build artifacts
build/
**/*/build/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Tauri build artifacts
src-tauri/target/
src-tauri/**/*.app
src-tauri/**/*.exe
src-tauri/**/*.deb
src-tauri/**/*.appimage
src-tauri/**/*.msi

# Package manager files
# Project uses npm, so we commit package-lock.json and ignore others
yarn.lock
pnpm-lock.yaml

# Temporary files
tmp/
temp/

# OS generated files
Thumbs.db
.DS_Store
*.db
test_data_*

# Coverage artifacts
lcov.info
*.info
coverage/

# Playwright: local runs still ignore the generated artifacts; CI uploads them on failure.
frontend/playwright-report/
frontend/test-results/
frontend/eval-results/
site/market/studio/
.worktrees/
# Personal design/spec work remains local; never commit generated superpowers plans.
docs/superpowers/

# Generated design critique reports are local review artifacts.
.impeccable/critique/

# Personal implementation plans stay outside the committed documentation set.
/plans/

# Local agent tools, skill packages, generated links, and their lock/config files.
/.agents/
/.claude/skills/
/.codex/
/.impeccable/
/skills-lock.json
