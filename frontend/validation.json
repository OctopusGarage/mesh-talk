{
  "schema": 1,
  "contracts": [
    {
      "id": "frontend-history",
      "paths": [
        "frontend/src/store/conversationHistory.ts",
        "frontend/src/store/conversationHistory.test.ts"
      ],
      "frontend": ["src/store/conversationHistory.test.ts"],
      "consumers": ["frontend-chat"]
    },
    {
      "id": "frontend-outgoing",
      "paths": [
        "frontend/src/store/outgoingIntent.ts",
        "frontend/src/store/outgoingIntent.test.ts"
      ],
      "frontend": ["src/store/outgoingIntent.test.ts"],
      "consumers": ["frontend-chat"],
      "capability": {
        "summary": "Own optimistic outgoing intents and project backend acceptance within the current frontend owner lifetime.",
        "guide": "docs/module-boundaries.md#coordinated-state-owners",
        "invariants": [
          {
            "name": "Accepted intents reconcile by exact event identity",
            "reference": "docs/ARCHITECTURE.md"
          },
          {
            "name": "Presentation failure preserves backend acceptance",
            "reference": "CONTEXT.md#acceptance-and-delivery"
          },
          {
            "name": "Retired frontend owners cannot publish send completion",
            "reference": "docs/ARCHITECTURE.md"
          }
        ]
      }
    },
    {
      "id": "frontend-conversation-state",
      "paths": [
        "frontend/src/store/conversationState.ts",
        "frontend/src/store/conversationModel.ts"
      ],
      "consumers": ["frontend-history", "frontend-outgoing"],
      "frontend": ["src/store/reception.test.ts"]
    },
    {
      "id": "frontend-chat",
      "paths": [
        "frontend/src/store/chat.ts",
        "frontend/src/store/chat.test.ts",
        "frontend/src/store/chatRuntimeEffects.ts"
      ],
      "frontend": ["src/store/chat.test.ts"],
      "escalation": [
        "Changed visible interaction or native IPC behavior requires relevant browser/native scenarios; unit reachability does not prove runtime wiring."
      ]
    },
    {
      "id": "frontend-owner",
      "paths": [
        "frontend/src/store/ownership.ts",
        "frontend/src/store/ownership.test.ts"
      ],
      "frontend": ["src/store/ownership.test.ts"],
      "consumers": ["frontend-history", "frontend-outgoing"]
    },
    {
      "id": "frontend-channel-actions",
      "paths": [
        "frontend/src/store/channelActions.ts",
        "frontend/src/store/channelActions.test.ts"
      ],
      "frontend": ["src/store/channelActions.test.ts"],
      "consumers": ["frontend-chat"],
      "escalation": [
        "Protocol membership and native admission remain authoritative; changing those requires their focused Rust and loopback evidence."
      ]
    },
    {
      "id": "frontend-bootstrap",
      "paths": [
        "frontend/src/App.tsx",
        "frontend/src/main.tsx",
        "frontend/src/index.css",
        "frontend/src/vite-env.d.ts",
        "frontend/src/components/ErrorBoundary.tsx"
      ],
      "frontend": [
        "src/store/auth.test.ts",
        "src/store/appLock.test.ts",
        "src/lib/themeContrast.test.ts"
      ],
      "escalation": [
        "Bootstrap, error-boundary rendering, styling and ambient types have conservative state/theme unit fallback only; these tests do not mount the application root. Required browser shell/visual scenarios and affected native startup/session evidence remain separate."
      ]
    },
    {
      "id": "frontend-auth-screens",
      "paths": [
        "frontend/src/features/auth/LoginScreen.tsx",
        "frontend/src/features/auth/RestoreBackup.tsx",
        "frontend/src/components/ui/label.tsx"
      ],
      "frontend": ["src/store/auth.test.ts"],
      "escalation": [
        "Auth forms and their label primitive use conservative auth-store unit fallback only; required browser login/recovery scenarios verify interaction. Archive crypto, persistence and OS dialog behavior still require their core/native owners."
      ]
    },
    {
      "id": "frontend-chat-shell",
      "paths": ["frontend/src/features/chat/ChatApp.tsx"],
      "frontend": [
        "src/store/chat.test.ts",
        "src/store/presence.test.ts",
        "src/lib/automaticDownloads.test.ts"
      ],
      "escalation": [
        "Chat composition uses conservative state/helper unit fallback only; required browser lifecycle scenarios and affected native session evidence are separate obligations."
      ]
    },
    {
      "id": "frontend-window-controls",
      "paths": ["frontend/src/components/WindowControls.tsx"],
      "frontend": ["src/lib/platform.test.ts"],
      "escalation": [
        "Platform predicate unit tests do not execute OS window actions; required browser window-control scenarios and real affected native platform evidence remain necessary."
      ]
    }
  ],
  "prScenarios": [
    {
      "id": "frontend-saved-devices",
      "paths": [
        "frontend/src/features/chat/PersonalDevices.tsx",
        "frontend/src/features/chat/PersonalDevices.test.ts",
        "frontend/src/features/chat/ConversationHeaders.tsx"
      ],
      "browser": ["e2e/personal-messages.spec.ts"]
    },
    {
      "id": "frontend-visual",
      "paths": [
        "frontend/src/App.tsx",
        "frontend/src/index.css",
        "frontend/src/components/",
        "frontend/src/features/chat/",
        "frontend/src/lib/theme.ts",
        "frontend/src/store/theme.ts"
      ],
      "browser": ["e2e/ui-visual-regression.spec.ts"]
    },
    {
      "id": "frontend-bootstrap-acceptance",
      "paths": [
        "frontend/src/App.tsx",
        "frontend/src/main.tsx",
        "frontend/src/index.css",
        "frontend/src/vite-env.d.ts",
        "frontend/src/components/ErrorBoundary.tsx"
      ],
      "browser": ["e2e/chat.spec.ts", "e2e/ui-visual-regression.spec.ts"]
    },
    {
      "id": "frontend-auth-screens-acceptance",
      "paths": [
        "frontend/src/features/auth/LoginScreen.tsx",
        "frontend/src/features/auth/RestoreBackup.tsx",
        "frontend/src/components/ui/label.tsx"
      ],
      "browser": ["e2e/chat.spec.ts", "e2e/recovery.spec.ts"]
    },
    {
      "id": "frontend-chat-shell-acceptance",
      "paths": ["frontend/src/features/chat/ChatApp.tsx"],
      "browser": ["e2e/chat.spec.ts", "e2e/message-lifecycle.spec.ts"]
    },
    {
      "id": "frontend-window-controls-acceptance",
      "paths": ["frontend/src/components/WindowControls.tsx"],
      "browser": ["e2e/window-controls.spec.ts"]
    }
  ]
}
