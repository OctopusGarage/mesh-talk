{
  "schema": 1,
  "contracts": [
    {
      "id": "desktop-search",
      "paths": [
        "src-tauri/src/owner_commands/search.rs"
      ],
      "rust": [
        {
          "package": "mesh-talk",
          "filters": [
            "owner_commands::tests::registered_search_recent_and_exact_context_shapes",
            "owner_commands::tests::registered_search_validates_inputs_and_explicit_owner",
            "owner_commands::tests::registered_search_caps_hits_and_context_serialized_bytes",
            "owner_commands::tests::registered_search_recent_response_byte_cap_keeps_newest_prefix",
            "owner_commands::tests::registered_search_rejects_queued_replaced_owner_and_app_lock"
          ]
        }
      ],
      "frontend": [
        "src/lib/api.test.ts"
      ],
      "consumers": [
        "desktop-session",
        "frontend-chat",
        "frontend-owner"
      ],
      "capability": {
        "summary": "Serve exact owner-scoped recent search and bounded read-only message context with validated reference namespaces and explicit coverage.",
        "guide": "docs/ARCHITECTURE.md#recent-search-references",
        "invariants": [
          {
            "name": "Queued or replaced owners and locked apps cannot publish search or context; malformed references never select an approximate message",
            "reference": "docs/ARCHITECTURE.md#recent-search-references"
          },
          {
            "name": "Search returns at most 200 hits and 1 MiB; context returns at most 51 canonical rows and 1 MiB or an explicit unavailable result",
            "reference": "docs/ARCHITECTURE.md#recent-search-references"
          }
        ]
      },
      "escalation": [
        "Search/context command changes require registered IPC owner/malformed-input/lock tests. Frontend adoption also requires typed adapter parity and exact duplicate/older-context browser scenarios. Headless registered dispatch does not certify real native webview acceptance."
      ]
    },
    {
      "id": "desktop-session",
      "paths": [
        "src-tauri/src/desktop_session.rs",
        "src-tauri/src/state.rs",
        "src-tauri/src/runtime_admission.rs",
        "src-tauri/src/runtime_bootstrap.rs",
        "src-tauri/src/commands.rs",
        "src-tauri/src/owner_commands.rs",
        "src-tauri/src/services/auth_service.rs",
        "src-tauri/src/chat_commands/state.rs",
        "src-tauri/src/services/",
        "src-tauri/src/session_store.rs",
        "src-tauri/src/session_store/",
        "src-tauri/src/linked_account.rs"
      ],
      "rust": [
        {
          "package": "mesh-talk",
          "filters": [
            "desktop_session::",
            "services::auth_service::tests::",
            "runtime_admission::",
            "runtime_bootstrap::tests::",
            "commands::tests::",
            "owner_commands::tests::",
            "chat_commands::state::tests::",
            "session_store::macos::tests::"
          ]
        }
      ],
      "escalation": [
        "Session/authorization changes require review of app-lock, integrations and contact-policy admission; native startup/retirement changes require focused native evidence."
      ],
      "consumers": [
        "desktop-integrations",
        "desktop-chat",
        "desktop-contact-policy",
        "desktop-app-lock",
        "desktop-settings",
        "desktop-recovery",
        "desktop-privacy"
      ],
      "capability": {
        "summary": "Authorize desktop work against the exact login generation and serialize runtime replacement with retirement.",
        "guide": "docs/module-boundaries.md#coordinated-state-owners",
        "invariants": [
          {
            "name": "Profile acceptance releases the UI before admitted network fanout completes",
            "reference": "docs/peer-trust.md"
          },
          {
            "name": "Nickname publication does not block observations behind stalled network work",
            "reference": "docs/module-boundaries.md#coordinated-state-owners"
          },
          {
            "name": "Channel acceptance returns exact IDs before admitted network fanout finishes",
            "reference": "docs/ARCHITECTURE.md"
          },
          {
            "name": "Replacement and logout invalidate captured session authority",
            "reference": "docs/ARCHITECTURE.md"
          },
          {
            "name": "Stale startup cannot launch participant producers",
            "reference": "docs/ARCHITECTURE.md"
          },
          {
            "name": "Runtime replacement awaits prior runtime retirement",
            "reference": "docs/ARCHITECTURE.md"
          },
          {
            "name": "Stalled network producers allow observations and unrelated sends while blocking runtime retirement",
            "reference": "docs/module-boundaries.md#coordinated-state-owners"
          },
          {
            "name": "Saved login requires both credential and resume metadata writes; retry uses the raw native runtime secret under current unlocked session authority",
            "reference": "docs/help/topics/first-run.md#keep-access-to-your-account"
          }
        ]
      }
    },
